// Theme values for Mini. Filled from assets/themes.json by Rust (same data as Full).
// Mini draws themes statically: shapes, fonts, colours and a vector backdrop, no animation (decision D-014).

import "../../../assets/fonts/Manrope-Regular.ttf";
import "../../../assets/fonts/Manrope-SemiBold.ttf";
import "../../../assets/fonts/Manrope-Bold.ttf";
import "../../../assets/fonts/Manrope-ExtraBold.ttf";
import "../../../assets/fonts/JetBrainsMono-Regular.ttf";
import "../../../assets/fonts/NotoSerifJP-SemiBold.ttf";
import "../../../assets/fonts/tabler-icons.ttf";

export global Theme {
    in-out property <color> bg: #09080A;
    in-out property <color> bg2: #110D10;
    in-out property <color> panel: #FFFFFF0F;
    in-out property <color> panel-border: #FFFFFF14;
    in-out property <color> fill: #FFFFFF0D;
    in-out property <color> fill-hover: #FFFFFF17;
    in-out property <color> menu: #181418F5;
    in-out property <color> text: #F3EAED;
    in-out property <color> dim: #AB9FA5;
    in-out property <color> mute: #8E8389;
    in-out property <color> accent: #F4A7BB;
    in-out property <color> accent2: #E0566F;
    in-out property <color> on-accent: #2A1220;
    in-out property <color> mist1: #3D1428;
    in-out property <color> mist2: #2A1530;
    in-out property <color> glyph: #C8C0C4;
    in-out property <length> panel-radius: 20px;
    in-out property <length> cover-radius: 12px;
    in-out property <length> chip-radius: 99px;
    in-out property <string> body-font: "Manrope";
    in-out property <string> heading-font: "Manrope";
    in-out property <int> heading-weight: 800;
    in-out property <string> mono-font: "JetBrains Mono";
    in-out property <string> look: "Glass";
    in-out property <string> backdrop: "Tategaki";
    // Brand glyph next to the logo (Tategaki and Sakura use the 水 seal).
    in-out property <string> brand: "水";
}

