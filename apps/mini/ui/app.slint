// Drxwnify Mini: the same layout as the Kotlin desktop app (pc/ Shell.kt): top bar, library on the left,
// content in the middle, «Сейчас играет» on the right, player bar at the bottom. Static themes, no animation loops.
//
// One construction, not floating pieces: the three columns and the player bar are sections of a single surface
// split by hairlines, and the player bar's sections have the same widths as the columns above them. Every size and
// gap comes from `Grid` (4 px steps); icons are vector paths with their ink centred (icons.slint).

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Emoji } from "emoji.slint";
import { Stickers } from "stickers.slint";

export { Theme }

export struct ReactionChip {
    label: string, // the emoji, or «стикер» for a sticker key
    pic: int, // its picture in Emoji.all, -1 when there is none
    sticker: int, // a sticker reaction: its picture in Stickers.all, -1 otherwise
    ratio: float, // the sticker's width / height
    key: string,
    count: int,
    mine: bool,
}

export struct StickerPic {
    pic: int, // in Stickers.all
    ratio: float, // width / height
}

export struct ChatItem {
    id: string,
    mine: bool,
    text: string,
    time: string,
    edited: bool,
    state: int, // mine: 0 sending, 1 sent, 2 failed; theirs: 3
    read: bool,
    has-music: bool,
    music-kind: string,
    music-title: string,
    music-by: string,
    music-cover: image,
    has-music-cover: bool,
    reactions: [ReactionChip],
    stickers: [StickerPic], // a message of stickers alone: drawn big, without the bubble (its text is empty)
    sticker-ratio: float, // their widths / height, added up
    reply-who: string, // an answer: whose message it answers («Вы» / the friend); empty when not an answer
    reply-text: string,
    reply-index: int, // the answered message's row (-1: not loaded)
    day: string, // the date badge above it (the day's first message), else empty
    first: bool, // opens a group (Telegram attaches a sender's messages within 15 minutes)
    last: bool, // closes a group: the bubble has its tail
    unread-bar: bool, // «Непрочитанные сообщения» above it
    selected: bool, // picked (Telegram's selection)
    links: [string], // web addresses in its text, shown as links under it
}

export struct SongItem {
    id: string,
    title: string,
    artists: string,
    duration: string,
    liked: bool,
    index: int,
    cover: image,
    has-cover: bool,
    artist-id: string,
    album-id: string,
    plays: string, // Spotify's play count, «1 234 567» (album pages)
}

export struct ReleaseItem {
    id: string,
    title: string,
    subtitle: string,
    cover: image,
    has-cover: bool,
}

export struct HomeCard {
    id: string,
    title: string,
    subtitle: string,
    cover: image,
    has-cover: bool,
    album: bool, // an album card opens the album; a track card plays its row from there
}

// A friend's card (pc/ FriendCard).
export struct FriendCardItem {
    pubkey: string,
    name: string,
    status: string, // «слушает сейчас», «слушал(а) 2 ч назад», «ничего не слышно»
    live: bool,
    avatar: image,
    has-avatar: bool,
    initial: string,
    developer: bool,
    has-track: bool,
    track-title: string,
    track-artist: string,
    cover: image,
    has-cover: bool,
    preview: string, // the chat's last message, «Вы: …» for mine, with its time; empty without a chat
    unread: int,     // the friend's messages not read yet
}

export struct FriendRequestItem {
    pubkey: string,
    name: string,
    initial: string,
    when: string,
}

// One hotkey row in the settings (pc/ KeysSection).
export struct HotkeyRow {
    id: int,
    label: string,
    combo: string, // «Ctrl + Alt + Shift + R», "" when off
    note: string,
    is-default: bool,
    taken: bool,
}

// One playlist in «Добавить в плейлист».
export struct PlaylistPick {
    id: string,
    name: string,
    count: string,
    cover: image,
    has-cover: bool,
    has-all: bool, // every chosen track is in it already
}

export struct HomeSection {
    title: string,
    artist-id: string, // «Похоже на …»: the title links to the artist
    label: string, // genre rows: «Рядом с <исполнитель>» after the title
    cards: [HomeCard],
}

export struct AccountRow {
    key: string, // SPOTIFY | YANDEX | VK
    label: string,
    linked: bool,
    main: bool,
    tab: bool,
}

export struct ThemeChip {
    id: string,
    name: string,
    accent: color,
    bg: color,
    selected: bool,
}

export struct Suggestion {
    text: string,
    history: bool, // a past search (clock, can be removed) or a suggestion (magnifier)
}

export struct SourceChip {
    label: string,
    selected: bool,
}

export struct HistoryItem {
    header: string, // a day group («Сегодня», «Вчера», «Октябрь»…); empty for a song row
    song: SongItem,
    event: int,     // the listening's id (to remove it)
    index: int,     // the song's place in the history list (to play from it)
}

// A switch of the settings page (a boolean of settings.preferences_pb, shared with the phone).
export struct FlagItem {
    key: string,
    label: string,
    hint: string,
    on: bool,
    header: string, // a section caption above this row
    options: [string], // a choice (chips) instead of a switch
    marks: [bool], // which chips are picked
}

// Settings rows after the sound section, and the callbacks of every settings row.
export global SettingsUi {
    in property <[FlagItem]> more;
    in property <length> start-y; // developer check without input: the page opens scrolled this far
    callback set-flag(string, bool);
    callback pick(string, int);
}

// The sound section of the settings (the phone's keys): normalisation, crossfade, balance, graphic equaliser.
export struct SoundData {
    normalize: bool,
    crossfade: bool,
    crossfade-s: float,
    album: bool,
    balance: float, // −1..1
    skip-silence: bool,
    eq-on: bool,
    gains: [float], // 10 bands, dB
    eq-name: string, // the preset the gains match, or «Своя»
    other: string, // an imported (AutoEq) profile is active: its name
}

// Shared by the settings page without passing it down every level.
export global SoundUi {
    in-out property <SoundData> data;
    in property <[string]> presets;
    in property <[string]> labels;
    callback set-bool(string, bool);
    callback set-num(string, float);
    callback set-gain(int, float);
    callback preset(int);
}

// Chips in a list page's heading (the periods of «Мой топ»).
export global PageChips {
    in property <[string]> labels;
    in property <int> selected;
    callback pick(int);
}

// The statistics page's Wrapped words: the line about the minutes, and «save the playlist».
export global StatsUi {
    in property <string> headline;
    in property <string> action;
    callback act();
}

// «Темп и тон» in the player bar.
export global TempoUi {
    in property <float> tempo: 1;
    in property <int> pitch;
    callback set(float, int);
}

// The library's «+» menu: import a playlist file.
export global LibraryUi {
    callback import-file();
}

export struct LyricLine {
    text: string,
    time-ms: int,
}

export struct StatTile {
    value: string,
    label: string,
}

// A friend's portrait (Android ProfilePortrait), one period at a time.
export struct PortraitArtistItem {
    name: string,
    info: string,  // «3,5 ч · ♥ 12»
    frac: float,   // the bar: share of the top artist's time; -1 = no bar (a portrait by likes)
    cover: image,
    has-cover: bool,
}

export struct GenreItem {
    name: string,
    pct: int,
    color: color,  // the bar and the legend dot
    bg: color,     // a tag's background (the name is drawn in `color`)
    dot: color,    // a tag's dot
}

export struct GenreRow {
    items: [GenreItem],
}

// A «Слушать вместе» room as the friends page shows it.
export struct RoomPerson {
    id: string,
    name: string,
    host: bool,
    me: bool,
    online: bool,
}

export struct RoomAsk {
    id: string,     // a user (join request) or a suggestion
    name: string,
    title: string,  // a suggested track: «Artist — Title»
}

export struct RoomData {
    active: bool,   // in a room or on the way in
    code: string,
    role: string,   // host | guest | "" (waiting)
    status: string,
    users: [RoomPerson],
    requests: [RoomAsk],
    suggestions: [RoomAsk],
    buffering: string,
}

export struct PortraitData {
    periods: [SourceChip],  // Неделя / Месяц / Год
    months: [SourceChip],   // the months of the last year that have a portrait
    note: string,
    tiles: [StatTile],
    artists-title: string,
    artists: [PortraitArtistItem],
    tracks-title: string,
    tracks: [SongItem],
    genres: [GenreItem],
    legend: [GenreRow],
    footer: string,
}

export struct QueueItem {
    title: string,
    artists: string,
}

export struct LibItem {
    title: string,
    subtitle: string,
    kind: string, // liked | playlist | album | artist | remote
    id: string,
    cover: image,
    has-cover: bool,
    thumb: string, // the cover's URL (the page heading shows it big)
}

/// Opening animations (short, only while something opens: an idle window draws nothing). Rust may stretch them
/// for checks (DRX_ANIM_MS).
export global Anim {
    in-out property <duration> page: 140ms;
}

export global Grid {
    out property <length> gutter: 12px;      // window edge, top bar to surface
    out property <length> pad: 16px;         // inside a section
    out property <length> gap: 12px;         // between items in a row
    out property <length> item-radius: min(10px, Theme.panel-radius); // list rows, hover backgrounds (square themes stay square)
    out property <length> small-radius: min(8px, Theme.cover-radius); // brand mark
    // Covers are rounded less than the theme's radius (owner: at the theme's radius they looked cut off); covers in
    // rows and the player bar at most 5 px. Square themes stay square. Mirrored in main.rs (baked corners).
    out property <length> cover-radius: round(Theme.cover-radius * 2 / 3 / 1px) * 1px;
    out property <length> row-cover-radius: min(5px, round(Theme.cover-radius * 2 / 3 / 1px) * 1px);
    in-out property <length> lib-width: 320px; // dragged by the owner (saved), see Splitter
    in-out property <length> side-width: 340px;
    out property <length> top-height: 64px;
    out property <length> bar-height: 84px;
    out property <length> control: 40px;     // top bar controls
    out property <length> button: 36px;      // icon buttons elsewhere
    out property <length> row: 64px;         // list rows (Spotify's 64 with 48 px covers)
}

// A vector icon centred in a square box.
component Icon {
    in property <string> icon;
    in property <length> size: 20px;
    in property <color> color: Theme.dim;
    width: size;
    height: size;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 1000;
        viewbox-height: 1000;
        commands: root.icon;
        fill: root.color;
    }
}

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <length> size: Grid.button;
    in property <length> icon-size: 20px;
    in property <bool> filled: false;
    in property <bool> active: false;
    in property <color> tint: Theme.dim;
    in property <bool> enabled: true;
    in property <color> active-color: Theme.text; // icon colour while on (shuffle, repeat: the accent)
    callback clicked();
    out property <bool> hovered: ta.has-hover;
    width: size;
    height: size;
    border-radius: min(Theme.chip-radius, size / 2);
    background: ta.has-hover && enabled ? Theme.fill-hover : (filled || active ? Theme.fill : transparent);
    opacity: enabled ? 1 : 0.4;
    Icon { icon: root.icon; size: root.icon-size; color: root.active ? root.active-color : (ta.has-hover && root.enabled ? Theme.text : root.tint); }
    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

// Puts a fixed-size child in the vertical middle of a layout cell.
component Middle inherits VerticalLayout {
    alignment: center;
}

// Text that opens a page when it has somewhere to go (artist, album); it brightens on hover.
component Link {
    in property <string> text;
    in property <bool> enabled: true;
    in property <color> color: Theme.dim;
    in property <length> font-size: 14px;
    in property <int> font-weight: 500;
    in property <string> font-family: Theme.body-font;
    in property <bool> underline: true; // on hover, as Spotify's links
    out property <bool> hovered: ta.has-hover;
    callback clicked();
    min-width: 0;
    preferred-width: t.preferred-width;
    min-height: t.preferred-height;
    preferred-height: t.preferred-height;
    t := Text {
        width: 100%;
        height: 100%;
        text: root.text;
        color: root.enabled && ta.has-hover ? Theme.text : root.color;
        font-size: root.font-size;
        font-weight: root.font-weight;
        font-family: root.font-family;
        overflow: elide;
        vertical-alignment: center;
    }
    if root.enabled && root.underline && ta.has-hover: Rectangle {
        x: 0;
        y: (root.height + root.font-size) / 2 - 1px;
        width: min(t.preferred-width, root.width);
        height: 1px;
        background: t.color;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

// A pill button with a label (pc/ PillButton): primary on the accent, otherwise on the fill with a border.
component Pill inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    callback clicked();
    width: pl-text.preferred-width + 32px;
    height: 34px;
    border-radius: min(Theme.chip-radius, 17px);
    background: root.primary ? (pa.has-hover ? Theme.accent2 : Theme.accent) : (pa.has-hover ? Theme.fill-hover : Theme.fill);
    pl-text := Text { text: root.label; font-family: Theme.body-font; font-weight: 700; font-size: 14px; color: root.primary ? Theme.on-accent : Theme.text; }
    pa := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();
    height: 28px;
    border-radius: min(Theme.chip-radius, 14px);
    background: selected ? Theme.accent : (ta.has-hover ? Theme.fill-hover : Theme.fill);
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: label;
            font-size: 14px;
            font-weight: 700;
            font-family: Theme.body-font;
            color: selected ? Theme.on-accent : Theme.text;
            vertical-alignment: center;
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component Cover inherits Rectangle {
    in property <image> source;
    in property <bool> has-source;
    in property <string> placeholder: Icons.music;
    in property <color> placeholder-color: Theme.mute;
    in property <length> size;
    in property <length> radius: Grid.cover-radius;
    // Only behind the placeholder: a loaded cover has its rounded corners baked in, and anything under it would
    // show in those corners (the software renderer does not clip images, and draws gradients without radius).
    in property <brush> placeholder-bg: Theme.fill-hover;
    in property <length> placeholder-size: round(root.size * 0.4 / 1px) * 1px;
    width: size;
    height: size;
    border-radius: radius;
    clip: true;
    background: root.has-source ? transparent : root.placeholder-bg;
    if !root.has-source: Icon { icon: root.placeholder; size: root.placeholder-size; color: root.placeholder-color; }
    if root.has-source: Image { source: root.source; width: root.size; height: root.size; image-fit: ImageFit.cover; }
    // A cover that can be looked at (CoverViewer): a click opens it big.
    in property <bool> zoomable;
    callback zoom();
    if root.zoomable && root.has-source: TouchArea { mouse-cursor: pointer; clicked => { root.zoom(); } }
}

component SectionTitle inherits Text {
    font-family: Theme.heading-font;
    font-weight: 700;
    font-size: 17px;
    color: Theme.text;
    vertical-alignment: center;
}

component Caption inherits Text {
    font-family: Theme.body-font;
    font-weight: 700;
    font-size: 12px;
    color: Theme.mute;
    letter-spacing: 1.5px;
}

component HLine inherits Rectangle {
    height: 1px;
    background: Theme.panel-border;
}

// The line between two columns that drags the side one wider or narrower. `sign` is +1 when the column is on the
// left of the line, -1 on the right. Each move adds what the pointer went past the line (the line follows it).
component Splitter inherits Rectangle {
    in property <length> current;
    in property <length> min-w;
    in property <length> max-w;
    in property <int> sign: 1;
    callback resize(length);
    callback done();
    width: 1px;
    background: ta.pressed || ta.has-hover ? Theme.dim : Theme.panel-border;
    ta := TouchArea {
        x: -4px;
        width: 9px;
        mouse-cursor: col-resize;
        moved => {
            if self.pressed {
                root.resize(clamp(root.current + root.sign * (self.mouse-x - self.pressed-x), root.min-w, root.max-w));
            }
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.up { root.done(); }
        }
    }
}

// Static vector backdrop: soft mist blobs in the theme colours, drawn once (no animation in Mini).
component Backdrop inherits Rectangle {
    background: @linear-gradient(160deg, Theme.bg2 0%, Theme.bg 60%);
    Rectangle {
        x: parent.width * 0.62;
        y: -parent.height * 0.2;
        width: parent.width * 0.6;
        height: parent.height * 0.8;
        background: @radial-gradient(circle, Theme.mist1.with-alpha(0.55) 0%, transparent 70%);
    }
    Rectangle {
        x: -parent.width * 0.15;
        y: parent.height * 0.45;
        width: parent.width * 0.55;
        height: parent.height * 0.75;
        background: @radial-gradient(circle, Theme.mist2.with-alpha(0.45) 0%, transparent 70%);
    }
}

// The home button and search field sit exactly in the window's middle (placed by x, not by the layout, so the
// different widths of the side groups do not move them). Side padding matches the sections below: the logo starts
// where the library's titles start, the last icon ends where the right column's content ends.
// Window controls drawn by the app (the system title bar is off): thin glyphs like Windows', shaped and hovered like
// the other top bar buttons; close turns red on hover.
component WindowButton inherits Rectangle {
    in property <string> kind; // "min" | "max" | "restore" | "close"
    callback clicked();
    property <color> glyph: ta.has-hover ? (root.kind == "close" ? #FFFFFF : Theme.text) : Theme.dim;
    width: Grid.button;
    height: Grid.button;
    border-radius: min(Theme.chip-radius, self.height / 2);
    background: ta.has-hover ? (root.kind == "close" ? #E5484D : Theme.fill-hover) : transparent;
    if root.kind == "min": Rectangle { width: 10px; height: 1px; background: root.glyph; }
    if root.kind == "max": Rectangle {
        width: 10px;
        height: 10px;
        border-width: 1px;
        border-radius: 2px;
        border-color: root.glyph;
    }
    if root.kind == "restore": Rectangle {
        width: 12px;
        height: 12px;
        Rectangle { x: 3px; y: 0; width: 9px; height: 9px; border-width: 1px; border-radius: 2px; border-color: root.glyph; }
        Rectangle { x: 0; y: 3px; width: 9px; height: 9px; border-width: 1px; border-radius: 2px; border-color: root.glyph; background: ta.has-hover ? Theme.menu : Theme.bg; }
    }
    if root.kind == "close": Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        stroke: root.glyph;
        stroke-width: 1.1px;
        commands: "M 0 0 L 10 10 M 10 0 L 0 10";
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component TopBar inherits Rectangle {
    in property <string> downloads-label;
    callback open-downloads();
    in-out property <string> search-text;
    callback search(string);
    in property <bool> can-back;
    in property <bool> can-forward;
    callback home();
    callback back();
    callback forward();
    callback import-backup();
    callback open-settings();
    callback open-friends();
    callback open-history();
    callback open-stats();
    callback typing(string);
    callback dismiss-suggestions();
    in property <bool> maximized;
    // Home button + field. Wide window: centred in the window. Narrower: first it slides toward the smaller (left)
    // group, using the free space there, at full width; only when 16 px are left on both sides does it narrow.
    property <length> left-end: Grid.pad + left-group.min-width + 16px;
    property <length> right-room: Grid.pad - 2px + right-group.min-width + 16px;
    out property <length> search-group-width: min(Grid.control + 8px + 400px, root.width - root.right-room - root.left-end);
    out property <length> search-group-x: max(root.left-end, min((root.width - root.search-group-width) / 2, root.width - root.right-room - root.search-group-width));
    callback window-press();
    callback window-drag();
    callback window-minimize();
    callback window-maximize();
    callback window-close();
    // Closing the suggestions also takes the focus off the field: otherwise a closing menu handed the focus back to
    // it and the suggestions opened again.
    public function blur-search() { input.clear-focus(); }
    public function focus-search() { input.focus(); input.select-all(); }
    height: Grid.top-height;
    // The bar is the window's title bar: empty space drags the window (double press maximises, in Rust).
    // A press goes to Rust (a second one soon after maximises); moving 3 px with the button down starts the
    // system's move loop, so a plain click never starts one.
    TouchArea {
        property <bool> moving;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                self.moving = false;
                root.window-press();
            }
        }
        moved => {
            if self.pressed && !self.moving && (abs(self.mouse-x - self.pressed-x) > 3px || abs(self.mouse-y - self.pressed-y) > 3px) {
                self.moving = true;
                root.window-drag();
            }
        }
    }
    HorizontalLayout {
        padding-left: Grid.pad;
        padding-right: Grid.pad - 2px;
        left-group := HorizontalLayout {
            alignment: start;
            spacing: 8px;
            // The app's icon and the street-art wordmark (Rubik Wet Paint, a mask tinted with the theme's text).
            Middle {
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: Grid.small-radius;
                    clip: true;
                    Image { width: 32px; height: 32px; source: @image-url("../../../assets/icons/mini/d.png"); image-fit: cover; }
                }
            }
            Middle {
                Image {
                    height: 23px;
                    width: 23px * 345 / 74;
                    source: @image-url("../../../assets/brand/wordmark.png");
                    colorize: Theme.text;
                }
            }
            Rectangle { width: 8px; }
            Middle { IconButton { icon: Icons.chevron-left; filled: true; enabled: root.can-back; clicked => { root.back(); } } }
            Middle { IconButton { icon: Icons.chevron-right; filled: true; enabled: root.can-forward; clicked => { root.forward(); } } }
        }
        right-group := HorizontalLayout {
            alignment: end;
            spacing: 4px;
            Middle { IconButton { icon: Icons.clock; clicked => { root.open-history(); } } }
            Middle { IconButton { icon: Icons.chart; clicked => { root.open-stats(); } } }
            Middle { IconButton { icon: Icons.users; clicked => { root.open-friends(); } } }
            // Integrations (pc/ Shell): the accounts and Discord live at the top of the settings.
            Middle { IconButton { icon: Icons.puzzle; clicked => { root.open-settings(); } } }
            if root.downloads-label != "": Text {
                text: root.downloads-label;
                font-family: Theme.body-font; font-size: 12px; color: Theme.accent;
                vertical-alignment: center;
            }
            Middle { IconButton { icon: Icons.download; active: root.downloads-label != ""; active-color: Theme.accent; clicked => { root.open-downloads(); } } }
            Middle { IconButton { icon: Icons.upload; clicked => { root.import-backup(); } } }
            Middle { IconButton { icon: Icons.settings; clicked => { root.open-settings(); } } }
            Rectangle { width: 9px; }
            Middle { Rectangle { width: 1px; height: 20px; background: Theme.panel-border; } }
            Rectangle { width: 9px; }
            Middle { WindowButton { kind: "min"; clicked => { root.window-minimize(); } } }
            Middle { WindowButton { kind: root.maximized ? "restore" : "max"; clicked => { root.window-maximize(); } } }
            Middle { WindowButton { kind: "close"; clicked => { root.window-close(); } } }
        }
    }
    HorizontalLayout {
        x: root.search-group-x;
        width: root.search-group-width;
        height: root.height;
        spacing: 8px;
        Middle { IconButton { icon: Icons.home; size: Grid.control; filled: true; clicked => { root.home(); } } }
        Middle {
            horizontal-stretch: 1;
            Rectangle {
                height: Grid.control;
                border-radius: min(Theme.chip-radius, Grid.control / 2);
                background: Theme.fill;
                border-color: Theme.panel-border;
                border-width: 1px;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 16px;
                    spacing: 8px;
                    Middle { Icon { icon: Icons.search; size: 18px; } }
                    Rectangle {
                        horizontal-stretch: 1;
                        FocusScope {
                            width: 100%;
                            height: 100%;
                            focus-on-click: false;
                            capture-key-pressed(e) => {
                                if e.text == Key.Escape && input.has-focus {
                                    root.dismiss-suggestions();
                                    input.clear-focus();
                                    return accept;
                                }
                                reject
                            }
                            input := TextInput {
                                width: 100%;
                                height: 100%;
                                text <=> root.search-text;
                                font-family: Theme.body-font;
                                font-size: 15px;
                                color: Theme.text;
                                vertical-alignment: center;
                                accepted => { root.search(self.text); }
                                edited => { root.typing(self.text); }
                                changed has-focus => { if self.has-focus { root.typing(self.text); } }
                            }
                        }
                        Text {
                            x: 0;
                            width: 100%;
                            height: 100%;
                            visible: root.search-text == "";
                            text: "Что хочешь включить?";
                            font-family: Theme.body-font;
                            font-size: 15px;
                            color: Theme.mute;
                            vertical-alignment: center;
                        }
                    }
                    Text { text: "Ctrl K"; font-family: Theme.mono-font; font-size: 12px; color: Theme.mute; vertical-alignment: center; }
                }
            }
        }
    }
}

// Section header row: the same height and top offset in all three columns, so their titles line up.
component Header inherits HorizontalLayout {
    height: 32px;
}

// One line of a small menu (sort order): a check mark on the chosen one.
component MenuItem inherits Rectangle {
    in property <string> label;
    in property <bool> checked;
    in property <string> icon; // a command menu: its icon instead of the check mark
    callback clicked();
    height: 34px;
    border-radius: Grid.small-radius;
    background: ta.has-hover ? Theme.fill-hover : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Middle { Icon { icon: root.icon != "" ? root.icon : (root.checked ? Icons.check : ""); size: 16px; color: root.icon != "" ? (ta.has-hover ? Theme.text : Theme.dim) : Theme.accent; } }
        Text { text: root.label; font-family: Theme.body-font; font-size: 14px; color: root.checked || (root.icon != "" && ta.has-hover) ? Theme.text : Theme.dim; vertical-alignment: center; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component LibraryPanel inherits VerticalLayout {
    in property <[LibItem]> items;
    in property <string> selected-id;
    in property <string> filter;     // "" | playlists | albums | artists
    in property <string> sort;       // added | name | updated
    in property <bool> descending;
    in-out property <string> query;
    in-out property <bool> searching;
    callback open(LibItem);
    callback set-filter(string);
    callback set-sort(string);
    callback set-descending(bool);
    callback create-playlist();
    callback query-changed(string);
    padding-top: Grid.pad;
    padding-bottom: 4px;
    spacing: Grid.gap;
    Header {
        padding-left: Grid.pad;
        padding-right: Grid.pad - 6px;
        spacing: 2px;
        SectionTitle { text: "Медиатека"; horizontal-stretch: 1; }
        // «+»: a new playlist, or one imported from a file (the phone's import: CSV, M3U).
        Middle {
            Rectangle {
                width: add-btn.width;
                height: add-btn.height;
                add-btn := IconButton { icon: Icons.plus; size: 32px; icon-size: 18px; clicked => { add-menu.show(); } }
                add-menu := PopupWindow {
                    x: 0;
                    y: add-btn.height + 6px;
                    width: 250px;
                    Rectangle {
                        border-radius: Grid.item-radius;
                        background: Theme.menu;
                        border-color: Theme.panel-border;
                        border-width: 1px;
                        drop-shadow-blur: 16px;
                        drop-shadow-color: #00000060;
                        VerticalLayout {
                            padding: 6px;
                            spacing: 2px;
                            MenuItem { icon: Icons.plus; label: "Новый плейлист"; clicked => { root.create-playlist(); } }
                            MenuItem { icon: Icons.upload; label: "Импорт из файла (CSV, M3U)"; clicked => { LibraryUi.import-file(); } }
                        }
                    }
                }
            }
        }
        Middle {
            IconButton {
                icon: Icons.search; size: 32px; icon-size: 18px; active: root.searching;
                clicked => {
                    root.searching = !root.searching;
                    if !root.searching && root.query != "" { root.query = ""; root.query-changed(""); }
                }
            }
        }
        Middle { sort-btn := IconButton { icon: Icons.sort; size: 32px; icon-size: 18px; clicked => { sort-menu.show(); } } }
    }
    if root.searching: Rectangle {
        height: 34px;
        x: Grid.pad;
        width: parent.width - 2 * Grid.pad;
        border-radius: min(Theme.chip-radius, 17px);
        background: Theme.fill;
        border-color: Theme.panel-border;
        border-width: 1px;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 6px;
            Middle { Icon { icon: Icons.search; size: 15px; color: Theme.mute; } }
            Rectangle {
                horizontal-stretch: 1;
                qi := TextInput {
                    width: 100%;
                    height: 100%;
                    text <=> root.query;
                    font-family: Theme.body-font;
                    font-size: 14px;
                    color: Theme.text;
                    vertical-alignment: center;
                    edited => { root.query-changed(self.text); }
                    init => { self.focus(); }
                }
                if root.query == "": Text {
                    x: 0;
                    width: 100%;
                    height: 100%;
                    text: "Поиск в медиатеке";
                    font-family: Theme.body-font;
                    font-size: 14px;
                    color: Theme.mute;
                    vertical-alignment: center;
                }
            }
        }
    }
    HorizontalLayout {
        padding-left: Grid.pad;
        spacing: 6px;
        alignment: start;
        Chip { label: "Плейлисты"; selected: root.filter == "playlists"; clicked => { root.set-filter(root.filter == "playlists" ? "" : "playlists"); } }
        Chip { label: "Альбомы"; selected: root.filter == "albums"; clicked => { root.set-filter(root.filter == "albums" ? "" : "albums"); } }
        Chip { label: "Артисты"; selected: root.filter == "artists"; clicked => { root.set-filter(root.filter == "artists" ? "" : "artists"); } }
    }
    // Sort menu under the sort button (Android: «Недавно добавленные / Название / Дата обновления» and the direction).
    sort-menu := PopupWindow {
        x: root.width - 216px - Grid.pad + 6px;
        y: Grid.pad + 34px;
        width: 216px;
        Rectangle {
            border-radius: Grid.item-radius;
            background: Theme.menu;
            border-color: Theme.panel-border;
            border-width: 1px;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000060;
            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                MenuItem { label: "Недавно добавленные"; checked: root.sort == "added"; clicked => { root.set-sort("added"); } }
                MenuItem { label: "Название"; checked: root.sort == "name"; clicked => { root.set-sort("name"); } }
                MenuItem { label: "Дата обновления"; checked: root.sort == "updated"; clicked => { root.set-sort("updated"); } }
                HLine { }
                MenuItem { label: root.sort == "name" ? "От Я до А" : "Сначала новые"; checked: root.descending; clicked => { root.set-descending(true); } }
                MenuItem { label: root.sort == "name" ? "От А до Я" : "Сначала старые"; checked: !root.descending; clicked => { root.set-descending(false); } }
            }
        }
    }
    // Rows are inset by 8 px and their content by 8 more, so covers line up with the titles above (16 px).
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        ListView {
            for item in root.items: Rectangle {
                height: Grid.row;
                border-radius: Grid.item-radius;
                background: item.id == root.selected-id ? Theme.fill-hover : (ta.has-hover ? Theme.fill : transparent);
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: Grid.gap;
                    Middle {
                        Cover {
                            size: 48px;
                            source: item.cover;
                            has-source: item.has-cover;
                            placeholder: item.kind == "liked" ? Icons.heart-filled : (item.kind == "top" ? Icons.chart : Icons.music);
                            placeholder-color: item.kind == "liked" || item.kind == "top" ? Theme.on-accent : Theme.mute;
                            placeholder-bg: item.kind == "liked" || item.kind == "top" ? Theme.accent : Theme.fill-hover;
                            radius: Grid.row-cover-radius;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text { text: item.title; font-family: Theme.body-font; font-size: 16px; font-weight: 600; color: Theme.text; overflow: elide; }
                        Text { text: item.subtitle; font-family: Theme.body-font; font-size: 14px; color: Theme.dim; overflow: elide; }
                    }
                }
                ta := TouchArea { clicked => { root.open(item); } }
            }
        }
    }
}

component SongRow inherits Rectangle {
    in property <SongItem> song;
    in property <bool> current;
    in property <bool> hot; // hovered through an area laid over the row (the history's remove button)
    in property <bool> hide-duration; // the remove button stands where the time is
    callback play();
    callback open-artist(string);
    callback open-album(string);
    callback like-song(string);
    callback song-menu(string, int, length, length);
    height: Grid.row;
    border-radius: Grid.item-radius;
    // The pointer is somewhere on the row (the areas on top take the hover from the row's own).
    property <bool> row-hot: ta.has-hover || hot || pa.has-hover || title.hovered || artist.hovered || hta.has-hover;
    background: current ? Theme.fill-hover : (root.row-hot ? Theme.fill : transparent);
    // Under the content, so the artist link on top gets its own clicks. A right click opens the track menu.
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.play(); }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                root.song-menu(root.song.id, root.song.index - 1, root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
            }
        }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 12px;
        spacing: Grid.gap;
        // The number; a play button over it while the row is hovered (pc/ TrackRow, Spotify).
        Rectangle {
            width: 28px;
            if !root.row-hot: Text { width: 100%; height: 100%; text: song.index; font-family: Theme.body-font; font-size: 15px; color: current ? Theme.accent : Theme.dim; vertical-alignment: center; horizontal-alignment: right; }
            if root.row-hot: Icon { x: parent.width - self.width; icon: Icons.play; size: 16px; color: pa.has-hover ? Theme.text : (current ? Theme.accent : Theme.dim); }
            pa := TouchArea { mouse-cursor: pointer; clicked => { root.play(); } }
        }
        Middle { Cover { size: 48px; source: song.cover; has-source: song.has-cover; radius: Grid.row-cover-radius; } }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                alignment: start;
                title := Link {
                    text: song.title;
                    font-size: 16px;
                    font-weight: 600;
                    color: current ? Theme.accent : Theme.text;
                    enabled: song.album-id != "";
                    clicked => { root.open-album(song.album-id); }
                }
            }
            HorizontalLayout {
                alignment: start;
                artist := Link { text: song.artists; enabled: song.artist-id != ""; clicked => { root.open-artist(song.artist-id); } }
            }
        }
        if song.plays != "": Text { width: 110px; text: song.plays; font-family: Theme.body-font; font-size: 14px; color: Theme.dim; vertical-alignment: center; horizontal-alignment: right; }
        // The heart (pc/ TrackRow): filled when liked, an outline while the row is hovered; a click flips it.
        heart := Rectangle {
            width: 28px;
            property <bool> show: song.liked || root.row-hot;
            Icon {
                icon: heart.show ? (song.liked ? Icons.heart-filled : Icons.heart) : "";
                color: song.liked ? Theme.accent : (hta.has-hover ? Theme.text : Theme.mute);
                size: 16px;
            }
            hta := TouchArea { mouse-cursor: pointer; clicked => { root.like-song(song.id); } }
        }
        Text { width: 48px; text: song.duration; font-family: Theme.body-font; font-size: 14px; color: root.hide-duration ? transparent : Theme.dim; vertical-alignment: center; horizontal-alignment: right; }
    }
}

// A switch: a pill with a knob, accent when on.
component Toggle inherits Rectangle {
    in property <bool> on;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 40px;
    height: 22px;
    border-radius: min(Theme.chip-radius, 11px);
    background: on ? Theme.accent : Theme.fill-hover;
    opacity: enabled ? 1 : 0.45;
    Rectangle {
        x: root.on ? parent.width - self.width - 3px : 3px;
        y: 3px;
        width: 16px;
        height: 16px;
        border-radius: min(Theme.chip-radius, 8px);
        background: root.on ? Theme.on-accent : Theme.dim;
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.toggled(!root.on); }
    }
}

// One settings row: label (and a hint) on the left, a control on the right.
component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: Grid.gap;
    min-height: 52px;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;
        Text { text: root.label; font-family: Theme.body-font; font-size: 15px; color: Theme.text; overflow: elide; }
        if root.hint != "": Text { text: root.hint; font-family: Theme.body-font; font-size: 14px; color: Theme.mute; overflow: elide; }
    }
    @children
}

// A sideways strip (home rows, search and artist rows, theme cards): round arrows at its ends appear while the strip
// is hovered and page it left or right (the wheel scrolls the page, not the strip).
component ArrowStrip inherits Rectangle {
    in property <length> content-w;
    in property <bool> hot; // a card in the strip is hovered
    in property <length> arrow-y: (self.height - 40px) / 2;
    property <length> step: max(160px, self.width * 0.8);
    property <bool> show: root.hot || bg.has-hover || la.has-hover || ra.has-hover;
    bg := TouchArea { }
    f := Flickable {
        width: 100%;
        height: 100%;
        content-width: root.content-w;
        content-height: self.height;
        @children
    }
    Rectangle {
        x: 8px;
        y: root.arrow-y;
        width: 40px;
        height: 40px;
        border-radius: 20px;
        visible: root.show && f.content-x < -1px;
        background: la.has-hover ? Theme.text : Theme.menu;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000080;
        Icon { icon: Icons.chevron-left; size: 20px; color: la.has-hover ? Theme.bg : Theme.text; }
        la := TouchArea { mouse-cursor: pointer; clicked => { f.content-x = min(0px, f.content-x + root.step); } }
    }
    Rectangle {
        x: root.width - self.width - 8px;
        y: root.arrow-y;
        width: 40px;
        height: 40px;
        border-radius: 20px;
        visible: root.show && f.content-x > f.width - f.content-width + 1px;
        background: ra.has-hover ? Theme.text : Theme.menu;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000080;
        Icon { icon: Icons.chevron-right; size: 20px; color: ra.has-hover ? Theme.bg : Theme.text; }
        ra := TouchArea { mouse-cursor: pointer; clicked => { f.content-x = max(min(0px, f.width - f.content-width), f.content-x - root.step); } }
    }
}

component Slider inherits Rectangle {
    in property <float> value; // 0..1
    in property <color> fill: Theme.text; // at rest
    in property <float> total-s; // > 0: the time under the pointer shows above it (the seek bar)
    in property <bool> live; // picks while dragging (volume), otherwise on release (seek)
    callback picked(float);
    height: 20px;
    property <bool> hot: ta.has-hover || ta.pressed;
    property <float> at: clamp(ta.mouse-x / max(1px, self.width), 0, 1);
    // Let go: the knob stays there until playback reaches it (a seek takes a moment), at most 1.5 s.
    property <float> held: -1;
    property <float> shown: ta.pressed ? root.at : (root.held >= 0 ? root.held : clamp(root.value, 0, 1));
    changed value => { if root.held >= 0 && abs(root.value - root.held) < 0.02 { root.held = -1; } }
    Timer { interval: 1500ms; running: root.held >= 0; triggered => { root.held = -1; } }
    property <int> tip-s: floor(root.total-s * root.at);
    property <int> tip-m: floor(root.tip-s / 60);
    Rectangle { y: (parent.height - 4px) / 2; height: 4px; border-radius: 2px; background: Theme.fill-hover; }
    Rectangle {
        x: 0;
        y: (parent.height - 4px) / 2;
        height: 4px;
        width: parent.width * root.shown;
        border-radius: 2px;
        background: root.hot ? Theme.accent : root.fill;
    }
    if root.hot: Rectangle {
        x: parent.width * root.shown - 6px;
        y: (parent.height - 12px) / 2;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.text;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000080;
    }
    if root.hot && root.total-s > 0: Rectangle {
        property <length> w: tip.preferred-width + 16px;
        x: clamp(ta.mouse-x - self.w / 2, -24px, root.width - self.w + 24px);
        y: -30px;
        width: self.w;
        height: 26px;
        border-radius: 5px;
        background: Theme.menu;
        border-color: Theme.panel-border;
        border-width: 1px;
        tip := Text {
            text: root.tip-m + ":" + (root.tip-s - root.tip-m * 60 < 10 ? "0" : "") + (root.tip-s - root.tip-m * 60);
            font-family: Theme.body-font;
            font-size: 14px;
            color: Theme.text;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        moved => {
            if self.pressed && root.live { root.picked(root.at); }
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                if !root.live { root.held = root.at; }
                root.picked(root.at);
            }
        }
    }
}

// One band of the graphic equaliser: a vertical slider −12..+12 dB (steps of 0.5), the value above, the frequency
// below. Dragging moves it; the gain is set on release.
component EqBand inherits VerticalLayout {
    in property <float> gain;
    in property <string> label;
    in property <bool> enabled;
    callback picked(float);
    property <float> drag;
    property <float> shown: ta.pressed ? root.drag : root.gain;
    width: 44px;
    spacing: 6px;
    Text {
        text: (root.shown > 0 ? "+" : "") + round(root.shown * 2) / 2;
        font-family: Theme.body-font; font-size: 13px; color: root.enabled ? Theme.text : Theme.mute;
        horizontal-alignment: center;
    }
    Rectangle {
        height: 150px;
        Rectangle { x: (parent.width - 4px) / 2; width: 4px; border-radius: 2px; background: Theme.fill-hover; }
        Rectangle { x: (parent.width - 16px) / 2; y: parent.height / 2; width: 16px; height: 1px; background: Theme.panel-border; }
        Rectangle {
            property <length> vy: parent.height * (1 - (root.shown + 12) / 24);
            x: (parent.width - 4px) / 2;
            y: min(self.vy, parent.height / 2);
            width: 4px;
            height: abs(self.vy - parent.height / 2);
            border-radius: 2px;
            background: root.enabled ? Theme.accent : Theme.dim;
        }
        Rectangle {
            x: (parent.width - 14px) / 2;
            y: parent.height * (1 - (root.shown + 12) / 24) - 7px;
            width: 14px;
            height: 14px;
            border-radius: 7px;
            background: ta.has-hover || ta.pressed ? Theme.text : (root.enabled ? Theme.text : Theme.dim);
            drop-shadow-blur: 4px;
            drop-shadow-color: #00000080;
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                    root.drag = clamp(round((1 - self.mouse-y / self.height) * 48 - 24) / 2, -12, 12);
                }
                if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                    root.picked(root.drag);
                }
            }
            moved => {
                if self.pressed { root.drag = clamp(round((1 - self.mouse-y / self.height) * 48 - 24) / 2, -12, 12); }
            }
        }
    }
    Text { text: root.label; font-family: Theme.body-font; font-size: 13px; color: Theme.dim; horizontal-alignment: center; }
}

// A settings row from the core: a switch, or chips to pick from (one or several); a caption above it when it opens
// a section.
component FlagRow inherits VerticalLayout {
    in property <FlagItem> f;
    spacing: Grid.gap;
    if root.f.header != "": VerticalLayout {
        spacing: Grid.gap;
        Rectangle { height: 8px; }
        Caption { text: root.f.header; }
    }
    SettingRow {
        label: root.f.label;
        hint: root.f.hint;
        if root.f.options.length == 0 && root.f.key != "info": Middle { Toggle { on: root.f.on; toggled(v) => { SettingsUi.set-flag(root.f.key, v); } } }
    }
    if root.f.options.length > 0: strip := ArrowStrip {
        property <int> hover-i: -1;
        height: 40px;
        content-w: row.preferred-width;
        hot: self.hover-i >= 0;
        arrow-y: 0px;
        row := HorizontalLayout {
            spacing: 8px;
            height: 40px;
            for o[i] in root.f.options: cm := Middle {
                property <bool> sel: root.f.marks[i];
                Rectangle {
                    height: 32px;
                    width: ct.preferred-width + 24px;
                    border-radius: min(Theme.chip-radius, 16px);
                    background: cm.sel ? Theme.accent : (ca.has-hover ? Theme.fill-hover : Theme.fill);
                    ct := Text { text: o; font-family: Theme.body-font; font-size: 14px; color: cm.sel ? Theme.bg : Theme.text; }
                    ca := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { SettingsUi.pick(root.f.key, i); }
                        changed has-hover => {
                            if self.has-hover { strip.hover-i = i; } else if strip.hover-i == i { strip.hover-i = -1; }
                        }
                    }
                }
            }
        }
    }
}

component SettingsPage inherits Flickable {
    // Fades in when it opens.
    opacity: 0;
    init => { self.opacity = 1; }
    animate opacity { duration: Anim.page; easing: ease-out; }
    // Scrolled by the wheel only: a drag belongs to the sliders (equaliser bands), not to the page.
    interactive: false;
    content-y: -SettingsUi.start-y;
    // Its content would cap the window (Settings squeezed it to the minimum width and stopped «maximise»).
    min-width: 0;
    max-width: 100000px;
    min-height: 0;
    max-height: 100000px;
    in property <[AccountRow]> accounts;
    in property <[ThemeChip]> themes;
    in property <bool> day;
    in property <bool> hotkeys;
    in property <[HotkeyRow]> hotkey-rows;
    in-out property <int> recording: -1;
    in property <bool> autostart;
    in property <[FlagItem]> flags;
    callback set-flag(string, bool);
    callback set-main(string);
    callback set-tab(string, bool);
    callback set-theme(string);
    callback set-day(bool);
    callback set-hotkeys(bool);
    callback hotkey-start(int);
    callback hotkey-captured(int, string, bool, bool, bool);
    callback hotkey-cancel();
    callback hotkey-reset(int);
    callback hotkey-off(int);
    callback set-autostart(bool);
    content-height: body.preferred-height + Grid.pad;
    body := VerticalLayout {
        width: root.width;
        padding-left: Grid.pad + 4px;
        padding-right: Grid.pad + 4px;
        spacing: Grid.gap;
        alignment: start;
        Caption { text: "АККАУНТЫ"; }
        Text {
            text: "Основной аккаунт отвечает за поиск, главную и страницы исполнителей. Остальные можно показать в медиатеке.";
            font-family: Theme.body-font; font-size: 14px; color: Theme.mute; wrap: word-wrap;
        }
        for a in root.accounts: Rectangle {
            border-radius: Grid.item-radius;
            background: Theme.fill;
            HorizontalLayout {
                padding-left: Grid.pad;
                padding-right: Grid.pad;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: Grid.pad;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    Text { text: a.label; font-family: Theme.body-font; font-weight: 700; font-size: 15px; color: Theme.text; }
                    Text {
                        text: !a.linked ? "Не подключён: войдите на телефоне и перенесите резервную копию" : (a.main ? "Основной аккаунт" : "Подключён");
                        font-family: Theme.body-font; font-size: 14px; color: a.main ? Theme.accent : Theme.mute; overflow: elide;
                    }
                }
                if a.linked && !a.main: Middle {
                    horizontal-stretch: 0;
                    Rectangle {
                        height: 30px;
                        width: mt.preferred-width + 24px;
                        border-radius: min(Theme.chip-radius, 15px);
                        background: mta.has-hover ? Theme.fill-hover : transparent;
                        border-color: Theme.panel-border;
                        border-width: 1px;
                        mt := Text { text: "Сделать основным"; font-family: Theme.body-font; font-size: 14px; color: Theme.text; }
                        mta := TouchArea { mouse-cursor: pointer; clicked => { root.set-main(a.key); } }
                    }
                }
                if a.linked: HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: 8px;
                    Text { text: "В медиатеке"; font-family: Theme.body-font; font-size: 14px; color: Theme.dim; vertical-alignment: center; }
                    Middle { Toggle { on: a.tab; enabled: !a.main; toggled(v) => { root.set-tab(a.key, v); } } }
                }
            }
        }
        for f in root.flags: FlagRow { f: f; }
        Rectangle { height: 8px; }
        Caption { text: "ЗВУК"; }
        SettingRow {
            label: "Нормализация громкости";
            hint: "Треки с YouTube звучат одинаково громко";
            Middle { Toggle { on: SoundUi.data.normalize; toggled(v) => { SoundUi.set-bool("audioNormalization", v); } } }
        }
        SettingRow {
            label: "Пропускать тишину";
            hint: "Паузы внутри трека длиннее 0,15 с вырезаются";
            Middle { Toggle { on: SoundUi.data.skip-silence; toggled(v) => { SoundUi.set-bool("skipSilence", v); } } }
        }
        SettingRow {
            label: "Кроссфейд";
            hint: "Текущий трек плавно затухает, пока нарастает следующий";
            Middle { Toggle { on: SoundUi.data.crossfade; toggled(v) => { SoundUi.set-bool("crossfadeEnabled", v); } } }
        }
        if SoundUi.data.crossfade: SettingRow {
            label: "Длительность кроссфейда";
            hint: round(SoundUi.data.crossfade-s) + " с";
            Middle {
                Slider {
                    width: 240px;
                    value: (SoundUi.data.crossfade-s - 1) / 14;
                    picked(v) => { SoundUi.set-num("crossfadeDurationFloat", round(1 + v * 14)); }
                }
            }
        }
        if SoundUi.data.crossfade: SettingRow {
            label: "Отключать для альбомов без пауз";
            hint: "Треки одного альбома идут встык, без затухания";
            Middle { Toggle { on: SoundUi.data.album; toggled(v) => { SoundUi.set-bool("crossfadeGapless", v); } } }
        }
        SettingRow {
            property <float> b: SoundUi.data.balance;
            label: "Баланс";
            hint: abs(self.b) < 0.005 ? "По центру"
                : "Л " + round((self.b > 0 ? 1 - self.b : 1) * 100) + "% · П " + round((self.b < 0 ? 1 + self.b : 1) * 100) + "%";
            if abs(SoundUi.data.balance) >= 0.005: Middle {
                Rectangle {
                    height: 30px;
                    width: bc.preferred-width + 24px;
                    border-radius: min(Theme.chip-radius, 15px);
                    background: bca.has-hover ? Theme.fill-hover : transparent;
                    border-color: Theme.panel-border;
                    border-width: 1px;
                    bc := Text { text: "По центру"; font-family: Theme.body-font; font-size: 14px; color: Theme.text; }
                    bca := TouchArea { mouse-cursor: pointer; clicked => { SoundUi.set-num("stereoBalance", 0); } }
                }
            }
            Middle {
                Slider {
                    width: 240px;
                    value: (SoundUi.data.balance + 1) / 2;
                    picked(v) => { SoundUi.set-num("stereoBalance", abs(v * 2 - 1) < 0.04 ? 0 : round((v * 2 - 1) * 100) / 100); }
                }
            }
        }
        SettingRow {
            label: "Эквалайзер";
            hint: SoundUi.data.other != "" ? "Включён профиль «" + SoundUi.data.other + "» с телефона; полосы ниже заменят его"
                : (SoundUi.data.eq-on ? SoundUi.data.eq-name : "Выключен");
            Middle { Toggle { on: SoundUi.data.eq-on; toggled(v) => { SoundUi.set-bool("eq", v); } } }
        }
        presets-strip := ArrowStrip {
            property <int> hover-i: -1;
            height: 40px;
            content-w: prow.preferred-width;
            hot: self.hover-i >= 0;
            arrow-y: 0px;
            prow := HorizontalLayout {
                spacing: 8px;
                height: 40px;
                for p[i] in SoundUi.presets: pm := Middle {
                    property <bool> sel: SoundUi.data.eq-on && SoundUi.data.other == "" && SoundUi.data.eq-name == p;
                    Rectangle {
                        height: 32px;
                        width: pt.preferred-width + 24px;
                        border-radius: min(Theme.chip-radius, 16px);
                        background: pm.sel ? Theme.accent : (pa.has-hover ? Theme.fill-hover : Theme.fill);
                        pt := Text { text: p; font-family: Theme.body-font; font-size: 14px; color: pm.sel ? Theme.bg : Theme.text; }
                        pa := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { SoundUi.preset(i); }
                            changed has-hover => {
                                if self.has-hover { presets-strip.hover-i = i; } else if presets-strip.hover-i == i { presets-strip.hover-i = -1; }
                            }
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: start;
            spacing: 6px;
            for g[i] in SoundUi.data.gains: EqBand {
                gain: g;
                label: SoundUi.labels[i];
                enabled: SoundUi.data.eq-on && SoundUi.data.other == "";
                picked(v) => { SoundUi.set-gain(i, v); }
            }
        }
        for f in SettingsUi.more: FlagRow { f: f; }
        Rectangle { height: 8px; }
        Caption { text: "ОФОРМЛЕНИЕ"; }
        SettingRow {
            label: "Светлая тема";
            hint: "Дневной вариант выбранной темы";
            Middle { Toggle { on: root.day; toggled(v) => { root.set-day(v); } } }
        }
        SettingRow {
            label: "Запускать вместе с Windows";
            hint: "Окно откроется свёрнутым";
            Middle { Toggle { on: root.autostart; toggled(v) => { root.set-autostart(v); } } }
        }
        SettingRow {
            label: "Глобальные горячие клавиши";
            hint: root.hotkeys ? "Работают в любой программе, даже в игре" : "Только пока окно Drxwnify активно";
            Middle { Toggle { on: root.hotkeys; toggled(v) => { root.set-hotkeys(v); } } }
        }
        // Each action's combination: a click on it records a new one (Esc cancels), ↺ brings back the default,
        // × switches it off (pc/ KeysSection).
        for hk in root.hotkey-rows: SettingRow {
            label: hk.label;
            hint: hk.note;
            Middle {
                Rectangle {
                    width: kc.preferred-width + 24px;
                    height: 32px;
                    border-radius: 7px;
                    background: root.recording == hk.id ? Theme.fill-hover : (kca.has-hover ? Theme.fill-hover : Theme.fill);
                    border-color: root.recording == hk.id ? Theme.accent : (hk.taken ? #E5484D : Theme.panel-border);
                    border-width: 1px;
                    kc := Text {
                        text: root.recording == hk.id ? "Нажмите сочетание…" : (hk.combo == "" ? "выключено" : hk.combo);
                        font-family: Theme.mono-font;
                        font-size: 14px;
                        color: root.recording == hk.id ? Theme.accent : (hk.combo == "" ? Theme.mute : Theme.text);
                    }
                    kca := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.recording = hk.id; root.hotkey-start(hk.id); rec-scope.focus(); }
                    }
                }
            }
            if !hk.is-default: Middle { IconButton { icon: Icons.repeat; size: 30px; icon-size: 15px; clicked => { root.hotkey-reset(hk.id); } } }
            if hk.combo != "": Middle { IconButton { icon: Icons.x; size: 30px; icon-size: 15px; clicked => { root.hotkey-off(hk.id); } } }
        }
        rec-scope := FocusScope {
            width: 0;
            height: 0;
            key-pressed(e) => {
                if root.recording < 0 { return reject; }
                if e.text == Key.Escape { root.recording = -1; root.hotkey-cancel(); return accept; }
                // A modifier alone: wait for the key.
                if e.text == Key.Control || e.text == Key.ControlR || e.text == Key.Shift || e.text == Key.ShiftR
                    || e.text == Key.Alt || e.text == Key.AltGr || e.text == Key.Meta || e.text == Key.MetaR {
                    return accept;
                }
                root.hotkey-captured(root.recording, e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift);
                accept
            }
            changed has-focus => { if !self.has-focus && root.recording >= 0 { root.recording = -1; root.hotkey-cancel(); } }
        }
        Text {
            text: "Нажмите на сочетание, чтобы задать своё: зажмите Ctrl, Alt или Shift (лучше два-три сразу) и клавишу. Esc — отмена.";
            font-family: Theme.body-font;
            font-size: 14px;
            color: Theme.mute;
            wrap: word-wrap;
        }
        // Theme cards: a swatch of the theme's background and accent, the name under it.
        themes-strip := ArrowStrip {
            property <int> hover-i: -1;
            height: 104px;
            content-w: root.themes.length * 116px;
            hot: self.hover-i >= 0;
            arrow-y: 16px;
            for t[i] in root.themes: Rectangle {
                x: i * 116px;
                width: 104px;
                height: 104px;
                VerticalLayout {
                    spacing: 6px;
                    Rectangle {
                        height: 72px;
                        border-radius: Grid.item-radius;
                        background: t.bg;
                        border-color: t.selected ? Theme.accent : (tta.has-hover ? Theme.dim : Theme.panel-border);
                        border-width: t.selected ? 2px : 1px;
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 14px;
                            background: t.accent;
                        }
                    }
                    Text { text: t.name; font-family: Theme.body-font; font-size: 14px; color: t.selected ? Theme.accent : Theme.text; horizontal-alignment: center; overflow: elide; }
                }
                tta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.set-theme(t.id); }
                    changed has-hover => {
                        if self.has-hover { themes-strip.hover-i = i; } else if themes-strip.hover-i == i { themes-strip.hover-i = -1; }
                    }
                }
            }
        }
    }
}

// A row of cards that scrolls sideways (search sections). Round covers for artists.
component CardStrip inherits ArrowStrip {
    in property <[HomeCard]> cards;
    in property <bool> round;
    callback clicked(int);
    property <int> hover-i: -1;
    height: 222px;
    content-w: Grid.pad + 4px + root.cards.length * 176px + Grid.pad;
    hot: root.hover-i >= 0;
    arrow-y: 80px - 20px;
    for card[ci] in root.cards: Rectangle {
        x: Grid.pad + 4px + ci * 176px;
        y: 0;
        width: 160px;
        height: 212px;
        VerticalLayout {
            spacing: 4px;
            alignment: start;
            Cover { size: 160px; source: card.cover; has-source: card.has-cover; radius: root.round ? 80px : Grid.cover-radius; }
            Text { text: card.title; font-family: Theme.body-font; font-size: 15px; color: cta.has-hover ? Theme.accent : Theme.text; overflow: elide; horizontal-alignment: root.round ? center : left; }
            Text { text: card.subtitle; font-family: Theme.body-font; font-size: 14px; color: Theme.dim; overflow: elide; horizontal-alignment: root.round ? center : left; }
        }
        cta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(ci); }
            changed has-hover => {
                if self.has-hover { root.hover-i = ci; } else if root.hover-i == ci { root.hover-i = -1; }
            }
        }
    }
}

component SectionHead inherits HorizontalLayout {
    in property <string> text;
    padding-left: Grid.pad + 4px;
    height: 32px;
    Text { text: root.text; font-family: Theme.heading-font; font-weight: 700; font-size: 22px; color: Theme.text; vertical-alignment: center; }
}

// The search page: source chips, best result beside the first tracks, then artists, albums, playlists.
component SearchPage inherits Flickable {
    // Fades in when it opens.
    opacity: 0;
    init => { self.opacity = 1; }
    animate opacity { duration: Anim.page; easing: ease-out; }
    // Its content would cap the window (Settings squeezed it to the minimum width and stopped «maximise»).
    min-width: 0;
    max-width: 100000px;
    min-height: 0;
    max-height: 100000px;
    in property <[SourceChip]> chips;
    in property <string> state; // loading | empty | error text | ""
    in property <string> top-kind; // artist | track | album | ""
    in property <string> top-title;
    in property <string> top-sub;
    in property <image> top-cover;
    in property <bool> top-has-cover;
    in property <[SongItem]> tracks;
    in property <int> tracks-total;
    in property <bool> expanded;
    in property <[HomeCard]> artists;
    in property <[HomeCard]> albums;
    in property <[HomeCard]> playlists;
    in property <string> now-id;
    callback source(int);
    callback play(int);
    callback top();
    callback more();
    callback open-album(string);
    callback open-artist(string);
    callback like-song(string);
    callback song-menu(string, int, length, length);
    callback artist(int);
    callback album(int);
    callback playlist(int);
    content-height: body.preferred-height + Grid.pad;
    body := VerticalLayout {
        width: root.width;
        spacing: Grid.pad;
        alignment: start;
        HorizontalLayout {
            padding-left: Grid.pad + 4px;
            spacing: 6px;
            alignment: start;
            for c[i] in root.chips: Chip { label: c.label; selected: c.selected; clicked => { root.source(i); } }
        }
        if root.state != "": Text {
            x: Grid.pad + 4px;
            text: root.state == "loading" ? "Ищу…" : (root.state == "empty" ? "Ничего не нашлось" : root.state);
            font-family: Theme.body-font; font-size: 15px; color: Theme.dim;
        }
        if root.state == "" && root.tracks.length > 0: HorizontalLayout {
            padding-left: Grid.pad + 4px;
            padding-right: Grid.pad;
            spacing: Grid.pad;
            // Best result: a big card (Spotify's «Лучший результат»).
            if root.top-kind != "": VerticalLayout {
                width: 300px;
                spacing: 8px;
                Text { text: "Лучший результат"; font-family: Theme.heading-font; font-weight: 700; font-size: 18px; color: Theme.text; height: 28px; vertical-alignment: center; }
                Rectangle {
                    height: 232px;
                    border-radius: Grid.item-radius;
                    background: tta.has-hover ? Theme.fill-hover : Theme.fill;
                    VerticalLayout {
                        padding: Grid.pad;
                        spacing: 6px;
                        alignment: start;
                        Cover { size: 104px; source: root.top-cover; has-source: root.top-has-cover; radius: root.top-kind == "artist" ? 52px : Grid.cover-radius; }
                        Rectangle { height: 6px; }
                        Text { text: root.top-title; font-family: Theme.heading-font; font-weight: Theme.heading-weight; font-size: 24px; color: Theme.text; overflow: elide; }
                        Text { text: root.top-sub; font-family: Theme.body-font; font-size: 14px; color: Theme.dim; overflow: elide; }
                    }
                    tta := TouchArea { mouse-cursor: pointer; clicked => { root.top(); } }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 8px;
                HorizontalLayout {
                    height: 28px;
                    Text { horizontal-stretch: 1; text: "Треки"; font-family: Theme.heading-font; font-weight: 700; font-size: 18px; color: Theme.text; vertical-alignment: center; }
                    if root.tracks-total > 4: Link {
                        text: root.expanded ? "Свернуть" : "Все треки · " + root.tracks-total;
                        font-size: 14px;
                        clicked => { root.more(); }
                    }
                }
                for t[i] in root.tracks: SongRow {
                    song: t;
                    current: root.now-id != "" && t.id == root.now-id;
                    play => { root.play(i); }
                    open-artist(id) => { root.open-artist(id); }
                    open-album(id) => { root.open-album(id); }
                    like-song(id) => { root.like-song(id); }
                    song-menu(id, i, x, y) => { root.song-menu(id, i, x, y); }
                }
            }
        }
        if root.state == "" && root.artists.length > 0: VerticalLayout {
            spacing: 8px;
            SectionHead { text: "Исполнители"; }
            CardStrip { cards: root.artists; round: true; clicked(i) => { root.artist(i); } }
        }
        if root.state == "" && root.albums.length > 0: VerticalLayout {
            spacing: 8px;
            SectionHead { text: "Альбомы"; }
            CardStrip { cards: root.albums; clicked(i) => { root.album(i); } }
        }
        if root.state == "" && root.playlists.length > 0: VerticalLayout {
            spacing: 8px;
            SectionHead { text: "Плейлисты"; }
            CardStrip { cards: root.playlists; clicked(i) => { root.playlist(i); } }
        }
    }
}

// An artist page: popular tracks, then albums, singles, «Участие» and similar artists (Spotify / Android layout).
component ArtistView inherits Flickable {
    // Fades in when it opens.
    opacity: 0;
    init => { self.opacity = 1; }
    animate opacity { duration: Anim.page; easing: ease-out; }
    // Its content would cap the window (Settings squeezed it to the minimum width and stopped «maximise»).
    min-width: 0;
    max-width: 100000px;
    min-height: 0;
    max-height: 100000px;
    in property <[SongItem]> tracks;
    in property <int> tracks-total;
    in property <bool> expanded;
    in property <[HomeCard]> albums;
    in property <[HomeCard]> singles;
    in property <[HomeCard]> appears;
    in property <[HomeCard]> related;
    in property <string> now-id;
    callback play(int);
    callback more();
    callback open-artist(string);
    callback like-song(string);
    callback song-menu(string, int, length, length);
    callback open-album(string);
    content-height: body.preferred-height + Grid.pad;
    body := VerticalLayout {
        width: root.width;
        spacing: Grid.pad;
        alignment: start;
        if root.tracks.length > 0: VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                padding-left: Grid.pad + 4px;
                padding-right: Grid.pad + 4px;
                height: 28px;
                Text { horizontal-stretch: 1; text: "Популярные треки"; font-family: Theme.heading-font; font-weight: 700; font-size: 18px; color: Theme.text; vertical-alignment: center; }
                if root.tracks-total > 5: Link {
                    text: root.expanded ? "Свернуть" : "Показать все · " + root.tracks-total;
                    font-size: 14px;
                    clicked => { root.more(); }
                }
            }
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                VerticalLayout {
                    for t[i] in root.tracks: SongRow {
                        song: t;
                        current: root.now-id != "" && t.id == root.now-id;
                        play => { root.play(i); }
                        open-artist(id) => { root.open-artist(id); }
                        open-album(id) => { root.open-album(id); }
                        like-song(id) => { root.like-song(id); }
                        song-menu(id, i, x, y) => { root.song-menu(id, i, x, y); }
                    }
                }
            }
        }
        if root.albums.length > 0: VerticalLayout {
            spacing: 8px;
            SectionHead { text: "Альбомы"; }
            CardStrip { cards: root.albums; clicked(i) => { root.open-album(root.albums[i].id); } }
        }
        if root.singles.length > 0: VerticalLayout {
            spacing: 8px;
            SectionHead { text: "Синглы и EP"; }
            CardStrip { cards: root.singles; clicked(i) => { root.open-album(root.singles[i].id); } }
        }
        if root.appears.length > 0: VerticalLayout {
            spacing: 8px;
            SectionHead { text: "Участие"; }
            CardStrip { cards: root.appears; clicked(i) => { root.open-album(root.appears[i].id); } }
        }
        if root.related.length > 0: VerticalLayout {
            spacing: 8px;
            SectionHead { text: "Похожие исполнители"; }
            CardStrip { cards: root.related; round: true; clicked(i) => { root.open-artist(root.related[i].id); } }
        }
    }
}

// The history: day groups and the songs heard, newest first; a song can be taken out (×).
component HistoryView inherits HorizontalLayout {
    in property <[HistoryItem]> items;
    in property <string> now-id;
    callback play(int);
    callback remove(int);
    callback open-album(string);
    callback open-artist(string);
    callback like-song(string);
    callback song-menu(string, int, length, length);
    padding-left: 8px;
    padding-right: 4px;
    ListView {
        for it in root.items: Rectangle {
            height: it.header != "" ? 44px : Grid.row;
            if it.header != "": Text {
                x: 12px;
                y: parent.height - self.height - 6px;
                text: it.header;
                font-family: Theme.heading-font;
                font-weight: 700;
                font-size: 16px;
                color: Theme.text;
            }
            if it.header == "": Rectangle {
                row := SongRow {
                    width: parent.width;
                    song: it.song;
                    current: root.now-id != "" && it.song.id == root.now-id;
                    hot: hover.has-hover;
                    hide-duration: hover.has-hover;
                    play => { root.play(it.index); }
                    open-artist(id) => { root.open-artist(id); }
                    open-album(id) => { root.open-album(id); }
                    like-song(id) => { root.like-song(id); }
                    song-menu(id, i, x, y) => { root.song-menu(id, i, x, y); }
                }
                // Remove from the history: in place of the time while the row's right end is hovered. The button is a
                // child of the hover area, so the area stays hovered (and the button shown) while the pointer is on it.
                hover := TouchArea {
                    x: parent.width - 120px;
                    width: 120px;
                    double-clicked => { root.play(it.index); }
                    if hover.has-hover: IconButton {
                        x: parent.width - 48px; // centred on the time (40px wide, 12px from the edge)
                        y: (parent.height - 32px) / 2;
                        icon: Icons.x;
                        size: 32px;
                        icon-size: 15px;
                        clicked => { root.remove(it.event); }
                    }
                }
            }
        }
    }
}

// Statistics: period chips, totals, top tracks, artists and albums.
component StatsView inherits Flickable {
    // Fades in when it opens.
    opacity: 0;
    init => { self.opacity = 1; }
    animate opacity { duration: Anim.page; easing: ease-out; }
    // Its content would cap the window (Settings squeezed it to the minimum width and stopped «maximise»).
    min-width: 0;
    max-width: 100000px;
    min-height: 0;
    max-height: 100000px;
    in property <[SourceChip]> periods;
    in property <[StatTile]> tiles;
    in property <[SongItem]> tracks;
    in property <int> tracks-total;
    in property <bool> expanded;
    in property <[HomeCard]> artists;
    in property <[HomeCard]> albums;
    in property <string> now-id;
    in property <string> note;
    callback period(int);
    callback play(int);
    callback more();
    callback open-artist(string);
    callback like-song(string);
    callback song-menu(string, int, length, length);
    callback open-album(string);
    content-height: body.preferred-height + Grid.pad;
    body := VerticalLayout {
        width: root.width;
        spacing: Grid.pad;
        alignment: start;
        HorizontalLayout {
            padding-left: Grid.pad + 4px;
            spacing: 6px;
            alignment: start;
            for c[i] in root.periods: Chip { label: c.label; selected: c.selected; clicked => { root.period(i); } }
        }
        HorizontalLayout {
            padding-left: Grid.pad + 4px;
            padding-right: Grid.pad + 4px;
            spacing: Grid.gap;
            for t in root.tiles: Rectangle {
                horizontal-stretch: 1;
                height: 84px;
                border-radius: Grid.item-radius;
                background: Theme.fill;
                VerticalLayout {
                    padding: Grid.pad;
                    spacing: 2px;
                    alignment: center;
                    Text { text: t.value; font-family: Theme.heading-font; font-weight: Theme.heading-weight; font-size: 24px; color: Theme.text; overflow: elide; }
                    Text { text: t.label; font-family: Theme.body-font; font-size: 14px; color: Theme.mute; overflow: elide; }
                }
            }
        }
        if root.note != "": Text {
            x: Grid.pad + 4px;
            text: root.note;
            font-family: Theme.body-font; font-size: 14px; color: Theme.mute;
        }
        // Wrapped (the year's summary): its line about the minutes and the playlist of the year.
        if StatsUi.headline != "": HorizontalLayout {
            padding-left: Grid.pad + 4px;
            padding-right: Grid.pad + 4px;
            Text {
                text: StatsUi.headline;
                wrap: word-wrap;
                font-family: Theme.heading-font; font-weight: Theme.heading-weight; font-size: 22px; color: Theme.text;
            }
        }
        if StatsUi.action != "": HorizontalLayout {
            padding-left: Grid.pad + 4px;
            alignment: start;
            Pill { label: StatsUi.action; primary: true; clicked => { StatsUi.act(); } }
        }
        if root.tracks.length > 0: VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                padding-left: Grid.pad + 4px;
                padding-right: Grid.pad + 4px;
                height: 28px;
                Text { horizontal-stretch: 1; text: "Топ треков"; font-family: Theme.heading-font; font-weight: 700; font-size: 18px; color: Theme.text; vertical-alignment: center; }
                if root.tracks-total > 10: Link {
                    text: root.expanded ? "Свернуть" : "Показать все · " + root.tracks-total;
                    font-size: 14px;
                    clicked => { root.more(); }
                }
            }
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                VerticalLayout {
                    for t[i] in root.tracks: SongRow {
                        song: t;
                        current: root.now-id != "" && t.id == root.now-id;
                        play => { root.play(i); }
                        open-artist(id) => { root.open-artist(id); }
                        open-album(id) => { root.open-album(id); }
                        like-song(id) => { root.like-song(id); }
                        song-menu(id, i, x, y) => { root.song-menu(id, i, x, y); }
                    }
                }
            }
        }
        if root.artists.length > 0: VerticalLayout {
            spacing: 8px;
            SectionHead { text: "Топ исполнителей"; }
            CardStrip { cards: root.artists; round: true; clicked(i) => { root.open-artist(root.artists[i].id); } }
        }
        if root.albums.length > 0: VerticalLayout {
            spacing: 8px;
            SectionHead { text: "Топ альбомов"; }
            CardStrip { cards: root.albums; clicked(i) => { root.open-album(root.albums[i].id); } }
        }
    }
}

/// A YouTube Music page (moods and genres, a mood, new releases, an artist or channel): rows of mood
/// buttons, cards or tracks. Rust fills `YtUi.rows` and maps (row, item) back to the page's links.
export struct YtChip {
    title: string,
    color: color,
}

export struct YtRow {
    kind: string, // chips | cards | round | tracks
    title: string,
    more: bool,
    chips: [YtChip],
    cards: [HomeCard],
    tracks: [SongItem],
}

export global YtUi {
    in-out property <[YtRow]> rows;
    in-out property <string> state; // "" | error text
    callback open(int, int); // row, chip/card
    callback play(int, int); // row, track
    callback more(int);
    callback root-page(string); // new | moods
}

component YtView inherits Flickable {
    // Fades in when it opens.
    opacity: 0;
    init => { self.opacity = 1; }
    animate opacity { duration: Anim.page; easing: ease-out; }
    min-width: 0;
    max-width: 100000px;
    min-height: 0;
    max-height: 100000px;
    in property <string> now-id;
    callback open-album(string);
    callback open-artist(string);
    callback like-song(string);
    callback song-menu(string, int, length, length);
    content-height: body.preferred-height + Grid.pad;
    body := VerticalLayout {
        width: root.width;
        spacing: 10px;
        alignment: start;
        if YtUi.state != "": Text {
            x: Grid.pad + 4px;
            text: YtUi.state;
            font-family: Theme.body-font; font-size: 15px; color: Theme.dim;
        }
        for row[ri] in YtUi.rows: VerticalLayout {
            spacing: 8px;
            if row.title != "": HorizontalLayout {
                padding-left: Grid.pad + 4px;
                padding-right: Grid.pad;
                padding-top: 6px;
                height: 38px;
                Text { horizontal-stretch: 1; text: row.title; font-family: Theme.heading-font; font-weight: 700; font-size: 22px; color: Theme.text; vertical-alignment: center; overflow: elide; }
                if row.more: Link { text: "Показать все"; font-size: 14px; clicked => { YtUi.more(ri); } }
            }
            if row.kind == "chips": HorizontalLayout {
                padding-left: Grid.pad + 4px;
                padding-right: Grid.pad;
                spacing: 10px;
                for c[ci] in row.chips: Rectangle {
                    horizontal-stretch: 1;
                    height: 48px;
                    border-radius: min(Theme.cover-radius, 8px);
                    background: c.title == "" ? transparent : (cta.has-hover ? Theme.fill-hover : Theme.fill);
                    clip: true;
                    if c.title != "": Rectangle { x: 0; y: 0; width: 6px; height: parent.height; background: c.color; }
                    Text { x: 18px; width: parent.width - 26px; height: parent.height; text: c.title; font-family: Theme.body-font; font-weight: 600; font-size: 15px; color: Theme.text; vertical-alignment: center; overflow: elide; }
                    cta := TouchArea { enabled: c.title != ""; mouse-cursor: pointer; clicked => { YtUi.open(ri, ci); } }
                }
            }
            if row.kind == "cards" || row.kind == "round": CardStrip {
                cards: row.cards;
                round: row.kind == "round";
                clicked(i) => { YtUi.open(ri, i); }
            }
            if row.kind == "tracks": VerticalLayout {
                padding-left: Grid.pad;
                padding-right: Grid.pad;
                for t[ti] in row.tracks: SongRow {
                    song: t;
                    current: root.now-id != "" && t.id == root.now-id;
                    play => { YtUi.play(ri, ti); }
                    open-artist(id) => { root.open-artist(id); }
                    open-album(id) => { root.open-album(id); }
                    like-song(id) => { root.like-song(id); }
                    song-menu(id, i, x, y) => { root.song-menu(id, i, x, y); }
                }
            }
        }
    }
}

/// A page whose data is still loading (Rust sets `loading` while a background load runs).
export global PageState {
    in-out property <bool> loading;
}

/// Placeholder rows while a page loads. Cheap for the software renderer: no running animation, a lighter band
/// steps down the rows five times a second (only those two rows are redrawn), and it shows only after 150 ms so
/// fast pages never flash it.
component Skeleton inherits Rectangle {
    in property <int> rows: 9;
    property <int> lit: -1;
    property <bool> shown: false;
    Timer { interval: 150ms; running: !root.shown; triggered => { root.shown = true; } }
    Timer { interval: 200ms; running: root.shown; triggered => { root.lit = mod(root.lit + 1, root.rows + 3); } }
    if root.shown: VerticalLayout {
        padding-top: 8px;
        spacing: 8px;
        alignment: start;
        for i in root.rows: Rectangle {
            height: 52px;
            border-radius: min(Theme.cover-radius, 8px);
            background: i == root.lit ? Theme.fill-hover : Theme.fill;
            HorizontalLayout {
                padding: 8px;
                spacing: 14px;
                Rectangle { width: 36px; border-radius: min(Theme.cover-radius, 5px); background: Theme.fill; }
                VerticalLayout {
                    spacing: 8px;
                    alignment: center;
                    Rectangle { height: 10px; width: root.width * (0.30 + mod(i * 37, 25) / 100); border-radius: 5px; background: Theme.fill; }
                    Rectangle { height: 8px; width: root.width * (0.16 + mod(i * 53, 15) / 100); border-radius: 4px; background: Theme.fill; }
                }
            }
        }
    }
}

component MainArea inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <[SongItem]> songs;
    in property <string> now-id; // the playing track: highlighted wherever it appears
    in property <bool> empty-library;
    in property <image> cover;
    in property <bool> has-cover;
    in property <bool> is-page; // a list page: the heading gets a cover
    callback zoom-cover();
    in property <string> kind-label; // «АЛЬБОМ», «ПЛЕЙЛИСТ», «ИСПОЛНИТЕЛЬ»…
    in property <bool> liked-cover; // the liked list: a heart on the accent instead of a cover
    in property <bool> can-play; // Play / Shuffle buttons
    callback play-all();
    callback shuffle-all();
    in property <[ReleaseItem]> releases; // artist pages: albums and singles
    in property <bool> home; // the home page: rows of cards instead of a track list
    in property <bool> settings;
    in property <bool> search; // the search page
    in property <bool> artist-view; // an artist page (sections instead of the track list)
    in property <bool> history;
    in property <bool> yt; // a YouTube Music page (YtUi)
    in property <[HistoryItem]> h-items;
    callback h-play(int);
    callback h-remove(int);
    in property <bool> stats;
    in property <[SourceChip]> st-periods;
    in property <[StatTile]> st-tiles;
    in property <[SongItem]> st-tracks;
    in property <int> st-total;
    in property <bool> st-expanded;
    in property <[HomeCard]> st-artists;
    in property <[HomeCard]> st-albums;
    in property <string> st-note;
    callback st-period(int);
    callback st-play(int);
    callback st-more();
    in property <[SongItem]> a-tracks;
    in property <int> a-total;
    in property <bool> a-expanded;
    in property <[HomeCard]> a-albums;
    in property <[HomeCard]> a-singles;
    in property <[HomeCard]> a-appears;
    in property <[HomeCard]> a-related;
    callback a-more();
    in property <[SourceChip]> s-chips;
    in property <string> s-state;
    in property <string> s-top-kind;
    in property <string> s-top-title;
    in property <string> s-top-sub;
    in property <image> s-top-cover;
    in property <bool> s-top-has-cover;
    in property <[SongItem]> s-tracks;
    in property <int> s-tracks-total;
    in property <bool> s-expanded;
    in property <[HomeCard]> s-artists;
    in property <[HomeCard]> s-albums;
    in property <[HomeCard]> s-playlists;
    callback s-source(int);
    callback s-play(int);
    callback s-top();
    callback s-more();
    callback s-artist(int);
    callback s-album(int);
    callback s-playlist(int);
    in property <[AccountRow]> accounts;
    in property <[ThemeChip]> themes;
    in property <bool> day;
    in property <bool> hotkeys;
    in property <[HotkeyRow]> hotkey-rows;
    in-out property <int> recording: -1;
    in property <bool> autostart;
    callback set-autostart(bool);
    in property <[FlagItem]> flags;
    callback set-flag(string, bool);
    callback set-main(string);
    callback set-tab(string, bool);
    callback set-theme(string);
    callback set-day(bool);
    callback set-hotkeys(bool);
    callback hotkey-start(int);
    callback hotkey-captured(int, string, bool, bool, bool);
    callback hotkey-cancel();
    callback hotkey-reset(int);
    callback hotkey-off(int);
    in property <[HomeSection]> sections;
    callback home-play(int, int); // section, card
    callback home-random();
    callback play(int);
    callback import-backup();
    callback open-artist(string);
    callback like-song(string);
    callback song-menu(string, int, length, length);
    callback open-album(string);
    in property <bool> can-save; // album / playlist / artist pages of a catalog
    in property <bool> can-share; // the page has a link to share (album, artist, a catalog's playlist)
    callback share-page();
    callback export-list(string); // csv | m3u
    in property <bool> saved;
    callback toggle-save();
    in property <bool> can-edit; // an own playlist: rename and delete
    callback rename-list();
    callback delete-list();
    padding-top: Grid.pad;
    padding-bottom: 4px;
    spacing: Grid.gap;
    // Page heading: cover, kind, title, «N треков · 47 мин», and Play / Shuffle for lists.
    HorizontalLayout {
        padding-left: Grid.pad + 4px;
        padding-right: Grid.pad;
        spacing: Grid.pad + 4px;
        if root.is-page: Cover {
            size: 184px;
            source: root.cover;
            has-source: root.has-cover;
            zoomable: !root.liked-cover;
            zoom => { root.zoom-cover(); }
            placeholder: root.liked-cover ? Icons.heart-filled : Icons.music;
            placeholder-color: root.liked-cover ? Theme.on-accent : Theme.mute;
            placeholder-bg: root.liked-cover ? Theme.accent : Theme.fill-hover;
        }
        VerticalLayout {
            alignment: root.is-page ? end : start;
            spacing: 4px;
            if root.kind-label != "": Caption { text: root.kind-label; }
            Text { text: title; font-family: Theme.heading-font; font-weight: Theme.heading-weight; font-size: root.is-page ? 44px : 32px; color: Theme.text; overflow: elide; }
            Text { text: subtitle; font-family: Theme.body-font; font-size: 15px; color: Theme.dim; overflow: elide; }
            // «Случайное» on the home page (Android's play-random button): a random card of the rows plays.
            // …and YouTube Music's own pages (the phone's Explore): new releases, moods and genres (no charts: owner's call).
            if root.home: HorizontalLayout {
                padding-top: 6px;
                spacing: 8px;
                alignment: start;
                if root.sections.length > 0: Rectangle {
                    width: rnd-row.preferred-width + 32px;
                    height: 38px;
                    border-radius: min(Theme.chip-radius, 19px);
                    background: rnd.has-hover ? Theme.accent2 : Theme.accent;
                    rnd-row := HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        Middle { Icon { icon: Icons.shuffle; size: 16px; color: Theme.on-accent; } }
                        Text { text: "Случайное"; font-family: Theme.body-font; font-weight: 700; font-size: 14px; color: Theme.on-accent; vertical-alignment: center; }
                    }
                    rnd := TouchArea { mouse-cursor: pointer; clicked => { root.home-random(); } }
                }
                Middle { Chip { label: "Новые релизы"; clicked => { YtUi.root-page("new"); } } }
                Middle { Chip { label: "Настроения и жанры"; clicked => { YtUi.root-page("moods"); } } }
            }
            // Chips of the page (the periods of «Мой топ»): their own row, so they never widen the heading.
            if PageChips.labels.length > 0: HorizontalLayout {
                padding-top: 6px;
                spacing: 6px;
                alignment: start;
                for c[ci] in PageChips.labels: Chip { label: c; selected: ci == PageChips.selected; clicked => { PageChips.pick(ci); } }
            }
            if root.can-play || root.can-edit || root.can-share: HorizontalLayout {
                padding-top: 6px;
                spacing: Grid.gap;
                alignment: start;
                if root.can-play: Rectangle {
                    width: pl.preferred-width + 54px;
                    height: 38px;
                    border-radius: min(Theme.chip-radius, 19px);
                    background: pa.has-hover ? Theme.accent2 : Theme.accent;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 18px;
                        spacing: 6px;
                        Middle { Icon { icon: Icons.play; size: 16px; color: Theme.on-accent; } }
                        pl := Text { text: "Слушать"; font-family: Theme.body-font; font-weight: 700; font-size: 14px; color: Theme.on-accent; vertical-alignment: center; }
                    }
                    pa := TouchArea { mouse-cursor: pointer; clicked => { root.play-all(); } }
                }
                if root.can-play: Rectangle {
                    width: sl.preferred-width + 54px;
                    height: 38px;
                    border-radius: min(Theme.chip-radius, 19px);
                    background: sa.has-hover ? Theme.fill-hover : Theme.fill;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 18px;
                        spacing: 6px;
                        Middle { Icon { icon: Icons.shuffle; size: 16px; color: Theme.text; } }
                        sl := Text { text: "Перемешать"; font-family: Theme.body-font; font-weight: 700; font-size: 14px; color: Theme.text; vertical-alignment: center; }
                    }
                    sa := TouchArea { mouse-cursor: pointer; clicked => { root.shuffle-all(); } }
                }
                // In the library / follow (pc/ PageHeader): a round button with the heart.
                if root.can-save: Rectangle {
                    width: 38px;
                    height: 38px;
                    border-radius: min(Theme.chip-radius, 19px);
                    background: va.has-hover ? Theme.fill-hover : Theme.fill;
                    Icon { icon: root.saved ? Icons.heart-filled : Icons.heart; size: 17px; color: root.saved ? Theme.accent : Theme.text; }
                    va := TouchArea { mouse-cursor: pointer; clicked => { root.toggle-save(); } }
                }
                // Share (the phone's «Поделиться»): the link goes to the clipboard.
                if root.can-share: Rectangle {
                    width: 38px;
                    height: 38px;
                    border-radius: min(Theme.chip-radius, 19px);
                    background: sha.has-hover ? Theme.fill-hover : Theme.fill;
                    Icon { icon: Icons.link; size: 17px; color: Theme.text; }
                    sha := TouchArea { mouse-cursor: pointer; clicked => { root.share-page(); } }
                }
                // Export the list (PlaylistExporter): CSV or M3U into «Загрузки».
                if root.can-play: Rectangle {
                    width: 38px;
                    height: 38px;
                    border-radius: min(Theme.chip-radius, 19px);
                    background: exa.has-hover ? Theme.fill-hover : Theme.fill;
                    Icon { icon: Icons.upload; size: 17px; color: Theme.text; }
                    exa := TouchArea { mouse-cursor: pointer; clicked => { export-menu.show(); } }
                    export-menu := PopupWindow {
                        x: 0;
                        y: parent.height + 6px;
                        width: 220px;
                        Rectangle {
                            border-radius: Grid.item-radius;
                            background: Theme.menu;
                            border-color: Theme.panel-border;
                            border-width: 1px;
                            drop-shadow-blur: 16px;
                            drop-shadow-color: #00000060;
                            VerticalLayout {
                                padding: 6px;
                                spacing: 2px;
                                MenuItem { icon: Icons.upload; label: "Экспорт в CSV"; clicked => { root.export-list("csv"); } }
                                MenuItem { icon: Icons.upload; label: "Экспорт в M3U"; clicked => { root.export-list("m3u"); } }
                                MenuItem { icon: Icons.download; label: "Скачать все треки"; clicked => { root.export-list("download"); } }
                                MenuItem { icon: Icons.plus; label: "Копировать в мои плейлисты"; clicked => { root.export-list("copy"); } }
                            }
                        }
                    }
                }
                if root.can-edit: Rectangle {
                    width: 38px;
                    height: 38px;
                    border-radius: min(Theme.chip-radius, 19px);
                    background: rna.has-hover ? Theme.fill-hover : Theme.fill;
                    Icon { icon: Icons.pencil; size: 17px; color: Theme.text; }
                    rna := TouchArea { mouse-cursor: pointer; clicked => { root.rename-list(); } }
                }
                if root.can-edit: Rectangle {
                    width: 38px;
                    height: 38px;
                    border-radius: min(Theme.chip-radius, 19px);
                    background: dla.has-hover ? Theme.fill-hover : Theme.fill;
                    Icon { icon: Icons.trash; size: 17px; color: Theme.text; }
                    dla := TouchArea { mouse-cursor: pointer; clicked => { root.delete-list(); } }
                }
            }
        }
    }
    // Releases strip (old artist layout; the artist view shows them in sections now).
    if root.releases.length > 0 && !root.artist-view: VerticalLayout {
        vertical-stretch: 0;
        spacing: 8px;
        Caption { x: Grid.pad + 4px; text: "РЕЛИЗЫ"; }
        Flickable {
            height: 172px;
            content-height: self.height;
            content-width: Grid.pad + 4px + root.releases.length * 140px;
            for r[i] in root.releases: Rectangle {
                x: Grid.pad + 4px + i * 140px;
                y: 0;
                width: 128px;
                height: 172px;
                VerticalLayout {
                    spacing: 4px;
                    alignment: start;
                    Cover { size: 128px; source: r.cover; has-source: r.has-cover; }
                    Text { text: r.title; font-family: Theme.body-font; font-size: 14px; color: rta.has-hover ? Theme.accent : Theme.text; overflow: elide; }
                    Text { text: r.subtitle; font-family: Theme.body-font; font-size: 12px; color: Theme.mute; overflow: elide; }
                }
                rta := TouchArea { mouse-cursor: pointer; clicked => { root.open-album(r.id); } }
            }
        }
    }
    if root.empty-library: VerticalLayout {
        alignment: center;
        spacing: Grid.gap;
        Text { text: "Медиатека пуста"; font-family: Theme.heading-font; font-weight: 700; font-size: 20px; color: Theme.text; horizontal-alignment: center; }
        Text { text: "Перенеси всё с телефона: резервная копия Drxwnify для Android (.backup)"; font-family: Theme.body-font; font-size: 14px; color: Theme.dim; horizontal-alignment: center; }
        HorizontalLayout {
            alignment: center;
            padding-top: 4px;
            Rectangle {
                width: 264px;
                height: 44px;
                border-radius: min(Theme.chip-radius, 22px);
                background: ta.has-hover ? Theme.accent2 : Theme.accent;
                Text { text: "Импортировать резервную копию"; font-family: Theme.body-font; font-weight: 700; font-size: 15px; color: Theme.on-accent; }
                ta := TouchArea { clicked => { root.import-backup(); } }
            }
        }
    }
    if PageState.loading: Skeleton { vertical-stretch: 1; }
    if root.history && !PageState.loading: HistoryView {
        vertical-stretch: 1;
        items: root.h-items;
        now-id: root.now-id;
        play(i) => { root.h-play(i); }
        remove(e) => { root.h-remove(e); }
        open-album(id) => { root.open-album(id); }
        open-artist(id) => { root.open-artist(id); }
        like-song(id) => { root.like-song(id); }
        song-menu(id, i, x, y) => { root.song-menu(id, i, x, y); }
    }
    if root.yt && !PageState.loading: YtView {
        vertical-stretch: 1;
        now-id: root.now-id;
        open-artist(id) => { root.open-artist(id); }
        open-album(id) => { root.open-album(id); }
        like-song(id) => { root.like-song(id); }
        song-menu(id, i, x, y) => { root.song-menu(id, i, x, y); }
    }
    if root.stats && !PageState.loading: StatsView {
        vertical-stretch: 1;
        periods: root.st-periods;
        tiles: root.st-tiles;
        tracks: root.st-tracks;
        tracks-total: root.st-total;
        expanded: root.st-expanded;
        artists: root.st-artists;
        albums: root.st-albums;
        note: root.st-note;
        now-id: root.now-id;
        period(i) => { root.st-period(i); }
        play(i) => { root.st-play(i); }
        more => { root.st-more(); }
        open-artist(id) => { root.open-artist(id); }
        like-song(id) => { root.like-song(id); }
        song-menu(id, i, x, y) => { root.song-menu(id, i, x, y); }
        open-album(id) => { root.open-album(id); }
    }
    if root.artist-view && !root.empty-library && !PageState.loading: ArtistView {
        vertical-stretch: 1;
        tracks: root.a-tracks;
        tracks-total: root.a-total;
        expanded: root.a-expanded;
        albums: root.a-albums;
        singles: root.a-singles;
        appears: root.a-appears;
        related: root.a-related;
        now-id: root.now-id;
        play(i) => { root.play(i); }
        more => { root.a-more(); }
        open-artist(id) => { root.open-artist(id); }
        like-song(id) => { root.like-song(id); }
        song-menu(id, i, x, y) => { root.song-menu(id, i, x, y); }
        open-album(id) => { root.open-album(id); }
    }
    if root.search: SearchPage {
        vertical-stretch: 1;
        chips: root.s-chips;
        state: root.s-state;
        top-kind: root.s-top-kind;
        top-title: root.s-top-title;
        top-sub: root.s-top-sub;
        top-cover: root.s-top-cover;
        top-has-cover: root.s-top-has-cover;
        tracks: root.s-tracks;
        tracks-total: root.s-tracks-total;
        expanded: root.s-expanded;
        artists: root.s-artists;
        albums: root.s-albums;
        playlists: root.s-playlists;
        now-id: root.now-id;
        source(i) => { root.s-source(i); }
        play(i) => { root.s-play(i); }
        top => { root.s-top(); }
        more => { root.s-more(); }
        open-album(id) => { root.open-album(id); }
        open-artist(id) => { root.open-artist(id); }
        like-song(id) => { root.like-song(id); }
        song-menu(id, i, x, y) => { root.song-menu(id, i, x, y); }
        artist(i) => { root.s-artist(i); }
        album(i) => { root.s-album(i); }
        playlist(i) => { root.s-playlist(i); }
    }
    if root.settings: SettingsPage {
        vertical-stretch: 1;
        accounts: root.accounts;
        themes: root.themes;
        day: root.day;
        hotkeys: root.hotkeys;
        set-hotkeys(v) => { root.set-hotkeys(v); }
        hotkey-rows: root.hotkey-rows;
        recording <=> root.recording;
        hotkey-start(i) => { root.hotkey-start(i); }
        hotkey-captured(i, t, c, a, sh) => { root.hotkey-captured(i, t, c, a, sh); }
        hotkey-cancel => { root.hotkey-cancel(); }
        hotkey-reset(i) => { root.hotkey-reset(i); }
        hotkey-off(i) => { root.hotkey-off(i); }
        autostart: root.autostart;
        set-autostart(v) => { root.set-autostart(v); }
        flags: root.flags;
        set-flag(k, v) => { root.set-flag(k, v); }
        set-main(k) => { root.set-main(k); }
        set-tab(k, v) => { root.set-tab(k, v); }
        set-theme(id) => { root.set-theme(id); }
        set-day(v) => { root.set-day(v); }
    }
    // Home: rows of cards, the page scrolls down, each row sideways.
    if root.home && !root.settings && !root.search && !root.history && !root.stats && !root.empty-library: Flickable {
        vertical-stretch: 1;
        content-height: root.sections.length * 284px + Grid.pad;
        for sec[si] in root.sections: VerticalLayout {
            x: 0;
            y: si * 284px;
            width: parent.width;
            height: 262px;
            spacing: 8px;
            HorizontalLayout {
                padding-left: Grid.pad + 4px;
                height: 32px;
                spacing: 10px;
                alignment: start;
                Link {
                    text: sec.title;
                    font-family: Theme.heading-font;
                    font-weight: 700;
                    font-size: 22px;
                    color: Theme.text;
                    enabled: sec.artist-id != "";
                    clicked => { root.open-artist(sec.artist-id); }
                }
                if sec.label != "": Text {
                    text: sec.label;
                    font-family: Theme.body-font;
                    font-size: 14px;
                    color: Theme.mute;
                    vertical-alignment: center;
                }
            }
            strip := ArrowStrip {
                property <int> hover-i: -1;
                height: 222px;
                content-w: Grid.pad + 4px + sec.cards.length * 176px + Grid.pad;
                hot: self.hover-i >= 0;
                arrow-y: 80px - 20px;
                for card[ci] in sec.cards: cb := Rectangle {
                    x: Grid.pad + 4px + ci * 176px;
                    y: 0;
                    width: 160px;
                    height: 212px;
                    property <bool> playing: !card.album && root.now-id != "" && card.id == root.now-id;
                    VerticalLayout {
                        spacing: 4px;
                        alignment: start;
                        Rectangle {
                            width: 160px;
                            height: 160px;
                            Cover { size: 160px; source: card.cover; has-source: card.has-cover; }
                            // Play hint over a track cover on hover (and while it plays).
                            if !card.album && (cta.has-hover || cb.playing): Rectangle {
                                x: parent.width - 44px;
                                y: parent.height - 44px;
                                width: 36px;
                                height: 36px;
                                border-radius: min(Theme.chip-radius, 18px);
                                background: Theme.accent;
                                Icon { icon: Icons.play; size: 18px; color: Theme.on-accent; }
                            }
                        }
                        Text { text: card.title; font-family: Theme.body-font; font-size: 15px; color: cb.playing || cta.has-hover ? Theme.accent : Theme.text; overflow: elide; }
                        Text { text: card.subtitle; font-family: Theme.body-font; font-size: 14px; color: Theme.dim; overflow: elide; }
                    }
                    cta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if card.album { root.open-album(card.id); } else { root.home-play(si, ci); }
                        }
                        changed has-hover => {
                            if self.has-hover { strip.hover-i = ci; } else if strip.hover-i == ci { strip.hover-i = -1; }
                        }
                    }
                }
            }
        }
    }
    if !root.home && !root.settings && !root.search && !root.artist-view && !root.history && !root.stats && !root.yt && !root.empty-library && !PageState.loading: HorizontalLayout {
        vertical-stretch: 1;
        padding-left: 8px;
        padding-right: 4px;
        ListView {
            for song in root.songs: SongRow {
                song: song;
                current: root.now-id != "" && song.id == root.now-id;
                play => { root.play(song.index - 1); }
                open-artist(id) => { root.open-artist(id); }
                open-album(id) => { root.open-album(id); }
                like-song(id) => { root.like-song(id); }
                song-menu(id, i, x, y) => { root.song-menu(id, i, x, y); }
            }
        }
    }
}

// On short windows the queue/lyrics block is cut off at the bottom, instead of the column
// pushing the player bar out of the window.
// One track of the queue panel (Spotify's queue): cover, title, artists; on hover up / down / remove.
component QueueRow inherits Rectangle {
    in property <SongItem> song;
    in property <bool> current;
    in property <bool> actions: true;
    in property <bool> first;
    in property <bool> last;
    callback play();
    callback up();
    callback down();
    callback remove();
    height: 56px;
    border-radius: Grid.small-radius;
    // Hovering a button keeps the row «hot» (otherwise the buttons vanish and the click plays the row).
    property <bool> hot: qr-ta.has-hover || qb-up.hovered || qb-down.hovered || qb-x.hovered;
    background: root.hot ? Theme.fill-hover : transparent;
    qr-ta := TouchArea { mouse-cursor: pointer; clicked => { root.play(); } }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 10px;
        Middle { Cover { size: 40px; source: root.song.cover; has-source: root.song.has-cover; radius: Grid.row-cover-radius; } }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: root.song.title; font-family: Theme.body-font; font-weight: 600; font-size: 14px; color: root.current ? Theme.accent : Theme.text; overflow: elide; }
            Text { text: root.song.artists; font-family: Theme.body-font; font-size: 13px; color: Theme.dim; overflow: elide; }
        }
        Middle { qb-up := IconButton { size: 28px; icon-size: 15px; icon: Icons.chevron-up; visible: root.actions && root.hot && !root.first; enabled: self.visible; clicked => { root.up(); } } }
        Middle { qb-down := IconButton { size: 28px; icon-size: 15px; icon: Icons.chevron-down; visible: root.actions && root.hot && !root.last; enabled: self.visible; clicked => { root.down(); } } }
        Middle { qb-x := IconButton { size: 28px; icon-size: 14px; icon: Icons.x; visible: root.actions && root.hot; enabled: self.visible; clicked => { root.remove(); } } }
    }
}

// The lyrics of the playing track over the centre (Spotify's lyrics view): every line, the sung one bright and kept
// at a third of the height, a click on a line jumps there (synced lyrics); plain lyrics just scroll.
component LyricsView inherits Rectangle {
    in property <[LyricLine]> lines;
    in property <int> current: -1;
    in property <bool> synced;
    in property <string> title;
    in property <string> artists;
    in property <string> status; // «Ищу текст…», «Текста нет»
    callback seek(int);
    callback close();
    property <length> target-y: 0;
    // The sung line goes to a third of the height.
    function follow() {
        if root.synced && root.current >= 0 {
            lv-flick.content-y = max(min(0px, lv-flick.height - lv-flick.content-height), min(0px, -(root.target-y - lv-flick.height * 0.33)));
        }
    }
    background: transparent;
    min-width: 0;
    max-width: 100000px;
    min-height: 0;
    max-height: 100000px;
    lv-flick := Flickable {
        width: parent.width;
        height: parent.height;
        animate content-y { duration: 350ms; easing: ease-out; }
        content-height: lv-col.preferred-height;
        lv-col := VerticalLayout {
            width: root.width;
            padding-left: Grid.pad * 3;
            padding-right: Grid.pad * 3;
            padding-top: 28px;
            padding-bottom: root.height * 0.5;
            spacing: 14px;
            alignment: start;
            Text { text: root.title; font-family: Theme.heading-font; font-weight: Theme.heading-weight; font-size: 28px; color: Theme.text; overflow: elide; }
            Text { text: root.artists; font-family: Theme.body-font; font-size: 15px; color: Theme.dim; overflow: elide; }
            Rectangle { height: 12px; }
            if root.lines.length == 0: Text { text: root.status; font-family: Theme.body-font; font-size: 16px; color: Theme.mute; }
            for l[i] in root.lines: Rectangle {
                property <bool> is-cur: root.synced && i == root.current;
                changed is-cur => { if self.is-cur { root.target-y = self.y; root.follow(); } }
                height: lt.preferred-height + 4px;
                lt := Text {
                    width: parent.width;
                    text: l.text == "" ? "♪" : l.text;
                    wrap: word-wrap;
                    font-family: Theme.heading-font;
                    font-weight: 700;
                    font-size: 26px;
                    color: !root.synced ? Theme.text
                        : i == root.current ? Theme.text
                        : i < root.current ? Theme.mute : Theme.dim;
                }
                if root.synced: TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.seek(l.time-ms); }
                }
            }
        }
    }
    // Close, top right.
    Rectangle {
        x: parent.width - self.width - Grid.pad;
        y: Grid.pad;
        width: 36px;
        height: 36px;
        border-radius: 18px;
        background: lv-x.has-hover ? Theme.fill-hover : Theme.fill;
        Icon { icon: Icons.x; size: 16px; color: Theme.text; }
        lv-x := TouchArea { mouse-cursor: pointer; clicked => { root.close(); } }
    }
}

component RightPanel inherits VerticalLayout {
    in property <string> title;
    in property <string> artists;
    in property <string> info;
    in property <string> artist-id;
    in property <string> album-id;
    in property <image> cover;
    in property <bool> has-cover;
    in property <[QueueItem]> upcoming;
    callback open-artist(string);
    callback like-song(string);
    callback song-menu(string, int, length, length);
    callback open-album(string);
    in property <string> lyric-now;
    in property <string> lyric-next;
    in property <bool> has-lyrics;
    in property <bool> liked;
    in property <bool> can-like;
    callback toggle-like();
    callback zoom-cover();
    // The queue instead of «Сейчас играет» (the player bar's list button).
    in property <bool> queue-open;
    in property <SongItem> queue-now;
    in property <bool> queue-has-now;
    in property <[SongItem]> queue-items; // what comes next, in order
    in property <int> queue-more;         // beyond the rows shown
    callback queue-play(int);             // index in queue-items; -1 = the playing one
    callback queue-remove(int);
    callback queue-move(int, int);
    callback queue-clear();
    callback queue-close();
    property <length> cover-size: root.width - 2 * Grid.pad;
    padding: Grid.pad;
    padding-bottom: 0;
    spacing: Grid.gap;
    if root.queue-open: Header {
        SectionTitle { text: "Очередь"; horizontal-stretch: 1; }
        if root.queue-items.length > 0: Middle { Link { text: "Очистить"; font-size: 14px; clicked => { root.queue-clear(); } } }
        Middle { IconButton { size: 30px; icon-size: 15px; icon: Icons.x; clicked => { root.queue-close(); } } }
    }
    if root.queue-open: VerticalLayout {
        vertical-stretch: 1;
        spacing: 6px;
        if root.queue-has-now: Caption { text: "СЕЙЧАС ИГРАЕТ"; }
        if root.queue-has-now: QueueRow { song: root.queue-now; current: true; actions: false; play => { root.queue-play(-1); } }
        Caption { text: root.queue-items.length == 0 ? "ДАЛЕЕ · ПУСТО" : "ДАЛЕЕ"; }
        ListView {
            vertical-stretch: 1;
            for s[i] in root.queue-items: QueueRow {
                song: s;
                first: i == 0;
                last: i == root.queue-items.length - 1;
                play => { root.queue-play(i); }
                up => { root.queue-move(i, i - 1); }
                down => { root.queue-move(i, i + 1); }
                remove => { root.queue-remove(i); }
            }
        }
        if root.queue-more > 0: Text { text: "и ещё " + root.queue-more; font-family: Theme.body-font; font-size: 13px; color: Theme.mute; }
    }
    if !root.queue-open: Header { SectionTitle { text: "Сейчас играет"; } }
    if !root.queue-open: HorizontalLayout {
        alignment: start;
        Cover { size: root.cover-size; source: root.cover; has-source: root.has-cover; placeholder-size: 64px; zoomable: true; zoom => { root.zoom-cover(); } }
    }
    if !root.queue-open: HorizontalLayout {
        spacing: Grid.gap;
        VerticalLayout {
            spacing: 4px;
            horizontal-stretch: 1;
            Text { text: title == "" ? "Ничего не играет" : title; font-family: Theme.heading-font; font-weight: 700; font-size: 20px; color: Theme.text; overflow: elide; }
            if artists != "": HorizontalLayout {
                alignment: start;
                Link { text: artists; font-size: 14px; enabled: root.artist-id != ""; clicked => { root.open-artist(root.artist-id); } }
            }
            if info != "": HorizontalLayout {
                alignment: start;
                Link { text: info; font-family: Theme.mono-font; font-size: 12px; color: Theme.mute; enabled: root.album-id != ""; clicked => { root.open-album(root.album-id); } }
            }
        }
        if root.can-like: VerticalLayout {
            alignment: start;
            IconButton {
                icon: root.liked ? Icons.heart-filled : Icons.heart;
                active: root.liked;
                active-color: Theme.accent;
                clicked => { root.toggle-like(); }
            }
        }
    }
    if !root.queue-open: Rectangle {
        vertical-stretch: 1;
        min-height: 0;
        clip: true;
        VerticalLayout {
            y: 0;
            height: self.preferred-height;
            alignment: start;
            spacing: Grid.gap;
            HLine { }
            Caption { text: "ДАЛЕЕ"; }
            if root.upcoming.length == 0: Text { text: "Очередь пуста"; font-family: Theme.body-font; font-size: 14px; color: Theme.mute; }
            // The core sends the next three tracks.
            for q in root.upcoming: VerticalLayout {
                spacing: 2px;
                Text { text: q.title; font-family: Theme.body-font; font-size: 14px; color: Theme.text; overflow: elide; }
                Text { text: q.artists; font-family: Theme.body-font; font-size: 12px; color: Theme.dim; overflow: elide; }
            }
            if root.has-lyrics: HLine { }
            if root.has-lyrics: Caption { text: "ТЕКСТ"; }
            if root.has-lyrics: Text { text: root.lyric-now == "" ? "…" : root.lyric-now; font-family: Theme.body-font; font-weight: 700; font-size: 16px; color: Theme.accent; wrap: word-wrap; }
            if root.has-lyrics && root.lyric-next != "": Text { text: root.lyric-next; font-family: Theme.body-font; font-size: 14px; color: Theme.dim; wrap: word-wrap; }
        }
    }
}


// Player bar: three sections as wide as the columns above (library | content | now playing).
component PlayerBar inherits HorizontalLayout {
    in property <image> cover;
    in property <bool> has-cover;
    in property <string> title;
    in property <string> artists;
    in property <string> artist-id;
    in property <string> album-id;
    callback open-artist(string);
    callback open-album(string);
    callback like-song(string);
    callback song-menu(string, int, length, length);
    property <float> before-mute: 0.8;
    in property <bool> liked;
    in property <bool> can-like;
    callback toggle-like();
    in property <bool> playing;
    in property <float> progress; // 0..1
    in property <string> position;
    in property <string> duration;
    in property <float> total-s;
    in-out property <float> volume: 0.8;
    callback toggle();
    callback next();
    callback prev();
    callback seek(float);
    callback volume-changed(float);
    in property <bool> day;
    in property <bool> shuffle;
    in property <int> repeat;
    callback set-day(bool);
    callback toggle-shuffle();
    callback cycle-repeat();
    // Sleep timer (Android SleepTimer): minutes, -1 = at the end of the track, 0 = off.
    in property <bool> sleep-on;
    in property <string> sleep-label; // «23:41» or «конец трека» while on
    in property <bool> sleep-fade;
    in property <bool> sleep-after;
    callback sleep-set(int);
    callback sleep-option(string); // fade | after
    in property <bool> queue-open;
    callback toggle-queue();
    in property <bool> lyrics-open;
    callback toggle-lyrics();
    height: Grid.bar-height;
    HorizontalLayout {
        width: Grid.lib-width + 1px;
        padding-left: Grid.pad;
        padding-right: Grid.pad;
        spacing: Grid.gap;
        Middle { Cover { size: 52px; source: root.cover; has-source: root.has-cover; radius: Grid.row-cover-radius; } }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                alignment: start;
                Link {
                    text: root.title == "" ? "Ничего не играет" : root.title;
                    font-size: 16px;
                    font-weight: 700;
                    color: root.title == "" ? Theme.mute : Theme.text;
                    enabled: root.album-id != "";
                    clicked => { root.open-album(root.album-id); }
                }
            }
            if artists != "": HorizontalLayout {
                alignment: start;
                Link { text: artists; enabled: root.artist-id != ""; clicked => { root.open-artist(root.artist-id); } }
            }
        }
        if root.can-like: Middle {
            IconButton {
                icon: root.liked ? Icons.heart-filled : Icons.heart;
                size: 32px;
                icon-size: 17px;
                active: root.liked;
                active-color: Theme.accent;
                tint: Theme.mute;
                clicked => { root.toggle-like(); }
            }
        }
    }
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        padding-left: Grid.pad;
        padding-right: Grid.pad;
        HorizontalLayout {
            alignment: center;
            spacing: Grid.gap;
            Middle { IconButton { icon: Icons.shuffle; active: root.shuffle; active-color: Theme.accent; clicked => { root.toggle-shuffle(); } } }
            Middle { IconButton { icon: Icons.prev; clicked => { root.prev(); } } }
            Middle {
                Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: min(Theme.chip-radius, 22px);
                    background: pta.has-hover ? Theme.accent2 : Theme.accent;
                    Icon { icon: root.playing ? Icons.pause : Icons.play; size: 22px; color: Theme.on-accent; }
                    pta := TouchArea { clicked => { root.toggle(); } }
                }
            }
            Middle { IconButton { icon: Icons.next; clicked => { root.next(); } } }
            Middle { IconButton { icon: root.repeat == 1 ? Icons.repeat-once : Icons.repeat; active: root.repeat != 0; active-color: Theme.accent; clicked => { root.cycle-repeat(); } } }
        }
        HorizontalLayout {
            spacing: 8px;
            Text { text: position; font-family: Theme.body-font; font-size: 13px; color: Theme.dim; vertical-alignment: center; width: 46px; horizontal-alignment: right; }
            Slider { value: root.progress; total-s: root.total-s; picked(f) => { root.seek(f); } }
            Text { text: duration; font-family: Theme.body-font; font-size: 13px; color: Theme.dim; vertical-alignment: center; width: 46px; }
        }
    }
    HorizontalLayout {
        width: Grid.side-width + 1px;
        padding-left: Grid.pad;
        padding-right: Grid.pad;
        spacing: 4px;
        alignment: end;
        if root.sleep-on: Text {
            text: root.sleep-label;
            font-family: Theme.body-font; font-size: 13px; color: Theme.accent;
            vertical-alignment: center;
        }
        // «Темп и тон» (the phone's player menu): the speed as a word, lit when not as recorded.
        Middle {
            Rectangle {
                property <bool> changed: TempoUi.tempo != 1 || TempoUi.pitch != 0;
                width: max(36px, tl.preferred-width + 14px);
                height: 32px;
                border-radius: 16px;
                background: tpa.has-hover ? Theme.fill-hover : transparent;
                tl := Text {
                    text: round(TempoUi.tempo * 100) / 100 + "×";
                    font-family: Theme.body-font; font-weight: 700; font-size: 13px;
                    color: parent.changed ? Theme.accent : (tpa.has-hover ? Theme.text : Theme.dim);
                }
                tpa := TouchArea { mouse-cursor: pointer; clicked => { tempo-menu.show(); } }
                tempo-menu := PopupWindow {
                    width: 260px;
                    height: tm-col.preferred-height;
                    x: parent.width - self.width;
                    y: -self.height - 10px;
                    close-policy: close-on-click-outside;
                    Rectangle {
                        border-radius: Grid.item-radius;
                        background: Theme.menu;
                        border-color: Theme.panel-border;
                        border-width: 1px;
                        drop-shadow-blur: 16px;
                        drop-shadow-color: #00000060;
                    }
                    tm-col := VerticalLayout {
                        padding: 12px;
                        spacing: 10px;
                        Text { text: "Темп и тон"; font-family: Theme.body-font; font-weight: 700; font-size: 15px; color: Theme.text; }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Темп"; font-family: Theme.body-font; font-size: 14px; color: Theme.dim; vertical-alignment: center; horizontal-stretch: 1; }
                            IconButton { icon: Icons.minus; size: 30px; icon-size: 14px; filled: true; clicked => { TempoUi.set(TempoUi.tempo - 0.05, TempoUi.pitch); } }
                            Text { text: round(TempoUi.tempo * 100) / 100 + "×"; min-width: 52px; horizontal-alignment: center; font-family: Theme.body-font; font-weight: 700; font-size: 15px; color: Theme.text; vertical-alignment: center; }
                            IconButton { icon: Icons.plus; size: 30px; icon-size: 14px; filled: true; clicked => { TempoUi.set(TempoUi.tempo + 0.05, TempoUi.pitch); } }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Тон"; font-family: Theme.body-font; font-size: 14px; color: Theme.dim; vertical-alignment: center; horizontal-stretch: 1; }
                            IconButton { icon: Icons.minus; size: 30px; icon-size: 14px; filled: true; clicked => { TempoUi.set(TempoUi.tempo, TempoUi.pitch - 1); } }
                            Text { text: (TempoUi.pitch > 0 ? "+" : "") + TempoUi.pitch; min-width: 52px; horizontal-alignment: center; font-family: Theme.body-font; font-weight: 700; font-size: 15px; color: Theme.text; vertical-alignment: center; }
                            IconButton { icon: Icons.plus; size: 30px; icon-size: 14px; filled: true; clicked => { TempoUi.set(TempoUi.tempo, TempoUi.pitch + 1); } }
                        }
                        HorizontalLayout {
                            alignment: end;
                            Pill { label: "Сбросить"; clicked => { TempoUi.set(1, 0); } }
                        }
                    }
                }
            }
        }
        Middle {
            Rectangle {
                width: sl-btn.width;
                height: sl-btn.height;
                sl-btn := IconButton { icon: Icons.zzz; active: root.sleep-on; active-color: Theme.accent; clicked => { sleep-menu.show(); } }
                sleep-menu := PopupWindow {
                    width: 250px;
                    height: sm-col.preferred-height;
                    x: sl-btn.width - self.width;
                    y: -self.height - 10px;
                    Rectangle {
                        border-radius: Grid.item-radius;
                        background: Theme.menu;
                        border-color: Theme.panel-border;
                        border-width: 1px;
                        drop-shadow-blur: 16px;
                        drop-shadow-color: #00000060;
                    }
                    sm-col := VerticalLayout {
                        padding: 6px;
                        spacing: 2px;
                        HorizontalLayout { padding-left: 10px; Text { height: 30px; text: "Таймер сна"; font-family: Theme.heading-font; font-weight: 700; font-size: 14px; color: Theme.text; vertical-alignment: center; } }
                        MenuItem { icon: Icons.clock; label: "15 минут"; clicked => { root.sleep-set(15); } }
                        MenuItem { icon: Icons.clock; label: "30 минут"; clicked => { root.sleep-set(30); } }
                        MenuItem { icon: Icons.clock; label: "45 минут"; clicked => { root.sleep-set(45); } }
                        MenuItem { icon: Icons.clock; label: "1 час"; clicked => { root.sleep-set(60); } }
                        MenuItem { icon: Icons.clock; label: "1,5 часа"; clicked => { root.sleep-set(90); } }
                        MenuItem { icon: Icons.track-next; label: "В конце трека"; clicked => { root.sleep-set(-1); } }
                        HLine { }
                        MenuItem { label: "Плавное затухание"; checked: root.sleep-fade; clicked => { root.sleep-option("fade"); } }
                        MenuItem { label: "Дождаться конца трека"; checked: root.sleep-after; clicked => { root.sleep-option("after"); } }
                        if root.sleep-on: HLine { }
                        if root.sleep-on: MenuItem { icon: Icons.x; label: "Выключить таймер"; clicked => { root.sleep-set(0); } }
                    }
                }
            }
        }
        Middle { IconButton { icon: root.day ? Icons.sun : Icons.moon; clicked => { root.set-day(!root.day); } } }
        Middle { IconButton { icon: Icons.microphone; active: root.lyrics-open; active-color: Theme.accent; clicked => { root.toggle-lyrics(); } } }
        Middle { IconButton { icon: Icons.list; active: root.queue-open; active-color: Theme.accent; clicked => { root.toggle-queue(); } } }
        Middle {
            IconButton {
                icon: root.volume <= 0.001 ? Icons.volume-off : Icons.volume;
                clicked => {
                    if root.volume > 0.001 {
                        root.before-mute = root.volume;
                        root.volume = 0;
                    } else {
                        root.volume = root.before-mute > 0.01 ? root.before-mute : 0.5;
                    }
                    root.volume-changed(root.volume);
                }
            }
        }
        Middle {
            Slider {
                width: 96px;
                value: root.volume;
                live: true;
                picked(v) => { root.volume = v; root.volume-changed(v); }
            }
        }
    }
}

// A round picture of a person (base64 JPEG from their profile), or the first letter on the accent.
component Avatar inherits Rectangle {
    in property <image> source;
    in property <bool> has-source;
    in property <string> initial;
    in property <length> size: 44px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    clip: true;
    background: root.has-source ? transparent : Theme.accent;
    if root.has-source: Image { width: root.size; height: root.size; source: root.source; image-fit: cover; }
    if !root.has-source: Text { text: root.initial; font-family: Theme.heading-font; font-weight: 700; font-size: root.size * 0.42; color: Theme.on-accent; }
    in property <bool> zoomable;
    callback zoom();
    if root.zoomable && root.has-source: TouchArea { mouse-cursor: pointer; clicked => { root.zoom(); } }
}

// One chat message (pc/ FriendChat): mine on the right in the accent's tint, the friend's on the left; a shared
// track, album or artist on top with its play button; time, «изменено» and (mine) sent / read under the text.
// A message as Telegram Desktop draws it (ui/chat/chat.style): a bubble up to 430 px, padding 11/8, large corners 16 px
// and small ones where it attaches to its group, the tail on a group's last message, time and ticks at the bottom
// right (on the text's line when it fits), reactions above them. A double click answers it; a click on its quote goes
// to the quoted message; hovering shows the quick ♥.
component ChatBubble inherits Rectangle {
    in property <ChatItem> m;
    in property <length> max-w: 430px;
    in property <bool> flash; // just jumped to: lit for a moment
    in property <bool> selecting; // some messages are picked: a click picks this one too
    callback play();
    callback pick();
    callback link(string);
    callback react(string);
    callback menu(length, length);
    callback reply();
    callback quote();
    property <length> big-r: 16px;
    property <length> small-r: 6px;
    property <color> fill: root.m.mine ? Theme.accent.mix(Theme.bg, 0.24) : Theme.fill-hover;
    property <bool> big: root.m.stickers.length > 0;
    property <bool> q-hot;
    property <bool> h-hot;
    property <bool> hot: bg.has-hover || root.q-hot || root.h-hot;
    probe := Text { visible: false; text: root.m.text; font-family: Theme.body-font; font-size: 15px; }
    // Time, «изменено» and ticks; on the last line of a one-line text when there is room.
    property <length> meta-w: meta-probe.preferred-width;
    meta-probe := HorizontalLayout {
        visible: false;
        spacing: 4px;
        Text { text: root.m.time; font-size: 13px; }
        if root.m.edited: Text { text: "изменено"; font-size: 13px; }
        if root.m.mine: Rectangle { width: 16px; }
    }
    property <length> text-max: root.max-w - 22px;
    property <bool> one-line: root.m.text != "" && probe.preferred-height < 26px;
    property <bool> inline-meta: root.one-line && root.m.reactions.length == 0 && probe.preferred-width + 10px + root.meta-w <= root.text-max;
    property <length> text-w: min(root.text-max, probe.preferred-width + 1px);
    property <length> sticker-h: root.big ? min(96px, (root.max-w - 22px - (root.m.stickers.length - 1) * 4px) / max(0.1, root.m.sticker-ratio)) : 0px;
    property <length> sticker-w: root.sticker-h * root.m.sticker-ratio + (root.m.stickers.length - 1) * 4px;
    property <length> card-w: root.m.has-music || root.m.reply-who != "" || root.m.links.length > 0 ? min(root.text-max, root.m.has-music ? 300px : 220px) : 0px;
    property <length> inner-w: max(root.card-w, max(root.inline-meta ? root.text-w + 10px + root.meta-w : max(root.text-w, root.meta-w), root.sticker-w));
    width: min(root.max-w, root.inner-w + 22px);
    height: col.preferred-height;
    background: root.big ? transparent : (root.flash ? root.fill.mix(Theme.accent, 0.6) : root.fill);
    animate background { duration: 400ms; }
    // Corners: big outside, small where the group continues; none at the tail.
    border-top-left-radius: root.m.mine || root.m.first ? root.big-r : root.small-r;
    border-bottom-left-radius: root.m.mine ? root.big-r : (root.m.last ? 0px : root.small-r);
    border-top-right-radius: !root.m.mine || root.m.first ? root.big-r : root.small-r;
    border-bottom-right-radius: !root.m.mine ? root.big-r : (root.m.last ? 0px : root.small-r);
    // The tail (Telegram's bubble corner) on a group's last message.
    if root.m.last && !root.big: Path {
        x: root.m.mine ? root.width : -9px;
        y: root.height - 14px;
        width: 9px;
        height: 14px;
        viewbox-width: 9;
        viewbox-height: 14;
        fill: root.flash ? root.fill.mix(Theme.accent, 0.6) : root.fill;
        commands: root.m.mine ? "M 0 0 C 0 8 3 12 9 14 L 0 14 Z" : "M 9 0 C 9 8 6 12 0 14 L 9 14 Z";
    }
    // Behind the content: right press = the menu, double click = answer (Telegram's default quick action).
    bg := TouchArea {
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                root.menu(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
            }
        }
        double-clicked => { if !root.selecting { root.reply(); } }
        clicked => { if root.selecting { root.pick(); } }
    }
    // The quick reaction beside the bubble while it is hovered.
    if root.hot && !root.big: Rectangle {
        x: root.m.mine ? -34px : root.width + 6px;
        y: root.height - 28px;
        width: 28px;
        height: 28px;
        border-radius: 14px;
        background: hra.has-hover ? Theme.fill-hover : Theme.menu;
        drop-shadow-blur: 6px;
        drop-shadow-color: #00000050;
        Icon { icon: Icons.heart; size: 14px; color: hra.has-hover ? Theme.accent : Theme.dim; }
        hra := TouchArea { mouse-cursor: pointer; clicked => { root.react("e:❤️"); } changed has-hover => { root.h-hot = self.has-hover; } }
    }
    col := VerticalLayout {
        width: root.width;
        padding-left: 11px;
        padding-right: 11px;
        padding-top: root.big ? 0px : 7px;
        padding-bottom: root.big ? 0px : 7px;
        spacing: 4px;
        // The message it answers (Telegram's quote): an accent bar, who, the text in one line; a click goes there.
        if root.m.reply-who != "": Rectangle {
            height: qrow.preferred-height + 8px;
            border-radius: 6px;
            background: qa.has-hover ? Theme.accent.mix(Theme.bg, 0.30) : Theme.accent.mix(Theme.bg, 0.12);
            qrow := HorizontalLayout {
                spacing: 8px;
                padding-right: 8px;
                padding-top: 4px;
                padding-bottom: 4px;
                Rectangle { width: 3px; border-radius: 1.5px; background: Theme.accent; }
                VerticalLayout {
                    spacing: 1px;
                    horizontal-stretch: 1;
                    Text { text: root.m.reply-who; font-family: Theme.body-font; font-weight: 700; font-size: 13px; color: Theme.accent; overflow: elide; }
                    Text { text: root.m.reply-text; font-family: Theme.body-font; font-size: 13px; color: Theme.dim; overflow: elide; }
                }
            }
            qa := TouchArea { mouse-cursor: root.m.reply-index >= 0 ? pointer : default; clicked => { root.quote(); } changed has-hover => { root.q-hot = self.has-hover; } }
        }
        if root.m.has-music: HorizontalLayout {
            spacing: 10px;
            padding-top: 2px;
            padding-bottom: 2px;
            Middle { IconButton { icon: root.m.music-kind == "track" ? Icons.play : Icons.chevron-right; size: 40px; icon-size: 18px; filled: true; clicked => { root.play(); } } }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text { text: root.m.music-title; font-family: Theme.body-font; font-weight: 700; font-size: 14px; color: Theme.text; overflow: elide; }
                Text { text: root.m.music-by; font-family: Theme.body-font; font-size: 13px; color: Theme.dim; overflow: elide; }
            }
            Middle { Cover { size: 44px; source: root.m.music-cover; has-source: root.m.has-music-cover; radius: 8px; placeholder: root.m.music-kind == "artist" ? Icons.user-circle : (root.m.music-kind == "album" ? Icons.album : Icons.music); } }
        }
        if root.big: HorizontalLayout {
            spacing: 4px;
            alignment: root.m.mine ? end : start;
            for st in root.m.stickers: Image {
                source: Stickers.all[st.pic];
                width: root.sticker-h * st.ratio;
                height: root.sticker-h;
                image-fit: contain;
            }
        }
        if root.m.text != "" && !root.inline-meta: Text {
            text: root.m.text;
            wrap: word-wrap;
            font-family: Theme.body-font;
            font-size: 15px;
            color: Theme.text;
        }
        // Links (Telegram underlines them in the text; here each is a line under it that opens in the browser).
        for l in root.m.links: Rectangle {
            height: 28px;
            border-radius: 6px;
            background: la.has-hover ? Theme.accent.mix(Theme.bg, 0.30) : Theme.accent.mix(Theme.bg, 0.12);
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                Middle { Icon { icon: Icons.link; size: 14px; color: Theme.accent; } }
                Text { text: l; font-family: Theme.body-font; font-size: 13px; color: Theme.accent; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
            }
            la := TouchArea { mouse-cursor: pointer; clicked => { root.link(l); } }
        }
        if root.m.reactions.length > 0: HorizontalLayout {
            spacing: 4px;
            alignment: start;
            for r in root.m.reactions: Rectangle {
                height: 26px;
                width: rrow.preferred-width;
                border-radius: 13px;
                background: r.mine ? Theme.accent : Theme.accent.mix(Theme.bg, 0.18);
                rrow := HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 4px;
                    if r.pic >= 0: Middle { Image { source: Emoji.all[r.pic]; width: 16px; height: 16px; } }
                    if r.sticker >= 0: Middle { Image { source: Stickers.all[r.sticker]; width: 20px * r.ratio; height: 20px; image-fit: contain; } }
                    if (r.pic < 0 && r.sticker < 0) || r.count > 1: Text {
                        text: r.pic < 0 && r.sticker < 0 ? (r.count > 1 ? r.label + " " + r.count : r.label) : r.count;
                        font-family: Theme.body-font;
                        font-weight: 700;
                        font-size: 13px;
                        color: r.mine ? Theme.bg : Theme.text;
                        vertical-alignment: center;
                    }
                }
                TouchArea { mouse-cursor: pointer; clicked => { root.react(r.key); } }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            if root.inline-meta: Text {
                text: root.m.text;
                font-family: Theme.body-font;
                font-size: 15px;
                color: Theme.text;
                horizontal-stretch: 1;
            }
            if !root.inline-meta: Rectangle { horizontal-stretch: 1; }
            // On a sticker the time sits on a dark plate (Telegram).
            Rectangle {
                horizontal-stretch: 0;
                width: meta.preferred-width + (root.big ? 14px : 0px);
                height: meta.preferred-height + (root.big ? 4px : 0px);
                border-radius: 10px;
                background: root.big ? #00000099 : transparent;
            meta := HorizontalLayout {
                x: root.big ? 7px : 0px;
                y: root.big ? 2px : 0px;
                spacing: 4px;
                alignment: end;
                if root.m.edited: Text { text: "изменено"; font-family: Theme.body-font; font-size: 13px; color: Theme.mute; vertical-alignment: bottom; }
                Text { text: root.m.time; font-family: Theme.body-font; font-size: 13px; color: root.big ? #ffffffdd : Theme.mute; vertical-alignment: bottom; }
                if root.m.mine: VerticalLayout {
                    alignment: end;
                    padding-bottom: 2px;
                    Icon {
                        size: 16px;
                        icon: root.m.state == 2 ? Icons.alert-circle : (root.m.state == 0 ? Icons.clock : (root.m.read ? Icons.checks : Icons.check));
                        color: root.m.state == 2 ? #E5484D : (root.m.read ? Theme.accent : (root.big ? #ffffffcc : Theme.mute));
                    }
                }
            }
            }
        }
        if root.m.mine && root.m.state == 2: Text { text: "Не отправлено"; font-family: Theme.body-font; font-size: 13px; color: #E5484D; horizontal-alignment: right; }
    }
}

// A friend's musical portrait (Android PortraitUi): week / month / year or a month of the last year, numbers,
// who they listen to most, their favourite tracks, the genre bar. Built on their phone once a day.
component PortraitView inherits Flickable {
    min-width: 0;
    max-width: 100000px;
    min-height: 0;
    max-height: 100000px;
    in property <PortraitData> p;
    in property <string> now-id;
    callback period(int);
    callback play(int);
    callback open-artist(string);
    callback open-album(string);
    callback like-song(string);
    callback song-menu(string, int, length, length);
    content-height: body.preferred-height + Grid.pad;
    body := VerticalLayout {
        width: root.width;
        spacing: Grid.pad;
        alignment: start;
        padding-top: 4px;
        HorizontalLayout {
            padding-left: Grid.pad + 4px;
            spacing: 6px;
            alignment: start;
            for c[i] in root.p.periods: Chip { label: c.label; selected: c.selected; clicked => { root.period(i); } }
        }
        if root.p.months.length > 0: HorizontalLayout {
            padding-left: Grid.pad + 4px;
            spacing: 6px;
            alignment: start;
            for c[i] in root.p.months: Chip { label: c.label; selected: c.selected; clicked => { root.period(100 + i); } }
        }
        if root.p.note != "": Text {
            x: Grid.pad + 4px;
            width: root.width - 2 * (Grid.pad + 4px);
            text: root.p.note;
            wrap: word-wrap;
            font-family: Theme.body-font; font-size: 14px; color: Theme.mute;
        }
        if root.p.tiles.length > 0: HorizontalLayout {
            padding-left: Grid.pad + 4px;
            padding-right: Grid.pad + 4px;
            spacing: Grid.gap;
            for t in root.p.tiles: Rectangle {
                horizontal-stretch: 1;
                height: 84px;
                border-radius: Grid.item-radius;
                background: Theme.fill;
                VerticalLayout {
                    padding: Grid.pad;
                    spacing: 2px;
                    alignment: center;
                    Text { text: t.value; font-family: Theme.heading-font; font-weight: Theme.heading-weight; font-size: 24px; color: Theme.text; overflow: elide; }
                    Text { text: t.label; font-family: Theme.body-font; font-size: 14px; color: Theme.mute; overflow: elide; }
                }
            }
        }
        if root.p.artists.length > 0 || root.p.tracks.length > 0: HorizontalLayout {
            padding-left: Grid.pad + 4px;
            padding-right: Grid.pad;
            spacing: Grid.pad * 2;
            alignment: stretch;
            if root.p.artists.length > 0: VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                alignment: start;
                Text { height: 32px; text: root.p.artists-title; font-family: Theme.heading-font; font-weight: 700; font-size: 18px; color: Theme.text; vertical-alignment: center; }
                for a[i] in root.p.artists: HorizontalLayout {
                    height: 56px;
                    spacing: 12px;
                    Text { width: 18px; text: i + 1; font-family: Theme.body-font; font-size: 14px; color: Theme.dim; vertical-alignment: center; horizontal-alignment: center; }
                    Middle { Cover { size: 44px; radius: 22px; source: a.cover; has-source: a.has-cover; placeholder: Icons.user-circle; } }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: a.name; font-family: Theme.body-font; font-size: 15px; font-weight: 600; color: Theme.text; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                            Text { text: a.info; font-family: Theme.body-font; font-size: 13px; color: Theme.dim; vertical-alignment: center; }
                        }
                        if a.frac >= 0: Rectangle {
                            height: 4px;
                            border-radius: 2px;
                            background: Theme.fill-hover;
                            Rectangle { x: 0; width: parent.width * a.frac; height: 4px; border-radius: 2px; background: Theme.accent; }
                        }
                    }
                }
            }
            if root.p.tracks.length > 0: VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                alignment: start;
                Text { height: 32px; text: root.p.tracks-title; font-family: Theme.heading-font; font-weight: 700; font-size: 18px; color: Theme.text; vertical-alignment: center; }
                for t[i] in root.p.tracks: SongRow {
                    song: t;
                    current: root.now-id != "" && t.id == root.now-id;
                    play => { root.play(i); }
                    open-artist(id) => { root.open-artist(id); }
                    open-album(id) => { root.open-album(id); }
                    like-song(id) => { root.like-song(id); }
                    song-menu(id, idx, x, y) => { root.song-menu(id, idx, x, y); }
                }
            }
        }
        if root.p.genres.length > 0: VerticalLayout {
            padding-left: Grid.pad + 4px;
            padding-right: Grid.pad + 4px;
            spacing: 10px;
            Text { height: 32px; text: "Жанры"; font-family: Theme.heading-font; font-weight: 700; font-size: 18px; color: Theme.text; vertical-alignment: center; }
            Rectangle {
                height: 12px;
                border-radius: 6px;
                clip: true;
                HorizontalLayout {
                    for g in root.p.genres: Rectangle { horizontal-stretch: g.pct; min-width: 0; background: g.color; }
                }
            }
            for row in root.p.legend: HorizontalLayout {
                spacing: 18px;
                alignment: start;
                for g in row.items: HorizontalLayout {
                    spacing: 6px;
                    Middle { Rectangle { width: 10px; height: 10px; border-radius: 3px; background: g.color; } }
                    Text { text: g.name + " " + g.pct + "%"; font-family: Theme.body-font; font-size: 14px; color: Theme.dim; vertical-alignment: center; }
                }
            }
        }
        if root.p.footer != "": Text {
            x: Grid.pad + 4px;
            width: root.width - 2 * (Grid.pad + 4px);
            text: root.p.footer;
            wrap: word-wrap;
            font-family: Theme.body-font; font-size: 13px; color: Theme.mute;
        }
    }
}

// «Слушать вместе» in a room (Android ListenTogetherScreen): create one or join by code / link; inside — the code,
// who is there (the host can hand over or remove), join requests and track suggestions for the host.
component RoomCard inherits Rectangle {
    in property <RoomData> room;
    in-out property <string> join-text;
    callback action(string, string); // create, join, leave, link, resync, approve, reject, kick, host, take, drop
    border-radius: Grid.item-radius;
    background: Theme.fill;
    height: rc-col.preferred-height;
    rc-col := VerticalLayout {
        padding: 14px;
        spacing: 10px;
        if !root.room.active: HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text { text: "Слушать вместе в комнате"; font-family: Theme.heading-font; font-weight: 700; font-size: 16px; color: Theme.text; }
                Text { text: "Комната на общем сервере: хост ставит музыку, остальные слышат то же самое"; font-family: Theme.body-font; font-size: 13px; color: Theme.mute; overflow: elide; }
            }
            Rectangle { horizontal-stretch: 1; }
            Middle { Pill { label: "Создать"; primary: true; clicked => { root.action("create", ""); } } }
            Middle { Rectangle {
                width: 220px;
                height: 34px;
                border-radius: 10px;
                background: Theme.fill-hover;
                border-color: rc-input.has-focus ? Theme.accent : Theme.panel-border;
                border-width: 1px;
                if root.join-text == "": Text {
                    x: 10px;
                    height: parent.height;
                    text: "Код или ссылка";
                    font-family: Theme.body-font; font-size: 14px; color: Theme.mute;
                    vertical-alignment: center;
                }
                rc-input := TextInput {
                    x: 10px;
                    width: parent.width - 20px;
                    height: parent.height;
                    text <=> root.join-text;
                    font-family: Theme.body-font; font-size: 14px; color: Theme.text;
                    vertical-alignment: center;
                    single-line: true;
                    accepted => { root.action("join", self.text); }
                }
            } }
            Middle { Pill { label: "Войти"; clicked => { root.action("join", root.join-text); } } }
        }
        if root.room.active: HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: root.room.code == "" ? "Комната" : "Комната " + root.room.code;
                    font-family: Theme.heading-font; font-weight: 700; font-size: 18px; color: Theme.text;
                }
                Text {
                    text: root.room.status != "" ? root.room.status
                        : root.room.role == "host" ? "ты хост: что играет у тебя, слышат все"
                        : root.room.role == "guest" ? "ты гость: играет то, что у хоста" : "";
                    font-family: Theme.mono-font; font-size: 13px;
                    color: root.room.status != "" ? Theme.mute : Theme.accent;
                    overflow: elide;
                }
            }
            if root.room.code != "": Middle { Pill { label: "Ссылка"; clicked => { root.action("link", ""); } } }
            if root.room.role == "guest": Middle { Pill { label: "Синхронизировать"; clicked => { root.action("resync", ""); } } }
            Middle { Pill { label: root.room.role == "" ? "Отмена" : "Выйти"; clicked => { root.action("leave", ""); } } }
        }
        if root.room.active && root.room.users.length > 0: HorizontalLayout {
            spacing: 8px;
            alignment: start;
            for u in root.room.users: Rectangle {
                height: 32px;
                width: ru-row.preferred-width + 24px;
                border-radius: 16px;
                background: u.host ? Theme.accent : Theme.fill-hover;
                ru-row := HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    Text {
                        text: u.name + (u.me ? " (ты)" : "") + (u.host ? " · хост" : "") + (u.online ? "" : " · нет связи");
                        font-family: Theme.body-font; font-weight: 600; font-size: 13px;
                        color: u.host ? Theme.on-accent : Theme.text;
                        vertical-alignment: center;
                    }
                    if root.room.role == "host" && !u.me: Middle {
                        Rectangle {
                            width: 20px; height: 20px; border-radius: 10px;
                            background: ru-h.has-hover ? Theme.fill : transparent;
                            Icon { icon: Icons.user-circle; size: 13px; color: Theme.dim; }
                            ru-h := TouchArea { mouse-cursor: pointer; clicked => { root.action("host", u.id); } }
                        }
                    }
                    if root.room.role == "host" && !u.me: Middle {
                        Rectangle {
                            width: 20px; height: 20px; border-radius: 10px;
                            background: ru-k.has-hover ? Theme.fill : transparent;
                            Icon { icon: Icons.x; size: 12px; color: Theme.dim; }
                            ru-k := TouchArea { mouse-cursor: pointer; clicked => { root.action("kick", u.id); } }
                        }
                    }
                }
            }
        }
        for r in root.room.requests: HorizontalLayout {
            spacing: 10px;
            Text { horizontal-stretch: 1; text: r.name + " просится в комнату"; font-family: Theme.body-font; font-size: 14px; color: Theme.text; vertical-alignment: center; overflow: elide; }
            Middle { Pill { label: "Впустить"; primary: true; clicked => { root.action("approve", r.id); } } }
            Middle { Pill { label: "Отклонить"; clicked => { root.action("reject", r.id); } } }
        }
        for s in root.room.suggestions: HorizontalLayout {
            spacing: 10px;
            Text { horizontal-stretch: 1; text: s.name + " предлагает: " + s.title; font-family: Theme.body-font; font-size: 14px; color: Theme.text; vertical-alignment: center; overflow: elide; }
            Middle { Pill { label: "Следующим"; primary: true; clicked => { root.action("take", s.id); } } }
            Middle { Pill { label: "Нет"; clicked => { root.action("drop", s.id); } } }
        }
        if root.room.buffering != "": Text {
            text: "Ждём, пока загрузится у: " + root.room.buffering;
            font-family: Theme.body-font; font-size: 13px; color: Theme.mute;
        }
    }
}

// Friends (pc/ FriendsScreen): one's own profile, requests, friends' cards; a friend's page with history,
// likes and playlists. Over Nostr: no server of our own.
component FriendsView inherits Rectangle {
    in property <string> me-name;
    in property <string> me-initial;
    in property <string> me-code;
    in property <image> me-avatar;
    in property <bool> me-has-avatar;
    in property <bool> available; // the profile has a friends key (from the phone's backup)
    in property <[FriendCardItem]> cards;
    in property <[FriendRequestItem]> requests;
    in property <bool> page; // a friend's page is open
    in property <string> f-name;
    in property <string> f-initial;
    in property <string> f-status;
    in property <image> f-avatar;
    callback view-avatar();
    in property <bool> f-has-avatar;
    in property <string> f-tab; // chat | portrait | history | likes | playlists
    in property <PortraitData> f-portrait;
    in property <RoomData> room;
    in-out property <string> room-join-text;
    callback room-action(string, string);
    in property <[GenreItem]> f-tags; // their three main genres, under the name
    callback portrait-period(int);
    in property <[ChatItem]> f-chat;
    in-out property <string> chat-text;
    in property <bool> chat-editing;
    in property <bool> f-can-along; // the friend plays something and lets others listen along
    in property <bool> f-along; // this app follows them now
    in property <bool> f-typing; // they are typing to me
    callback chat-send(string);
    in property <string> chat-replying; // the message being answered (its text), empty when none
    callback chat-cancel-reply();
    callback chat-typing(); // the field changed: the friend sees «печатает…»
    in property <[StickerPic]> sticker-list; // every sticker Mini draws (for the panel)
    in-out property <bool> stickers-open;
    callback chat-sticker(int); // a sticker picked in the panel: it goes as a message
    callback chat-play(int);
    callback chat-react(int, string);
    callback chat-menu(int, length, length);
    callback chat-cancel-edit();
    callback chat-act(int, string); // Telegram keys: «reply» (double click), «escape», «edit-last» (↑); selection
    in property <int> chat-selected; // how many messages are picked
    callback chat-link(string);
    in-out property <int> chat-jump: -1; // the first look at a chat: show this row (the unread line) at the top
    property <bool> chat-stick: true; // the view follows the end of the conversation
    property <int> chat-unseen: 0; // messages that came while scrolled up (the badge on the down button)
    property <int> chat-focus: -1; // a quote was clicked: go to this row
    property <int> chat-flash: -1; // the row just jumped to, lit for a moment
    property <int> chat-count: root.f-chat.length;
    changed chat-count => { if !root.chat-stick { root.chat-unseen += 1; } }
    flash-timer := Timer { interval: 1200ms; running: false; triggered => { root.chat-flash = -1; self.running = false; } }
    callback along();
    callback remove();
    in property <string> f-likes;
    in property <[SongItem]> f-tracks;
    in property <string> f-empty;
    in property <string> now-id;
    callback copy-code();
    callback copy-link();
    callback add(string);
    in-out property <string> add-text;
    // «Найти по нику»: profiles found by name (the field held a name, not a code).
    in property <[FriendRequestItem]> found;
    in property <string> found-status;
    callback add-found(string, string);
    callback clear-found();
    callback open(string);
    callback play-now(string);
    callback back();
    callback set-tab(string);
    callback play(int);
    callback accept(string);
    callback dismiss(string);
    callback open-artist(string);
    callback open-album(string);
    callback like-song(string);
    callback song-menu(string, int, length, length);
    if !root.available: VerticalLayout {
        padding: Grid.pad + 4px;
        spacing: 8px;
        alignment: start;
        Text { text: "Друзья"; font-family: Theme.heading-font; font-weight: Theme.heading-weight; font-size: 28px; color: Theme.text; }
        Text {
            text: "Кто что слушает, история и любимые друзей — через Nostr, без своего сервера. Профиль приходит с телефона: импортируйте резервную копию.";
            font-family: Theme.body-font; font-size: 14px; color: Theme.dim; wrap: word-wrap;
        }
    }
    if root.available && !root.page: Flickable {
        content-height: home.preferred-height;
        home := VerticalLayout {
            padding: Grid.pad + 4px;
            padding-right: Grid.pad;
            spacing: 14px;
            alignment: start;
            HorizontalLayout {
                spacing: 18px;
                Middle { Avatar { size: 72px; source: root.me-avatar; has-source: root.me-has-avatar; initial: root.me-initial; } }
                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    horizontal-stretch: 1;
                    Text { text: root.me-name == "" ? "Мой профиль" : root.me-name; font-family: Theme.heading-font; font-weight: Theme.heading-weight; font-size: 28px; color: Theme.text; overflow: elide; }
                    Text { text: root.me-code; font-family: Theme.mono-font; font-size: 13px; color: Theme.mute; }
                    Text { text: "Профиль с телефона: имя, аватар и любимые ведёт телефон, отсюда друзья видят, что играет на ПК"; font-family: Theme.body-font; font-size: 12px; color: Theme.mute; wrap: word-wrap; }
                }
                Middle { Pill { label: "Мой код"; clicked => { root.copy-code(); } } }
                Middle { Pill { label: "Ссылка"; clicked => { root.copy-link(); } } }
            }
            // Add a friend: their code (npub…) or an invite link.
            HorizontalLayout {
                spacing: 10px;
                Rectangle {
                    height: 38px;
                    horizontal-stretch: 1;
                    border-radius: 10px;
                    background: Theme.fill;
                    border-color: add-input.has-focus ? Theme.accent : Theme.panel-border;
                    border-width: 1px;
                    if root.add-text == "": Text {
                        x: 12px;
                        height: parent.height;
                        text: "Код друга (npub…) или ссылка-приглашение";
                        font-family: Theme.body-font;
                        font-size: 14px;
                        color: Theme.mute;
                        vertical-alignment: center;
                    }
                    add-input := TextInput {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        text <=> root.add-text;
                        font-family: Theme.body-font;
                        font-size: 14px;
                        color: Theme.text;
                        vertical-alignment: center;
                        single-line: true;
                        accepted => { root.add(self.text); }
                    }
                }
                Middle { Pill { label: "Добавить"; primary: true; clicked => { root.add(root.add-text); } } }
            }
            if root.found-status != "": HorizontalLayout {
                spacing: 10px;
                Text { horizontal-stretch: 1; text: root.found-status; font-family: Theme.heading-font; font-weight: 700; font-size: 16px; color: Theme.text; vertical-alignment: center; }
                Middle { IconButton { icon: Icons.x; size: 28px; icon-size: 14px; clicked => { root.clear-found(); } } }
            }
            for r in root.found: HorizontalLayout {
                spacing: 12px;
                Middle { Avatar { size: 40px; initial: r.initial; } }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text { text: r.name; font-family: Theme.body-font; font-weight: 700; font-size: 15px; color: Theme.text; overflow: elide; }
                    Text { text: r.when; font-family: Theme.mono-font; font-size: 12px; color: Theme.mute; }
                }
                Middle { Pill { label: "Добавить"; primary: true; clicked => { root.add-found(r.pubkey, r.name); } } }
            }
            RoomCard {
                room: root.room;
                join-text <=> root.room-join-text;
                action(a, x) => { root.room-action(a, x); }
            }
            if root.requests.length > 0: Text { text: "Заявки · " + root.requests.length; font-family: Theme.heading-font; font-weight: 700; font-size: 16px; color: Theme.text; }
            for r in root.requests: HorizontalLayout {
                spacing: 12px;
                Middle { Avatar { size: 40px; initial: r.initial; } }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text { text: r.name == "" ? "Без имени" : r.name; font-family: Theme.body-font; font-weight: 700; font-size: 15px; color: Theme.text; }
                    Text { text: "хочет дружить · " + r.when; font-family: Theme.mono-font; font-size: 12px; color: Theme.mute; }
                }
                Middle { Pill { label: "Принять"; primary: true; clicked => { root.accept(r.pubkey); } } }
                Middle { Pill { label: "Скрыть"; clicked => { root.dismiss(r.pubkey); } } }
            }
            Text { text: root.cards.length == 0 ? "Друзья · пока никого" : "Друзья · " + root.cards.length; font-family: Theme.heading-font; font-weight: 700; font-size: 16px; color: Theme.text; }
            // One row per friend: who and how long ago on the left, what plays on the right (press it to play).
            VerticalLayout {
                spacing: 6px;
                for c in root.cards: Rectangle {
                    height: 64px;
                    border-radius: 14px;
                    background: ca.has-hover ? Theme.fill-hover : Theme.fill;
                    border-color: c.live ? Theme.accent.mix(Theme.bg, 0.45) : Theme.panel-border;
                    border-width: 1px;
                    ca := TouchArea { mouse-cursor: pointer; clicked => { root.open(c.pubkey); } }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 8px;
                        spacing: 12px;
                        Middle {
                            Rectangle {
                                width: 42px;
                                height: 42px;
                                Avatar { size: 42px; source: c.avatar; has-source: c.has-avatar; initial: c.initial; }
                                if c.live: Rectangle {
                                    x: 30px; y: 30px; width: 12px; height: 12px; border-radius: 6px; background: Theme.bg;
                                    Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #3DD68C; }
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            width: max(160px, min(260px, root.width * 0.3));
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: c.name; font-family: Theme.body-font; font-weight: 800; font-size: 16px; color: Theme.text; overflow: elide; }
                                if c.unread > 0: Middle {
                                    Rectangle {
                                        height: 20px;
                                        width: max(20px, ub.preferred-width + 12px);
                                        border-radius: 10px;
                                        background: Theme.accent;
                                        ub := Text { text: c.unread > 99 ? "99+" : c.unread; font-family: Theme.body-font; font-weight: 700; font-size: 12px; color: Theme.on-accent; }
                                    }
                                }
                                if c.developer: Text { text: "разработчик"; font-family: Theme.mono-font; font-size: 11px; color: Theme.accent; vertical-alignment: center; horizontal-stretch: 0; }
                            }
                            Text { text: c.status; font-family: Theme.mono-font; font-size: 12px; color: c.live ? Theme.accent : Theme.mute; overflow: elide; }
                        }
                        // The chat's last message between the person and what they play.
                        Text {
                            horizontal-stretch: 1;
                            text: c.preview;
                            font-family: Theme.body-font;
                            font-weight: c.unread > 0 ? 600 : 500;
                            font-size: 14px;
                            color: c.unread > 0 ? Theme.text : Theme.dim;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        if c.has-track: Rectangle {
                            width: min(380px, max(200px, root.width * 0.4));
                            border-radius: 10px;
                            background: ta.has-hover ? Theme.panel-border : transparent;
                            ta := TouchArea { mouse-cursor: pointer; clicked => { root.play-now(c.pubkey); } }
                            HorizontalLayout {
                                padding: 4px;
                                padding-right: 10px;
                                spacing: 10px;
                                Middle {
                                    Rectangle {
                                        width: 44px;
                                        height: 44px;
                                        Cover { size: 44px; source: c.cover; has-source: c.has-cover; radius: Grid.row-cover-radius; }
                                        if ta.has-hover: Rectangle {
                                            border-radius: Grid.row-cover-radius;
                                            background: #00000088;
                                            Icon { icon: Icons.play; size: 18px; color: white; }
                                        }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    horizontal-stretch: 1;
                                    Text { text: c.track-title; font-family: Theme.body-font; font-weight: 700; font-size: 14px; color: Theme.text; overflow: elide; }
                                    Text { text: c.track-artist; font-family: Theme.body-font; font-size: 14px; color: Theme.dim; overflow: elide; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if root.available && root.page: VerticalLayout {
        padding-top: Grid.pad;
        spacing: 12px;
        HorizontalLayout {
            padding-left: Grid.pad + 4px;
            padding-right: Grid.pad;
            spacing: 16px;
            Middle { IconButton { icon: Icons.chevron-left; filled: true; clicked => { root.back(); } } }
            Middle { Avatar { size: 84px; source: root.f-avatar; has-source: root.f-has-avatar; initial: root.f-initial; zoomable: true; zoom => { root.view-avatar(); } } }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                horizontal-stretch: 1;
                Text { text: root.f-name; font-family: Theme.heading-font; font-weight: Theme.heading-weight; font-size: 28px; color: Theme.text; overflow: elide; }
                Text { text: root.f-status; font-family: Theme.mono-font; font-size: 13px; color: root.f-along || root.f-typing ? Theme.accent : Theme.mute; overflow: elide; }
                // Three main genres of the last months, like roles in Discord.
                if root.f-tags.length > 0: HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    padding-top: 2px;
                    for g in root.f-tags: Rectangle {
                        height: 24px;
                        width: tg-row.preferred-width + 20px;
                        border-radius: 12px;
                        background: g.bg;
                        tg-row := HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            Middle { Rectangle { width: 7px; height: 7px; border-radius: 3.5px; background: g.dot; } }
                            Text { text: g.name; font-family: Theme.body-font; font-weight: 600; font-size: 13px; color: g.color; vertical-alignment: center; }
                        }
                    }
                }
            }
            if root.f-along || root.f-can-along: Middle {
                Pill { label: root.f-along ? "Перестать слушать" : "Слушать вместе"; primary: !root.f-along; clicked => { root.along(); } }
            }
            Middle { IconButton { icon: Icons.trash; filled: true; clicked => { root.remove(); } } }
        }
        HorizontalLayout {
            padding-left: Grid.pad + 4px;
            spacing: 8px;
            alignment: start;
            Chip { label: "Чат"; selected: root.f-tab == "chat"; clicked => { root.set-tab("chat"); } }
            Chip { label: "Портрет"; selected: root.f-tab == "portrait"; clicked => { root.set-tab("portrait"); } }
            Chip { label: "История"; selected: root.f-tab == "history"; clicked => { root.set-tab("history"); } }
            Chip { label: root.f-likes == "" ? "Любимые" : "Любимые · " + root.f-likes; selected: root.f-tab == "likes"; clicked => { root.set-tab("likes"); } }
            Chip { label: "Плейлисты"; selected: root.f-tab == "playlists"; clicked => { root.set-tab("playlists"); } }
        }
        if root.f-tab == "chat": Rectangle {
            vertical-stretch: 1;
            // Its content would cap it (an empty chat is a few pixels tall): the page gives it all the room left.
            min-height: 120px;
            max-height: 100000px;
            chat := Flickable {
                width: 100%;
                height: 100%;
                content-height: max(self.height, msgs.preferred-height);
                property <length> bottom-y: min(0px, self.height - self.content-height);
                // At the end: new messages keep it there (Telegram); scrolled up, they only count on the down button.
                changed content-height => { if root.chat-stick && root.chat-jump < 0 { self.content-y = self.bottom-y; } }
                changed height => { if root.chat-stick { self.content-y = self.bottom-y; } }
                changed content-y => {
                    root.chat-stick = self.content-y <= self.bottom-y + 60px;
                    if root.chat-stick { root.chat-unseen = 0; }
                }
                property <bool> go-end: root.chat-stick;
                changed go-end => { if self.go-end { self.content-y = self.bottom-y; } }
                msgs := VerticalLayout {
                    y: max(0px, chat.height - self.preferred-height);
                    width: chat.width;
                    padding-top: 6px;
                    padding-bottom: 10px;
                    spacing: 0px;
                    for m[i] in root.f-chat: row := VerticalLayout {
                        padding-top: m.first ? 8px : 2px;
                        spacing: 0px;
                        // Go to this row: the unread line on the first look, or a clicked quote.
                        property <bool> wanted: root.chat-jump == i || root.chat-focus == i;
                        function show() {
                            chat.content-y = max(chat.bottom-y, min(0px, -(msgs.y + self.y) + (root.chat-focus == i ? chat.height / 3 : 8px)));
                            if root.chat-focus == i { root.chat-flash = i; flash-timer.running = true; }
                            root.chat-jump = -1;
                            root.chat-focus = -1;
                        }
                        init => { if self.wanted { self.show(); } }
                        changed wanted => { if self.wanted { self.show(); } }
                        // The date badge (Telegram's service date): centred, on the day's first message.
                        if m.day != "": HorizontalLayout {
                            alignment: center;
                            padding-top: 8px;
                            padding-bottom: 6px;
                            Rectangle {
                                height: 26px;
                                width: dt.preferred-width + 24px;
                                border-radius: 13px;
                                background: Theme.menu;
                                dt := Text { text: m.day; font-family: Theme.body-font; font-weight: 700; font-size: 13px; color: Theme.dim; }
                            }
                        }
                        if m.unread-bar: Rectangle {
                            height: 32px;
                            background: Theme.fill;
                            Text { text: "Непрочитанные сообщения"; font-family: Theme.body-font; font-weight: 700; font-size: 13px; color: Theme.dim; }
                        }
                        if m.unread-bar: Rectangle { height: 8px; }
                        Rectangle {
                            height: b.height + (root.chat-selected > 0 ? 4px : 0px);
                            background: m.selected ? Theme.accent.transparentize(0.82) : transparent;
                            // Picking mode: a click anywhere on the row picks it; a circle shows the choice.
                            if root.chat-selected > 0: TouchArea { clicked => { root.chat-act(i, "select"); } }
                            if root.chat-selected > 0: Rectangle {
                                x: 10px;
                                y: (parent.height - 20px) / 2;
                                width: 20px;
                                height: 20px;
                                border-radius: 10px;
                                background: m.selected ? Theme.accent : transparent;
                                border-color: m.selected ? Theme.accent : Theme.dim;
                                border-width: 2px;
                                if m.selected: Icon { icon: Icons.check; size: 14px; color: Theme.bg; }
                            }
                            b := ChatBubble {
                                y: root.chat-selected > 0 ? 2px : 0px;
                                m: m;
                                selecting: root.chat-selected > 0;
                                pick => { root.chat-act(i, "select"); }
                                link(u) => { root.chat-link(u); }
                                flash: root.chat-flash == i;
                                max-w: min(430px, (chat.width - 2 * Grid.pad) * 0.8);
                                x: m.mine ? parent.width - self.width - Grid.pad - 9px : Grid.pad + 13px + (root.chat-selected > 0 ? 26px : 0px);
                                play => { root.chat-play(i); }
                                react(k) => { root.chat-react(i, k); }
                                menu(x, y) => { root.chat-menu(i, x, y); }
                                reply => { root.chat-act(i, "reply"); }
                                quote => { if m.reply-index >= 0 { root.chat-focus = m.reply-index; } }
                            }
                        }
                    }
                }
                if root.f-chat.length == 0: VerticalLayout {
                    width: chat.width;
                    height: chat.height;
                    alignment: center;
                    spacing: 6px;
                    HorizontalLayout { alignment: center; Icon { icon: Icons.message; size: 32px; color: Theme.dim; } }
                    Text { text: "В чате пока тихо"; horizontal-alignment: center; font-family: Theme.body-font; font-weight: 700; font-size: 16px; color: Theme.text; }
                    Text { text: "Напиши " + root.f-name + " первое сообщение!"; horizontal-alignment: center; font-family: Theme.mono-font; font-size: 13px; color: Theme.mute; }
                }
            }
            // Telegram's «down» button: appears when scrolled up, counts what came meanwhile, goes to the end.
            if !root.chat-stick: Rectangle {
                x: parent.width - self.width - Grid.pad - 4px;
                y: parent.height - self.height - 10px;
                width: 44px;
                height: 44px;
                border-radius: 22px;
                background: dna.has-hover ? Theme.fill-hover : Theme.menu;
                drop-shadow-blur: 10px;
                drop-shadow-color: #00000060;
                Icon { icon: Icons.chevron-down; size: 22px; color: Theme.text; }
                if root.chat-unseen > 0: Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: -10px;
                    height: 20px;
                    width: max(20px, uc.preferred-width + 10px);
                    border-radius: 10px;
                    background: Theme.accent;
                    uc := Text { text: root.chat-unseen; font-family: Theme.body-font; font-weight: 700; font-size: 12px; color: Theme.bg; }
                }
                dna := TouchArea { mouse-cursor: pointer; clicked => { root.chat-stick = true; root.chat-unseen = 0; } }
            }
        }
        if root.f-tab == "chat" && root.chat-replying != "": HorizontalLayout {
            padding-left: Grid.pad + 8px;
            padding-right: Grid.pad;
            spacing: 8px;
            Rectangle { width: 3px; border-radius: 1.5px; background: Theme.accent; }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 1px;
                Text { text: "Ответ"; font-family: Theme.body-font; font-weight: 700; font-size: 13px; color: Theme.accent; }
                Text { text: root.chat-replying; font-family: Theme.body-font; font-size: 13px; color: Theme.dim; overflow: elide; }
            }
            Middle { IconButton { icon: Icons.x; size: 24px; icon-size: 13px; clicked => { root.chat-cancel-reply(); } } }
        }
        if root.f-tab == "chat" && root.chat-editing: HorizontalLayout {
            padding-left: Grid.pad + 8px;
            padding-right: Grid.pad;
            spacing: 8px;
            Middle { Icon { icon: Icons.pencil; size: 14px; color: Theme.accent; } }
            Text { text: "Изменение сообщения"; font-family: Theme.body-font; font-weight: 700; font-size: 14px; color: Theme.accent; vertical-alignment: center; horizontal-stretch: 1; }
            Middle { IconButton { icon: Icons.x; size: 24px; icon-size: 13px; clicked => { root.chat-cancel-edit(); } } }
        }
        // Telegram's selection bar in place of the field: how many, forward, copy, delete, cancel.
        if root.f-tab == "chat" && root.chat-selected > 0: HorizontalLayout {
            padding-left: Grid.pad + 4px;
            padding-right: Grid.pad;
            padding-bottom: Grid.pad;
            Rectangle {
                height: 46px;
                border-radius: 12px;
                background: Theme.fill;
                border-color: Theme.panel-border;
                border-width: 1px;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 8px;
                    spacing: 8px;
                    Text {
                        text: "Выбрано: " + root.chat-selected;
                        font-family: Theme.body-font; font-weight: 700; font-size: 15px; color: Theme.text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Middle { Pill { label: "Переслать"; primary: true; clicked => { root.chat-act(-1, "select-forward"); } } }
                    Middle { Pill { label: "Копировать"; clicked => { root.chat-act(-1, "select-copy"); } } }
                    Middle { Pill { label: "Удалить у меня"; clicked => { root.chat-act(-1, "select-delete"); } } }
                    Middle { IconButton { icon: Icons.x; size: 32px; icon-size: 16px; clicked => { root.chat-act(-1, "select-cancel"); } } }
                }
            }
        }
        if root.f-tab == "chat" && root.chat-selected == 0: HorizontalLayout {
            padding-left: Grid.pad + 4px;
            padding-right: Grid.pad;
            padding-bottom: Grid.pad;
            Rectangle {
                // Grows with the text up to about six lines (Telegram), then scrolls inside.
                height: clamp(chat-input.preferred-height + 26px, 46px, 168px);
                border-radius: 12px;
                background: Theme.fill;
                border-color: chat-input.has-focus ? Theme.accent : Theme.panel-border;
                border-width: 1px;
                if root.chat-text == "": Text {
                    x: 16px;
                    y: 13px;
                    text: "Написать сообщение…";
                    font-family: Theme.body-font;
                    font-size: 15px;
                    color: Theme.mute;
                }
                // Telegram's keys: Enter sends, Shift+Enter breaks the line, Esc drops the answer or the change,
                // ↑ in an empty field changes the last own message.
                keys := FocusScope {
                    x: 16px;
                    y: 12px;
                    width: parent.width - 16px - 82px;
                    height: parent.height - 24px;
                    capture-key-pressed(e) => {
                        if e.text == Key.Return && !e.modifiers.shift && !e.modifiers.control {
                            if root.chat-text != "" { root.chat-stick = true; root.chat-send(root.chat-text); }
                            return EventResult.accept;
                        }
                        if e.text == Key.Escape {
                            root.stickers-open = false;
                            root.chat-act(-1, "escape");
                            return EventResult.accept;
                        }
                        if e.text == Key.UpArrow && root.chat-text == "" {
                            root.chat-act(-1, "edit-last");
                            return EventResult.accept;
                        }
                        return EventResult.reject;
                    }
                    chat-input := TextInput {
                        width: parent.width;
                        text <=> root.chat-text;
                        font-family: Theme.body-font;
                        font-size: 15px;
                        color: Theme.text;
                        single-line: false;
                        wrap: word-wrap;
                        edited => { if self.text != "" { root.chat-typing(); } }
                    }
                }
                // Stickers (Telegram: the smile in the field opens the panel above it).
                IconButton {
                    x: parent.width - self.width - 41px;
                    y: parent.height - self.height - 7px;
                    size: 32px;
                    icon-size: 20px;
                    icon: Icons.mood-smile;
                    active: root.stickers-open;
                    active-color: Theme.accent;
                    clicked => { root.stickers-open = !root.stickers-open; }
                }
                IconButton {
                    x: parent.width - self.width - 7px;
                    y: parent.height - self.height - 7px;
                    size: 32px;
                    icon-size: 18px;
                    icon: Icons.send;
                    tint: root.chat-text == "" ? Theme.mute : Theme.accent;
                    enabled: root.chat-text != "";
                    clicked => { root.chat-stick = true; root.chat-send(root.chat-text); }
                }
            }
        }
        if root.f-tab == "portrait": PortraitView {
            vertical-stretch: 1;
            p: root.f-portrait;
            now-id: root.now-id;
            period(i) => { root.portrait-period(i); }
            play(i) => { root.play(i); }
            open-artist(id) => { root.open-artist(id); }
            open-album(id) => { root.open-album(id); }
            like-song(id) => { root.like-song(id); }
            song-menu(id, idx, x, y) => { root.song-menu(id, idx, x, y); }
        }
        if root.f-tab != "chat" && root.f-tab != "portrait" && root.f-tracks.length == 0: Text {
            x: Grid.pad + 4px;
            text: root.f-empty;
            font-family: Theme.body-font;
            font-size: 14px;
            color: Theme.dim;
        }
        if root.f-tab != "chat" && root.f-tab != "portrait": HorizontalLayout {
            vertical-stretch: 1;
            padding-left: 8px;
            padding-right: 4px;
            ListView {
                for song[i] in root.f-tracks: SongRow {
                    song: song;
                    current: root.now-id != "" && song.id == root.now-id;
                    play => { root.play(i); }
                    open-artist(id) => { root.open-artist(id); }
                    open-album(id) => { root.open-album(id); }
                    like-song(id) => { root.like-song(id); }
                    song-menu(id, idx, x, y) => { root.song-menu(id, idx, x, y); }
                }
            }
        }
    }
    // Sticker panel (Telegram's): a grid over the chat, right above the message field; a sticker click sends it.
    if root.available && root.page && root.f-tab == "chat" && root.stickers-open: Rectangle {
        property <int> cols: 4;
        property <length> cell: 80px;
        width: self.cols * self.cell + 2 * 10px + 8px;
        height: min(380px, root.height - 200px);
        x: root.width - self.width - Grid.pad;
        y: root.height - self.height - Grid.pad - 46px - 8px;
        border-radius: Grid.item-radius;
        background: Theme.menu;
        border-color: Theme.panel-border;
        border-width: 1px;
        drop-shadow-blur: 18px;
        drop-shadow-color: #00000070;
        TouchArea { } // the chat under it gets no clicks through the panel
        VerticalLayout {
            padding: 10px;
            spacing: 6px;
            HorizontalLayout {
                height: 24px;
                Text { text: "Стикеры"; font-family: Theme.body-font; font-weight: 700; font-size: 14px; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                Middle { IconButton { icon: Icons.x; size: 24px; icon-size: 13px; clicked => { root.stickers-open = false; } } }
            }
            Flickable {
                vertical-stretch: 1;
                content-height: ceil(root.sticker-list.length / 4) * 80px;
                for st[si] in root.sticker-list: Rectangle {
                    x: mod(si, 4) * 80px;
                    y: floor(si / 4) * 80px;
                    width: 76px;
                    height: 76px;
                    border-radius: 10px;
                    background: sta.has-hover ? Theme.fill-hover : transparent;
                    Image {
                        source: Stickers.all[st.pic];
                        width: st.ratio >= 1 ? 64px : 64px * st.ratio;
                        height: st.ratio >= 1 ? 64px / st.ratio : 64px;
                        image-fit: contain;
                    }
                    sta := TouchArea { mouse-cursor: pointer; clicked => { root.chat-sticker(st.pic); } }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Drxwnify Mini";
    icon: @image-url("../../../assets/icons/mini/d.png");
    min-width: 1080px;
    min-height: 640px;
    preferred-width: 1440px;
    preferred-height: 900px;
    background: Theme.bg;
    default-font-family: Theme.body-font;
    default-font-size: 14px; // texts without their own size (owner: 1920x1080 must read easily)
    default-font-weight: 500; // Medium unless a text says otherwise: Regular looked thin next to Spotify
    // No system title bar: the top bar is the title bar (drag, double press, window buttons); edges still resize.
    no-frame: true;
    resize-border-width: root.window-maximized ? 0 : 6px;
    in property <bool> window-maximized;
    // A maximised frameless window reaches past the screen edges by its (invisible) resize border: the content keeps
    // clear of that part (set from Rust, 0 otherwise).
    in property <length> window-inset;
    callback window-press();
    callback window-drag();
    callback window-minimize();
    callback window-maximize();
    callback window-close();

    in property <[LibItem]> library;
    in property <string> lib-filter;
    in property <string> lib-sort: "added";
    in property <bool> lib-descending: true;
    callback lib-set-filter(string);
    callback lib-set-sort(string);
    callback lib-set-descending(bool);
    callback lib-query(string);
    in-out property <string> selected-id: "liked";
    in property <string> view-title: "Любимые треки";
    in property <string> view-subtitle;
    in property <[SongItem]> songs;
    in property <int> current-index: -1;
    in-out property <string> now-id;
    in property <bool> empty-library;
    in property <string> now-title;
    in property <string> now-artists;
    in property <string> now-info;
    in property <string> now-artist-id;
    in property <string> now-album-id;
    in property <bool> can-back;
    in property <bool> can-forward;
    in property <bool> view-is-page;
    in property <image> view-cover;
    in-out property <string> view-cover-url;
    in property <bool> has-view-cover;
    in property <[ReleaseItem]> view-releases;
    in property <bool> view-home;
    in property <bool> view-search;
    in property <bool> view-artist;
    in property <bool> view-history;
    in property <bool> view-yt;
    in property <[HistoryItem]> history-items;
    in property <bool> view-stats;
    in property <[SourceChip]> stats-periods;
    in property <[StatTile]> stats-tiles;
    in property <[SongItem]> stats-tracks;
    in property <int> stats-total;
    in property <bool> stats-expanded;
    in property <[HomeCard]> stats-artists;
    in property <[HomeCard]> stats-albums;
    in property <string> stats-note;
    callback open-history();
    callback open-stats();
    callback history-play(int);
    callback history-remove(int);
    callback stats-period(int);
    callback stats-play(int);
    callback stats-more();
    in property <[SongItem]> artist-tracks;
    in property <int> artist-total;
    in property <bool> artist-expanded;
    in property <[HomeCard]> artist-albums;
    in property <[HomeCard]> artist-singles;
    in property <[HomeCard]> artist-appears;
    in property <[HomeCard]> artist-related;
    callback artist-more();
    in property <[SourceChip]> search-chips;
    in property <string> search-state;
    in property <string> search-top-kind;
    in property <string> search-top-title;
    in property <string> search-top-sub;
    in property <image> search-top-cover;
    in-out property <string> search-top-cover-url;
    in property <bool> search-top-has-cover;
    in property <[SongItem]> search-tracks;
    in property <int> search-tracks-total;
    in property <bool> search-expanded;
    in property <[HomeCard]> search-artists;
    in property <[HomeCard]> search-albums;
    in property <[HomeCard]> search-playlists;
    callback search-source(int);
    callback search-play(int);
    callback search-top();
    callback search-more();
    callback search-artist(int);
    callback search-album(int);
    callback search-playlist(int);
    in property <string> view-kind;
    in property <bool> view-liked-cover;
    in property <bool> view-can-play;
    in property <bool> now-shuffle;
    in property <int> now-repeat; // 0 off, 1 one, 2 all
    callback play-all();
    callback shuffle-all();
    callback toggle-shuffle();
    callback cycle-repeat();
    in property <bool> view-settings;
    in property <[AccountRow]> settings-accounts;
    in property <[ThemeChip]> settings-themes;
    in property <bool> day-theme;
    in property <bool> global-hotkeys;
    in property <[HotkeyRow]> hotkey-rows;
    in-out property <int> hotkey-recording: -1;
    in property <bool> autostart;
    in property <[FlagItem]> settings-flags;
    callback set-settings-flag(string, bool);
    in property <[HomeSection]> home-sections;
    in property <[QueueItem]> upcoming;
    in property <string> lyric-now;
    in property <string> lyric-next;
    in property <bool> has-lyrics;
    in property <image> now-cover;
    in property <image> now-cover-small; // the player bar's: smaller corners
    in-out property <string> now-cover-url;
    in-out property <bool> has-now-cover;
    in-out property <bool> playing;
    in property <float> progress;
    in property <string> position: "0:00";
    in property <string> duration: "0:00";
    in property <float> duration-s; // the same in seconds (the seek bar's hover time)
    in-out property <string> toast;
    // The side columns were dragged to new widths (Grid.lib-width / side-width): the app keeps them.
    callback panels-resized();
    // A new toast: the app clears it after a few seconds.
    callback toast-shown(string);
    changed toast => { if root.toast != "" { root.toast-shown(root.toast); } }
    in-out property <string> search-text;
    in-out property <bool> suggest-open;
    in property <[Suggestion]> suggestions;
    in property <bool> suggest-history-only; // the field is empty: the history alone, with «Очистить»
    callback search-typing(string);
    callback forget-search(string);
    callback clear-search-history();

    callback open-library(LibItem);
    callback home-play(int, int);
    callback home-random();
    callback open-settings();
    callback set-main-account(string);
    callback set-account-tab(string, bool);
    callback set-theme(string);
    callback set-day(bool);
    in property <bool> sleep-on;
    in property <string> sleep-label;
    in-out property <bool> sleep-fade;
    in-out property <bool> sleep-after;
    callback sleep-set(int);
    callback sleep-option(string);
    in-out property <bool> queue-open;
    in-out property <bool> lyrics-open;
    in property <[LyricLine]> lyrics-lines;
    in property <int> lyrics-current: -1;
    in property <bool> lyrics-synced;
    in property <string> lyrics-status;
    callback lyrics-toggled();
    callback lyrics-seek(int);
    in property <SongItem> queue-now;
    in property <bool> queue-has-now;
    in property <[SongItem]> queue-items;
    in property <int> queue-more;
    callback queue-toggled();
    callback queue-play(int);
    callback queue-remove(int);
    callback queue-move(int, int);
    callback queue-clear();
    callback set-hotkeys(bool);
    callback hotkey-start(int);
    callback hotkey-captured(int, string, bool, bool, bool);
    callback hotkey-cancel();
    callback hotkey-reset(int);
    callback hotkey-off(int);
    callback set-autostart(bool);
    callback open-artist(string);
    callback like-song(string);
    callback song-menu(string, int, length, length);
    callback open-album(string);
    // The playing track's heart.
    in property <bool> now-liked;
    in property <bool> now-can-like;
    callback toggle-now-like();
    // The track menu (right click on a row): what it is for and where it opened.
    in-out property <string> menu-id;
    in-out property <length> menu-x;
    in-out property <length> menu-y;
    in property <bool> menu-liked;
    in property <bool> menu-has-artist;
    in property <bool> menu-has-album;
    in-out property <int> menu-index; // the row's place in its list (own playlists: move / take out)
    in property <bool> menu-in-playlist;
    in property <bool> menu-can-up;
    in property <bool> menu-can-down;
    callback menu-opening(string, int);
    callback track-menu-action(string, string); // action, track id
    callback create-playlist();
    callback window-key(string, bool, bool, bool) -> bool;
    // Friends.
    in property <bool> view-friends;
    in property <bool> friends-available;
    in property <string> friends-me-name;
    in property <string> friends-me-initial;
    in property <string> friend-initial;
    in property <string> friends-me-code;
    in property <image> friends-me-avatar;
    in property <bool> friends-me-has-avatar;
    in property <[FriendCardItem]> friends-cards;
    in property <[FriendRequestItem]> friends-requests;
    in property <bool> friend-page;
    in property <string> friend-name;
    in property <string> friend-status;
    in property <image> friend-avatar;
    in property <bool> friend-has-avatar;
    in property <string> friend-tab: "chat";
    in property <[ChatItem]> friend-chat;
    in-out property <string> friend-chat-text;
    in property <bool> friend-chat-editing;
    in-out property <int> friend-chat-jump: -1;
    in property <int> friend-chat-selected;
    callback friend-chat-link(string);
    in property <bool> friend-can-along;
    in property <bool> friend-along;
    in property <bool> friend-typing;
    callback friend-chat-send(string);
    in property <string> friend-chat-replying;
    callback friend-chat-typing();
    in property <[StickerPic]> sticker-list;
    in-out property <bool> friend-stickers-open;
    callback friend-chat-sticker(int);
    callback friend-chat-play(int);
    callback friend-chat-action(int, string); // «r:<key>» react, «edit», «del», «del-both», «cancel-edit»
    callback friend-toggle-along();
    callback friend-remove();
    in-out property <int> chat-menu-index;
    in-out property <length> chat-menu-x;
    in-out property <length> chat-menu-y;
    in-out property <bool> chat-menu-mine;
    in-out property <bool> chat-menu-failed;
    in property <string> friend-likes;
    in property <PortraitData> friend-portrait;
    in property <RoomData> room;
    in-out property <string> room-join-text;
    callback room-action(string, string);
    in property <bool> room-guest; // a guest can suggest tracks (the track menu)
    in property <[GenreItem]> friend-tags;
    callback friend-portrait-period(int);
    in property <[SongItem]> friend-tracks;
    in property <string> friend-empty;
    callback open-friends();
    callback friends-copy(string);
    callback friend-open(string);
    callback friend-play-now(string);
    callback friend-back();
    callback friend-set-tab(string);
    callback friend-play(int);
    callback friend-accept(string);
    callback friend-dismiss(string);
    in-out property <string> friends-add-text;
    in property <[FriendRequestItem]> friends-found;
    in property <string> friends-found-status;
    callback friend-add-found(string, string);
    callback friends-clear-found();
    // A drxwnify:// or drxwnify.pages.dev link the app was opened with: an invite, or music to show.
    callback open-link(string);
    callback friend-add(string);
    in property <bool> view-can-edit;
    callback rename-view();
    callback delete-view();
    // The dialog over the window: "" (none), "add" (add to a playlist), "rename", "delete".
    in-out property <string> dialog-kind;
    in property <string> dialog-title;
    in property <string> dialog-subtitle;
    in-out property <string> dialog-text;
    in property <[PlaylistPick]> dialog-items;
    callback dialog-confirm(string); // add: create a playlist with this name; rename: the new name; delete: ""
    callback dialog-pick(string); // add: put the tracks into this playlist
    // The open page's «in the library» / «follow» heart.
    in property <bool> view-can-save;
    in property <bool> view-can-share;
    callback share-view();
    in property <string> downloads-label; // «2 · 45%» while downloading
    callback open-downloads();
    in property <bool> menu-downloaded;
    callback export-view(string);
    in property <bool> view-saved;
    callback toggle-view-save();
    callback back();
    callback forward();
    callback home();
    callback play(int);
    callback toggle();
    callback next();
    callback prev();
    callback seek(float);
    callback volume-changed(float);
    callback import-backup();
    callback search(string);
    callback list-changed();
    callback library-changed();
    callback playing-changed();
    callback library-panel-changed();
    callback images-changed();
    // The picture viewer (CoverViewer / PhotoViewerOverlay): a cover or an avatar big over the window.
    callback view-picture(string); // "page", "now", "friend"
    in-out property <bool> viewer-open;
    in property <image> viewer-image;
    in property <bool> viewer-has-image;
    in property <string> viewer-title;
    in property <bool> viewer-saving;
    in property <length> viewer-max: 1000px; // a small picture is not blown up
    callback viewer-download();
    callback viewer-closed();

    Backdrop { }
    // Window-wide shortcuts while no field has the focus (the search field hands it back here when it lets go).
    key-scope := FocusScope {
        width: 0;
        height: 0;
        key-pressed(e) => {
            // Ctrl+K: the search field (also on the Russian layout, where the key types «л»).
            if e.modifiers.control && (e.text == "k" || e.text == "K" || e.text == "л" || e.text == "Л") {
                top-bar.focus-search();
                return accept;
            }
            // The player's keys while they are not registered system-wide.
            if root.window-key(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift) { return accept; }
            reject
        }
    }
    init => { key-scope.focus(); }
    VerticalLayout {
        padding-top: root.window-inset;
        padding-left: Grid.gutter + root.window-inset;
        padding-right: Grid.gutter + root.window-inset;
        padding-bottom: Grid.gutter + root.window-inset;
        top-bar := TopBar {
            maximized: root.window-maximized;
            window-press => { root.window-press(); }
            window-drag => { root.window-drag(); }
            window-minimize => { root.window-minimize(); }
            window-maximize => { root.window-maximize(); }
            window-close => { root.window-close(); }
            dismiss-suggestions => { root.suggest-open = false; key-scope.focus(); }
            can-back: root.can-back;
            can-forward: root.can-forward;
            back => { root.back(); }
            forward => { root.forward(); }
            home => { root.home(); }
            open-settings => { root.open-settings(); }
            open-history => { root.open-history(); }
                open-friends => { root.open-friends(); }
            open-stats => { root.open-stats(); }
            import-backup => { root.import-backup(); }
            downloads-label: root.downloads-label;
            open-downloads => { root.open-downloads(); }
            search(q) => { root.suggest-open = false; key-scope.focus(); root.search(q); }
            typing(t) => { root.search-typing(t); }
            search-text <=> root.search-text;
        }
        // The single surface: columns on top, the player bar under a hairline.
        Rectangle {
            vertical-stretch: 1;
            background: Theme.panel;
            border-color: Theme.panel-border;
            border-width: 1px;
            border-radius: Theme.panel-radius;
            clip: true;
            VerticalLayout {
                HorizontalLayout {
                    vertical-stretch: 1;
                    LibraryPanel {
                        width: Grid.lib-width;
                        items: root.library;
                        selected-id: root.selected-id;
                        filter: root.lib-filter;
                        sort: root.lib-sort;
                        descending: root.lib-descending;
                        set-filter(f) => { root.lib-set-filter(f); }
                        set-sort(s) => { root.lib-set-sort(s); }
                        create-playlist => { root.create-playlist(); }
                        set-descending(d) => { root.lib-set-descending(d); }
                        query-changed(q) => { root.lib-query(q); }
                        open(item) => { root.selected-id = item.id; root.open-library(item); }
                    }
                    Splitter {
                        current: Grid.lib-width;
                        min-w: 300px;
                        max-w: max(300px, min(480px, root.width - Grid.side-width - 480px));
                        sign: 1;
                        resize(w) => { Grid.lib-width = w; }
                        done => { root.panels-resized(); }
                    }
                    if root.lyrics-open: LyricsView {
                        horizontal-stretch: 1;
                        lines: root.lyrics-lines;
                        current: root.lyrics-current;
                        synced: root.lyrics-synced;
                        status: root.lyrics-status;
                        title: root.now-title;
                        artists: root.now-artists;
                        seek(ms) => { root.lyrics-seek(ms); }
                        close => { root.lyrics-open = false; root.lyrics-toggled(); }
                    }
                    if !root.view-friends && !root.lyrics-open: MainArea {
                        horizontal-stretch: 1;
                        title: root.view-title;
                        subtitle: root.view-subtitle;
                        songs: root.songs;
                        now-id: root.now-id;
                        empty-library: root.empty-library;
                        is-page: root.view-is-page;
                        zoom-cover => { root.view-picture("page"); }
                        kind-label: root.view-kind;
                        liked-cover: root.view-liked-cover;
                        can-play: root.view-can-play && !root.view-home && !root.view-settings && !root.view-search && !root.view-history && !root.view-stats && !root.view-yt;
                        play-all => { root.play-all(); }
                        shuffle-all => { root.shuffle-all(); }
                        cover: root.view-cover;
                        has-cover: root.has-view-cover;
                        can-save: root.view-can-save;
                        saved: root.view-saved;
                        toggle-save => { root.toggle-view-save(); }
                        can-share: root.view-can-share;
                        share-page => { root.share-view(); }
                        export-list(f) => { root.export-view(f); }
                        can-edit: root.view-can-edit;
                        rename-list => { root.rename-view(); }
                        delete-list => { root.delete-view(); }
                        releases: root.view-releases;
                        home: root.view-home;
                        settings: root.view-settings;
                        search: root.view-search;
                        artist-view: root.view-artist;
                        history: root.view-history;
                        yt: root.view-yt;
                        h-items: root.history-items;
                        h-play(i) => { root.history-play(i); }
                        h-remove(e) => { root.history-remove(e); }
                        stats: root.view-stats;
                        st-periods: root.stats-periods;
                        st-tiles: root.stats-tiles;
                        st-tracks: root.stats-tracks;
                        st-total: root.stats-total;
                        st-expanded: root.stats-expanded;
                        st-artists: root.stats-artists;
                        st-albums: root.stats-albums;
                        st-note: root.stats-note;
                        st-period(i) => { root.stats-period(i); }
                        st-play(i) => { root.stats-play(i); }
                        st-more => { root.stats-more(); }
                        a-tracks: root.artist-tracks;
                        a-total: root.artist-total;
                        a-expanded: root.artist-expanded;
                        a-albums: root.artist-albums;
                        a-singles: root.artist-singles;
                        a-appears: root.artist-appears;
                        a-related: root.artist-related;
                        a-more => { root.artist-more(); }
                        s-chips: root.search-chips;
                        s-state: root.search-state;
                        s-top-kind: root.search-top-kind;
                        s-top-title: root.search-top-title;
                        s-top-sub: root.search-top-sub;
                        s-top-cover: root.search-top-cover;
                        s-top-has-cover: root.search-top-has-cover;
                        s-tracks: root.search-tracks;
                        s-tracks-total: root.search-tracks-total;
                        s-expanded: root.search-expanded;
                        s-artists: root.search-artists;
                        s-albums: root.search-albums;
                        s-playlists: root.search-playlists;
                        s-source(i) => { root.search-source(i); }
                        s-play(i) => { root.search-play(i); }
                        s-top => { root.search-top(); }
                        s-more => { root.search-more(); }
                        s-artist(i) => { root.search-artist(i); }
                        s-album(i) => { root.search-album(i); }
                        s-playlist(i) => { root.search-playlist(i); }
                        accounts: root.settings-accounts;
                        themes: root.settings-themes;
                        day: root.day-theme;
                        hotkeys: root.global-hotkeys;
                        set-hotkeys(v) => { root.set-hotkeys(v); }
                        hotkey-rows: root.hotkey-rows;
                        recording <=> root.hotkey-recording;
                        hotkey-start(i) => { root.hotkey-start(i); }
                        hotkey-captured(i, t, c, a, sh) => { root.hotkey-captured(i, t, c, a, sh); }
                        hotkey-cancel => { root.hotkey-cancel(); }
                        hotkey-reset(i) => { root.hotkey-reset(i); }
                        hotkey-off(i) => { root.hotkey-off(i); }
                        autostart: root.autostart;
                        set-autostart(v) => { root.set-autostart(v); }
                        flags: root.settings-flags;
                        set-flag(k, v) => { root.set-settings-flag(k, v); }
                        set-main(k) => { root.set-main-account(k); }
                        set-tab(k, v) => { root.set-account-tab(k, v); }
                        set-theme(id) => { root.set-theme(id); }
                        set-day(v) => { root.set-day(v); }
                        sections: root.home-sections;
                        home-play(s, c) => { root.home-play(s, c); }
                        home-random => { root.home-random(); }
                        open-artist(id) => { root.open-artist(id); }
                        like-song(id) => { root.like-song(id); }
                        song-menu(id, i, x, y) => { root.song-menu(id, i, x, y); }
                        open-album(id) => { root.open-album(id); }
                        play(i) => { root.play(i); }
                        import-backup => { root.import-backup(); }
                    }
                    if root.view-friends && !root.lyrics-open: FriendsView {
                        horizontal-stretch: 1;
                        available: root.friends-available;
                        me-name: root.friends-me-name;
                        me-initial: root.friends-me-initial;
                        me-code: root.friends-me-code;
                        me-avatar: root.friends-me-avatar;
                        me-has-avatar: root.friends-me-has-avatar;
                        cards: root.friends-cards;
                        requests: root.friends-requests;
                        page: root.friend-page;
                        f-name: root.friend-name;
                        f-initial: root.friend-initial;
                        f-status: root.friend-status;
                        f-avatar: root.friend-avatar;
                        view-avatar => { root.view-picture("friend"); }
                        f-has-avatar: root.friend-has-avatar;
                        f-tab: root.friend-tab;
                        f-chat: root.friend-chat;
                        chat-text <=> root.friend-chat-text;
                        chat-send(t) => { root.friend-chat-send(t); }
                        chat-replying: root.friend-chat-replying;
                        chat-cancel-reply => { root.friend-chat-action(-1, "cancel-reply"); }
                        chat-typing => { root.friend-chat-typing(); }
                        sticker-list: root.sticker-list;
                        stickers-open <=> root.friend-stickers-open;
                        chat-sticker(i) => { root.friend-chat-sticker(i); }
                        chat-play(i) => { root.friend-chat-play(i); }
                        chat-editing: root.friend-chat-editing;
                        f-can-along: root.friend-can-along;
                        f-along: root.friend-along;
                        f-typing: root.friend-typing;
                        chat-react(i, k) => { root.friend-chat-action(i, "r:" + k); }
                        chat-cancel-edit => { root.friend-chat-action(-1, "cancel-edit"); }
                        chat-act(i, a) => { root.friend-chat-action(i, a); }
                        chat-selected: root.friend-chat-selected;
                        chat-link(u) => { root.friend-chat-link(u); }
                        chat-jump <=> root.friend-chat-jump;
                        chat-menu(i, x, y) => {
                            root.chat-menu-index = i;
                            root.chat-menu-mine = root.friend-chat[i].mine;
                            root.chat-menu-failed = root.friend-chat[i].mine && root.friend-chat[i].state == 2;
                            root.chat-menu-x = x;
                            root.chat-menu-y = y;
                            chat-menu.show();
                        }
                        along => { root.friend-toggle-along(); }
                        remove => { root.friend-remove(); }
                        f-likes: root.friend-likes;
                        f-portrait: root.friend-portrait;
                        room: root.room;
                        room-join-text <=> root.room-join-text;
                        room-action(a, x) => { root.room-action(a, x); }
                        f-tags: root.friend-tags;
                        portrait-period(i) => { root.friend-portrait-period(i); }
                        f-tracks: root.friend-tracks;
                        f-empty: root.friend-empty;
                        now-id: root.now-id;
                        copy-code => { root.friends-copy("code"); }
                        copy-link => { root.friends-copy("link"); }
                        add-text <=> root.friends-add-text;
                        add(t) => { root.friend-add(t); }
                        found: root.friends-found;
                        found-status: root.friends-found-status;
                        add-found(p, n) => { root.friend-add-found(p, n); }
                        clear-found => { root.friends-clear-found(); }
                        open(p) => { root.friend-open(p); }
                        play-now(p) => { root.friend-play-now(p); }
                        back => { root.friend-back(); }
                        set-tab(t) => { root.friend-set-tab(t); }
                        play(i) => { root.friend-play(i); }
                        accept(p) => { root.friend-accept(p); }
                        dismiss(p) => { root.friend-dismiss(p); }
                        open-artist(id) => { root.open-artist(id); }
                        open-album(id) => { root.open-album(id); }
                        like-song(id) => { root.like-song(id); }
                        song-menu(id, i, x, y) => { root.song-menu(id, i, x, y); }
                    }
                    Splitter {
                        current: Grid.side-width;
                        min-w: 240px;
                        max-w: max(240px, min(520px, root.width - Grid.lib-width - 480px));
                        sign: -1;
                        resize(w) => { Grid.side-width = w; }
                        done => { root.panels-resized(); }
                    }
                    RightPanel {
                        width: Grid.side-width;
                        title: root.now-title;
                        artists: root.now-artists;
                        info: root.now-info;
                        artist-id: root.now-artist-id;
                        album-id: root.now-album-id;
                        open-artist(id) => { root.open-artist(id); }
                        like-song(id) => { root.like-song(id); }
                        song-menu(id, i, x, y) => { root.song-menu(id, i, x, y); }
                        open-album(id) => { root.open-album(id); }
                        cover: root.now-cover;
                        has-cover: root.has-now-cover;
                        upcoming: root.upcoming;
                        lyric-now: root.lyric-now;
                        lyric-next: root.lyric-next;
                        has-lyrics: root.has-lyrics;
                        liked: root.now-liked;
                        can-like: root.now-can-like;
                        toggle-like => { root.toggle-now-like(); }
                        zoom-cover => { root.view-picture("now"); }
                        queue-open: root.queue-open;
                        queue-now: root.queue-now;
                        queue-has-now: root.queue-has-now;
                        queue-items: root.queue-items;
                        queue-more: root.queue-more;
                        queue-play(i) => { root.queue-play(i); }
                        queue-remove(i) => { root.queue-remove(i); }
                        queue-move(a, b) => { root.queue-move(a, b); }
                        queue-clear => { root.queue-clear(); }
                        queue-close => { root.queue-open = false; root.queue-toggled(); }
                    }
                }
                HLine { }
                PlayerBar {
                    title: root.now-title;
                    artists: root.now-artists;
                    artist-id: root.now-artist-id;
                    album-id: root.now-album-id;
                    open-album(id) => { root.open-album(id); }
                    open-artist(id) => { root.open-artist(id); }
                    like-song(id) => { root.like-song(id); }
                    song-menu(id, i, x, y) => { root.song-menu(id, i, x, y); }
                    cover: root.now-cover-small;
                    has-cover: root.has-now-cover;
                    playing: root.playing;
                    day: root.day-theme;
                    set-day(v) => { root.set-day(v); }
                    sleep-on: root.sleep-on;
                    sleep-label: root.sleep-label;
                    sleep-fade: root.sleep-fade;
                    sleep-after: root.sleep-after;
                    sleep-set(m) => { root.sleep-set(m); }
                    sleep-option(o) => { root.sleep-option(o); }
                    queue-open: root.queue-open;
                    toggle-queue => { root.queue-open = !root.queue-open; root.queue-toggled(); }
                    lyrics-open: root.lyrics-open;
                    toggle-lyrics => { root.lyrics-open = !root.lyrics-open; root.lyrics-toggled(); }
                    shuffle: root.now-shuffle;
                    repeat: root.now-repeat;
                    toggle-shuffle => { root.toggle-shuffle(); }
                    cycle-repeat => { root.cycle-repeat(); }
                    progress: root.progress;
                    position: root.position;
                    duration: root.duration;
                    total-s: root.duration-s;
                    toggle => { root.toggle(); }
                    next => { root.next(); }
                    prev => { root.prev(); }
                    seek(f) => { root.seek(f); }
                    volume-changed(v) => { root.volume-changed(v); }
                    liked: root.now-liked;
                    can-like: root.now-can-like;
                    toggle-like => { root.toggle-now-like(); }
                }
            }
        }
    }
    // The track menu (pc/ trackMenu): opened by a right click on any song row, where the pointer is.
    track-menu := PopupWindow {
        x: max(0px, min(root.menu-x, root.width - 244px));
        y: max(0px, min(root.menu-y, root.height - menu-box.preferred-height - 8px));
        width: 236px;
        menu-box := Rectangle {
            border-radius: Grid.item-radius;
            background: Theme.menu;
            border-color: Theme.panel-border;
            border-width: 1px;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000060;
            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                MenuItem { icon: Icons.track-next; label: "Играть дальше"; clicked => { root.track-menu-action("next", root.menu-id); } }
                MenuItem { icon: Icons.list; label: "Добавить в очередь"; clicked => { root.track-menu-action("queue", root.menu-id); } }
                MenuItem { icon: Icons.radio; label: "Радио по треку"; clicked => { root.track-menu-action("radio", root.menu-id); } }
                MenuItem { icon: Icons.playlist-add; label: "Добавить в плейлист…"; clicked => { root.track-menu-action("add", root.menu-id); } }
                if root.menu-in-playlist: HLine { }
                if root.menu-in-playlist && root.menu-can-up: MenuItem { icon: Icons.chevron-up; label: "Поднять выше"; clicked => { root.track-menu-action("up", root.menu-id); } }
                if root.menu-in-playlist && root.menu-can-down: MenuItem { icon: Icons.chevron-down; label: "Опустить ниже"; clicked => { root.track-menu-action("down", root.menu-id); } }
                if root.menu-in-playlist: MenuItem { icon: Icons.x; label: "Убрать из плейлиста"; clicked => { root.track-menu-action("remove", root.menu-id); } }
                HLine { }
                MenuItem {
                    icon: root.menu-liked ? Icons.heart-filled : Icons.heart;
                    label: root.menu-liked ? "Убрать из любимых" : "В любимые";
                    clicked => { root.track-menu-action("like", root.menu-id); }
                }
                if root.menu-has-artist || root.menu-has-album: HLine { }
                if root.menu-has-artist: MenuItem { icon: Icons.user-circle; label: "К исполнителю"; clicked => { root.track-menu-action("artist", root.menu-id); } }
                if root.menu-has-album: MenuItem { icon: Icons.album; label: "К альбому"; clicked => { root.track-menu-action("album", root.menu-id); } }
                MenuItem { icon: Icons.link; label: "Поделиться"; clicked => { root.track-menu-action("share", root.menu-id); } }
                MenuItem { icon: root.menu-downloaded ? Icons.trash : Icons.download; label: root.menu-downloaded ? "Удалить из загрузок" : "Скачать"; clicked => { root.track-menu-action(root.menu-downloaded ? "undownload" : "download", root.menu-id); } }
                if root.friends-available: MenuItem { icon: Icons.send; label: "Отправить другу"; clicked => { root.track-menu-action("send", root.menu-id); } }
                if root.room-guest: MenuItem { icon: Icons.users; label: "Предложить в комнату"; clicked => { root.track-menu-action("suggest", root.menu-id); } }
            }
        }
    }
    // A chat message's menu: quick reactions, then change (mine) and delete.
    chat-menu := PopupWindow {
        x: max(0px, min(root.chat-menu-x, root.width - 268px));
        y: max(0px, min(root.chat-menu-y, root.height - chat-box.preferred-height - 8px));
        width: 260px;
        chat-box := Rectangle {
            border-radius: Grid.item-radius;
            background: Theme.menu;
            border-color: Theme.panel-border;
            border-width: 1px;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000060;
            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                HorizontalLayout {
                    spacing: 2px;
                    for i in 7: Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 17px;
                        background: ea.has-hover ? Theme.fill-hover : transparent;
                        Image { source: Emoji.all[i]; width: ea.has-hover ? 24px : 20px; height: self.width; }
                        ea := TouchArea { mouse-cursor: pointer; clicked => { root.friend-chat-action(root.chat-menu-index, "r:" + Emoji.keys[i]); } }
                    }
                }
                HLine { }
                if root.chat-menu-failed: MenuItem { icon: Icons.send; label: "Повторить отправку"; clicked => { root.friend-chat-action(root.chat-menu-index, "retry"); } }
                MenuItem { icon: Icons.message; label: "Ответить"; clicked => { root.friend-chat-action(root.chat-menu-index, "reply"); } }
                MenuItem { icon: Icons.send; label: "Переслать"; clicked => { root.friend-chat-action(root.chat-menu-index, "forward"); } }
                MenuItem { icon: Icons.circle-check; label: "Выделить"; clicked => { root.friend-chat-action(root.chat-menu-index, "select"); } }
                MenuItem { icon: Icons.link; label: "Копировать текст"; clicked => { root.friend-chat-action(root.chat-menu-index, "copy"); } }
                if root.chat-menu-mine: MenuItem { icon: Icons.pencil; label: "Изменить"; clicked => { root.friend-chat-action(root.chat-menu-index, "edit"); } }
                MenuItem { icon: Icons.trash; label: "Удалить у меня"; clicked => { root.friend-chat-action(root.chat-menu-index, "del"); } }
                if root.chat-menu-mine: MenuItem { icon: Icons.trash; label: "Удалить у всех"; clicked => { root.friend-chat-action(root.chat-menu-index, "del-both"); } }
            }
        }
    }
    song-menu(id, i, x, y) => {
        root.menu-id = id;
        root.menu-index = i;
        root.menu-x = x;
        root.menu-y = y;
        root.menu-opening(id, i);
        track-menu.show();
    }
    // The dialog (pc/ Dialogs): a panel in the middle; a click outside or Esc closes it. No dimmed backdrop: the
    // software renderer blends a translucent layer over the translucent fills wrongly (white edges on buttons).
    if root.dialog-kind != "": Rectangle {
        TouchArea { clicked => { root.dialog-kind = ""; } }
        dlg := Rectangle {
            width: min(440px, root.width - 64px);
            height: dlg-col.preferred-height;
            x: (parent.width - self.width) / 2;
            y: max(48px, (parent.height - self.height) / 2 - 40px);
            border-radius: Grid.item-radius + 4px;
            background: Theme.menu;
            border-color: Theme.panel-border;
            border-width: 1px;
            drop-shadow-blur: 40px;
            drop-shadow-color: #000000A0;
            // Clicks on the panel stay on it.
            TouchArea { }
            dlg-keys := FocusScope {
                key-pressed(e) => {
                    if e.text == Key.Escape { root.dialog-kind = ""; return accept; }
                    reject
                }
            }
            dlg-col := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                HorizontalLayout {
                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;
                        Text { text: root.dialog-title; font-family: Theme.heading-font; font-weight: 700; font-size: 18px; color: Theme.text; }
                        if root.dialog-subtitle != "": Text { text: root.dialog-subtitle; font-family: Theme.body-font; font-size: 14px; color: Theme.dim; wrap: word-wrap; }
                    }
                    VerticalLayout { alignment: start; IconButton { icon: Icons.x; size: 30px; icon-size: 15px; clicked => { root.dialog-kind = ""; } } }
                }
                // A name: a new playlist («Добавить в плейлист») or the new name (rename).
                if root.dialog-kind == "add" || root.dialog-kind == "rename": HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        height: 40px;
                        horizontal-stretch: 1;
                        border-radius: 10px;
                        background: Theme.fill;
                        border-color: name-input.has-focus ? Theme.accent : Theme.panel-border;
                        border-width: 1px;
                        if root.dialog-text == "": Text {
                            x: 12px;
                            text: root.dialog-kind == "add" ? "Новый плейлист…" : "Название";
                            font-family: Theme.body-font;
                            font-size: 14px;
                            color: Theme.mute;
                            vertical-alignment: center;
                            height: parent.height;
                        }
                        name-input := TextInput {
                            x: 12px;
                            width: parent.width - 24px;
                            height: parent.height;
                            text <=> root.dialog-text;
                            font-family: Theme.body-font;
                            font-size: 14px;
                            color: Theme.text;
                            vertical-alignment: center;
                            single-line: true;
                            accepted => { root.dialog-confirm(self.text); }
                            key-pressed(e) => {
                                if e.text == Key.Escape { root.dialog-kind = ""; return accept; }
                                reject
                            }
                            init => { self.focus(); }
                        }
                    }
                    Rectangle {
                        width: ok-label.preferred-width + (root.dialog-kind == "add" ? 54px : 36px);
                        height: 40px;
                        border-radius: min(Theme.chip-radius, 20px);
                        background: oka.has-hover ? Theme.accent2 : Theme.accent;
                        HorizontalLayout {
                            padding-left: root.dialog-kind == "add" ? 14px : 18px;
                            padding-right: 18px;
                            spacing: 6px;
                            if root.dialog-kind == "add": Middle { Icon { icon: Icons.plus; size: 16px; color: Theme.on-accent; } }
                            ok-label := Text { text: root.dialog-kind == "add" ? "Создать" : "Сохранить"; font-family: Theme.body-font; font-weight: 700; font-size: 14px; color: Theme.on-accent; vertical-alignment: center; }
                        }
                        oka := TouchArea { mouse-cursor: pointer; clicked => { root.dialog-confirm(root.dialog-text); } }
                    }
                }
                // «Добавить в плейлист»: the listener's playlists, a check where the track is already.
                if root.dialog-kind == "add" || root.dialog-kind == "send": Flickable {
                    height: min(root.dialog-items.length * 52px, 52px * 6);
                    content-height: root.dialog-items.length * 52px;
                    for pl[i] in root.dialog-items: Rectangle {
                        y: i * 52px;
                        height: 52px;
                        width: parent.width;
                        border-radius: Grid.item-radius;
                        background: pla.has-hover ? Theme.fill-hover : transparent;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 10px;
                            spacing: 12px;
                            Middle { Cover { size: 40px; source: pl.cover; has-source: pl.has-cover; radius: Grid.row-cover-radius; } }
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Text { text: pl.name; font-family: Theme.body-font; font-weight: 600; font-size: 15px; color: Theme.text; overflow: elide; }
                                Text { text: pl.count; font-family: Theme.mono-font; font-size: 12px; color: Theme.mute; }
                            }
                            Middle { Icon { icon: pl.has-all ? Icons.check : ""; size: 16px; color: Theme.accent; } }
                        }
                        pla := TouchArea { mouse-cursor: pointer; clicked => { root.dialog-pick(pl.id); } }
                    }
                }
                if root.dialog-kind == "send" && root.dialog-items.length == 0: Text {
                    text: "Друзей пока нет — добавьте их на странице «Друзья».";
                    font-family: Theme.body-font;
                    font-size: 14px;
                    color: Theme.dim;
                }
                if root.dialog-kind == "add" && root.dialog-items.length == 0: Text {
                    text: "Своих плейлистов пока нет — создай первый выше.";
                    font-family: Theme.body-font;
                    font-size: 14px;
                    color: Theme.dim;
                }
                // Delete: what goes, and the two answers.
                if root.dialog-kind == "delete" || root.dialog-kind == "unfriend": HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    Rectangle {
                        width: no-label.preferred-width + 36px;
                        height: 38px;
                        border-radius: min(Theme.chip-radius, 19px);
                        background: noa.has-hover ? Theme.fill-hover : Theme.fill;
                        border-color: Theme.panel-border;
                        border-width: 1px;
                        no-label := Text { text: "Отмена"; font-family: Theme.body-font; font-weight: 700; font-size: 14px; color: Theme.text; }
                        noa := TouchArea { mouse-cursor: pointer; clicked => { root.dialog-kind = ""; } }
                    }
                    Rectangle {
                        width: yes-label.preferred-width + 36px;
                        height: 38px;
                        border-radius: min(Theme.chip-radius, 19px);
                        background: yesa.has-hover ? #C93C42 : #E5484D;
                        yes-label := Text { text: "Удалить"; font-family: Theme.body-font; font-weight: 700; font-size: 14px; color: #FFFFFF; }
                        yesa := TouchArea { mouse-cursor: pointer; clicked => { root.dialog-confirm(""); } }
                    }
                }
            }
            init => { dlg-keys.focus(); }
        }
    }
    // Under the search field: the history (field empty) or matching history + YouTube Music suggestions.
    if root.suggest-open && root.suggestions.length > 0: TouchArea {
        // A click anywhere else closes it.
        clicked => { root.suggest-open = false; key-scope.focus(); }
    }
    if root.suggest-open && root.suggestions.length > 0: Rectangle {
        x: Grid.gutter + root.window-inset + top-bar.search-group-x + Grid.control + 8px;
        y: root.window-inset + Grid.top-height - 8px;
        width: top-bar.search-group-width - Grid.control - 8px;
        height: list.preferred-height;
        border-radius: Grid.item-radius;
        background: Theme.menu;
        border-color: Theme.panel-border;
        border-width: 1px;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000070;
        list := VerticalLayout {
            padding: 6px;
            spacing: 0px;
            if root.suggest-history-only: Caption { text: "НЕДАВНИЕ ПОИСКИ"; x: 10px; height: 26px; vertical-alignment: center; }
            for sug in root.suggestions: Rectangle {
                height: 36px;
                border-radius: Grid.small-radius;
                background: sta.has-hover ? Theme.fill-hover : transparent;
                sta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.search-text = sug.text; root.suggest-open = false; key-scope.focus(); root.search(sug.text); }
                }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 4px;
                    spacing: 10px;
                    Middle { Icon { icon: sug.history ? Icons.clock : Icons.search; size: 16px; color: Theme.mute; } }
                    Text { horizontal-stretch: 1; text: sug.text; font-family: Theme.body-font; font-size: 14px; color: Theme.text; overflow: elide; vertical-alignment: center; }
                    if sug.history: Middle {
                        IconButton { icon: Icons.x; size: 28px; icon-size: 14px; clicked => { root.forget-search(sug.text); } }
                    }
                }
            }
            if root.suggest-history-only: Rectangle {
                height: 34px;
                border-radius: Grid.small-radius;
                background: cta.has-hover ? Theme.fill-hover : transparent;
                Text { text: "Очистить историю"; font-family: Theme.body-font; font-size: 14px; color: Theme.dim; }
                cta := TouchArea { mouse-cursor: pointer; clicked => { root.clear-search-history(); } }
            }
        }
    }
    if root.viewer-open: Rectangle {
        // Opaque: the software renderer blends a translucent layer badly over the panels' translucent fills.
        background: Theme.bg.darker(0.55);
        property <length> side: max(120px, min(root.viewer-max, min(root.width - 160px, root.height - 200px)));
        TouchArea { clicked => { root.viewer-open = false; root.viewer-closed(); } }
        vw-keys := FocusScope {
            key-pressed(e) => {
                if e.text == Key.Escape { root.viewer-open = false; root.viewer-closed(); return accept; }
                reject
            }
        }
        init => { vw-keys.focus(); }
        Rectangle {
            x: (parent.width - parent.side) / 2;
            y: (parent.height - parent.side) / 2 - 24px;
            width: parent.side;
            height: parent.side;
            // Clicks on the picture keep it open.
            TouchArea { }
            if root.viewer-has-image: Image { width: parent.width; height: parent.height; source: root.viewer-image; image-fit: contain; }
            if !root.viewer-has-image: Text { text: "Загрузка…"; font-family: Theme.body-font; font-size: 14px; color: Theme.dim; }
        }
        HorizontalLayout {
            x: Grid.gutter + 8px;
            y: (parent.height + parent.side) / 2 - 24px + 16px;
            width: parent.width - 2 * (Grid.gutter + 8px);
            height: 40px;
            alignment: center;
            spacing: 16px;
            Text { text: root.viewer-title; vertical-alignment: center; font-family: Theme.heading-font; font-weight: 700; font-size: 16px; color: Theme.text; overflow: elide; max-width: max(80px, parent.width - 200px); }
            Rectangle {
                width: vw-dl-row.preferred-width + 32px;
                height: 38px;
                border-radius: min(Theme.chip-radius, 19px);
                background: vw-dl.has-hover ? Theme.fill-hover : Theme.fill;
                vw-dl-row := HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    Middle { Icon { icon: Icons.download; size: 17px; color: Theme.text; } }
                    Text { text: root.viewer-saving ? "Сохраняю…" : "Скачать"; vertical-alignment: center; font-family: Theme.body-font; font-weight: 700; font-size: 14px; color: Theme.text; }
                }
                vw-dl := TouchArea { mouse-cursor: pointer; clicked => { if !root.viewer-saving { root.viewer-download(); } } }
            }
        }
        // Close, top right (and Esc, and a click beside the picture).
        Rectangle {
            x: parent.width - self.width - Grid.gutter - root.window-inset - 12px;
            y: root.window-inset + 52px;
            width: 40px;
            height: 40px;
            border-radius: 20px;
            background: vw-x.has-hover ? Theme.fill-hover : Theme.fill;
            Icon { icon: Icons.x; size: 18px; color: Theme.text; }
            vw-x := TouchArea { mouse-cursor: pointer; clicked => { root.viewer-open = false; root.viewer-closed(); } }
        }
    }
    if root.toast != "": Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - root.window-inset - Grid.gutter - Grid.bar-height - self.height - Grid.gap;
        width: min(520px, root.width - 2 * Grid.gutter);
        height: 44px;
        border-radius: Grid.item-radius;
        background: Theme.menu;
        border-color: Theme.panel-border;
        border-width: 1px;
        Text { text: root.toast; color: Theme.text; font-size: 14px; }
    }
}
