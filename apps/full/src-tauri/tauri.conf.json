{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Drxwnify",
  "version": "0.1.0",
  "identifier": "com.drxwnify.full",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [
      { "title": "Drxwnify", "width": 1440, "height": 900, "minWidth": 1000, "minHeight": 640 }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": { "active": false }
}
